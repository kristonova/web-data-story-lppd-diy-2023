{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.astro", "src/data/derived/*.json"],
  "exclude": ["dist", "node_modules", "data-story", "markdown-per-bab"],
  "compilerOptions": {
    "strictNullChecks": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@data/*": ["src/data/derived/*"],
      "@lib/*": ["src/lib/*"],
      "@components/*": ["src/components/*"]
    }
  }
}
