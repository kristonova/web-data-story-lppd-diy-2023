if (selisihArus > 1) throw new Error(`Arus APBD tidak seimbang: selisih ${selisihArus}`);
const grupKiri = [
  { id: "pad", label: "Pendapatan asli daerah", pendek: "PAD", warna: "#d82128", tampil: rpS(pdp.pad.realisasi) },
  { id: "transfer", label: "Pendapatan transfer", pendek: "Transfer", warna: "#811c1d", tampil: rpS(pdp.transfer.realisasi) },
  { id: "lain", label: "Lain-lain pendapatan yang sah", pendek: "Lain-lain", warna: "#b08a3e", tampil: rpS(pdp.lainSah.realisasi) },
  { id: "biaya", label: "Pembiayaan", pendek: "Pembiayaan", warna: "#ac6249", tampil: rpS(bln.pembiayaanNetto.realisasi) },
];
const grupKanan = [
  { id: "operasi", label: "Belanja operasi", pendek: "Operasi", warna: "#045b87", tampil: rpS(bln.operasi.realisasi) },
  { id: "modal", label: "Belanja modal", pendek: "Modal", warna: "#184531", tampil: rpS(bln.modal.realisasi) },
  { id: "tt", label: "Tidak terduga", pendek: "Tak terduga", warna: "#f08519", tampil: rpS(bln.takTerduga.realisasi) },
  { id: "transfer", label: "Belanja transfer", pendek: "Transfer", warna: "#a72185", tampil: rpS(bln.transfer.realisasi) },
  { id: "silpa", label: "Sisa anggaran", pendek: "SiLPA", warna: "#8f8887", tampil: rpS(bln.slpa.realisasi) },
];

