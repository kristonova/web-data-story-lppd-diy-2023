---
/**
 * Satu halaman, tegas berurutan: pembuka, enam pilar, penutup.
 *
 * Seluruh angka di halaman ini disusun dari src/lib/data.ts (JSON turunan
 * pipeline). Tak ada angka hasil pengukuran yang diketik manual; kalimat yang
 * memuat angka disusun dengan templat agar tetap konsisten bila data segar.
 *
 * Setiap adegan: satu pertanyaan → satu visual → tabel angka alternatif →
 * satu kalimat tafsir → penunjuk sumber (halaman + tabel LPPD).
 */
import Layout from "../layouts/Cerita.astro";
import StatCards from "../components/charts/StatCards.astro";
import HorizontalBar from "../components/charts/HorizontalBar.astro";
import KolomLolipop from "../components/charts/KolomLolipop.astro";
import DuaTitik from "../components/charts/DuaTitik.astro";
import GarisTren from "../components/charts/GarisTren.astro";
import BatangSelisih from "../components/charts/BatangSelisih.astro";
import MeterRing from "../components/charts/MeterRing.astro";
import TabelAlt from "../components/TabelAlt.astro";
import Legenda from "../components/Legenda.astro";
import Adegan from "../components/Adegan.astro";
import Pilar from "../components/Pilar.astro";
import {
  manifes,
  pembuka,
  pilar1,
  pilar2,
  pilar2u,
  pilar3,
  pilar4,
  pilar5,
  pilar6,
  type Sumber,
} from "../lib/data";
import { n, d, p } from "../lib/format";
import * as i from "../i18n/id";

// ── Pembantu kecil ───────────────────────────────────────────────────────────
/** Potong label panjang untuk batang. */
const pangkas = (s: string, m = 44): string => (s.length > m ? `${s.slice(0, m - 1)}…` : s);
/** Tanda arah perubahan: "+" naik, "−" turun, "±" tetap. */
const arrh = (v: number): string => (v === 0 ? "±" : v > 0 ? "+" : "−");
const SB = (hal: string | number, tabel: string | number, berkas: string): Sumber => ({
  berkas,
  halaman: hal,
  tabel,
});
const F1 = "bab-1-pendahuluan.md";
const F2 = "bab2-2_2_2_indikator-kinerja-kunci-hasil.md";
const FP = "bab2-2_2_6_22_urusan-penanaman-modal-dinas-penanaman-modal-dan-pelayanan.md";
const FK = "bab2-2_2_11_2_perencanaan-pembangunan-paniradya-kaistimewan-diy.md";
const FB = "bab2-2_2_8_5_bantuan-keuangan-khusus-bkk-kalurahan.md";
const FB4 = "bab-4-penerapan-standar.md";
/** Singkatan yang dipakai di adesan 2-3. */
const p2u = pilar2u;

// ── Pembuka: enam indikator makro ────────────────────────────────────────────
const md = pembuka.indikator;
const cariM = (j: string) => md.find((x) => x.jenis === j)!;
const ipmC = cariM("ipm");
const kemC = cariM("kemiskinan");
const pptC = cariM("pengangguran");
const grwC = cariM("pertumbuhan");
const pkpC = cariM("perkapita");
const ginC = cariM("gini");
const berHasil = (x: (typeof md)[number], digit: number): string => {
  const ang = x.jenis === "gini" ? d(x.nilai2023, digit) : d(x.nilai2023, digit);
  const sat = x.satuan.startsWith("persen") ? "%" : x.satuan.startsWith("rasio") ? "" : "";
  return `${ang}${sat}`;
};
const heroKartu = [
  { ...ipmC, tampil: berHasil(ipmC, 2) },
  { ...kemC, tampil: berHasil(kemC, 2) },
  { ...pptC, tampil: berHasil(pptC, 2) },
  { ...grwC, tampil: `${d(grwC.perubahan, 2)}%` },
  { ...pkpC, tampil: `${d(pkpC.nilai2023, 2)} juta` },
  { ...ginC, tampil: berHasil(ginC, 3) },
];

// ── Pilar 1: wilayah, penduduk, usia ────────────────────────────────────────
const luas = pilar1.luas;
const luasTerbesar = luas.perKab.reduce((m, x) => (x.km2 > m.km2 ? x : m), luas.perKab[0]);
const barLuas = luas.perKab.map((x) => ({
  label: x.nama.replace("Kabupaten ", ""),
  n: x.km2,
  pct: x.persen,
}));

const pd = pilar1.penduduk;
const adm = pilar1.administrasi;
const barPenduduk = pd.perKab.map((k) => ({ label: k.nama, n: k.jumlah, pct: k.jumlahPersen }));
const pendudukTerbanyak = pd.perKab.reduce((m, k) => (k.jumlah > m.jumlah ? k : m), pd.perKab[0]);
const pendudukTersedikit = pd.perKab.reduce((m, k) => (k.jumlah < m.jumlah ? k : m), pd.perKab[0]);
const duaGender = pd.perKab.map((k) => ({
  label: k.nama,
  a: k.laki,
  b: k.perempuan,
  sorot: k.nama === "Sleman",
}));

const usia = pilar1.usia;
const lolUsia = usia.perKelompok.map((g) => ({ label: g.label, n: g.jumlah, pct: g.persen }));
const usiaTerbesar = usia.perKelompok.reduce((m, g) => (g.jumlah > m.jumlah ? g : m), usia.perKelompok[0]);
const usiaTerkecil = usia.perKelompok.reduce((m, g) => (g.jumlah < m.jumlah ? g : m), usia.perKelompok[0]);

// ── Pilar 2: APBD ───────────────────────────────────────────────────────────
const pdp = pilar2.pendapatan;
const bln = pilar2.belanja;
const barPendapatan = [
  { label: "PAD", n: pdp.pad.realisasi, pct: pdp.pad.persen },
  { label: "Pajak daerah", n: pdp.pajak.realisasi, pct: pdp.pajak.persen },
  { label: "Retribusi", n: pdp.retribusi.realisasi, pct: pdp.retribusi.persen },
  { label: "Kekayaan daerah", n: pdp.kekayaan.realisasi, pct: pdp.kekayaan.persen },
  { label: "Lain PAD", n: pdp.lainPad.realisasi, pct: pdp.lainPad.persen },
  { label: "Transfer pusat", n: pdp.transferPusat.realisasi, pct: pdp.transferPusat.persen },
  { label: "Transfer antar-DK", n: pdp.transferAntar.realisasi, pct: pdp.transferAntar.persen },
  { label: "Lain sah", n: pdp.lainSah.realisasi, pct: pdp.lainSah.persen },
  { label: "Hibah", n: pdp.hibah.realisasi, pct: pdp.hibah.persen },
] as const;
const barBelanja = [
  { label: "Belanja operasi", n: bln.operasi.realisasi, pct: bln.operasi.persen },
  { label: "Gaji pegawai", n: bln.pegawai.realisasi, pct: bln.pegawai.persen },
  { label: "Barang & jasa", n: bln.barangJasa.realisasi, pct: bln.barangJasa.persen },
  { label: "Subsidi", n: bln.subsidi.realisasi, pct: bln.subsidi.persen },
  { label: "Hibah", n: bln.hibah.realisasi, pct: bln.hibah.persen },
  { label: "Bansos", n: bln.bansos.realisasi, pct: bln.bansos.persen },
  { label: "Belanja modal", n: bln.modal.realisasi, pct: bln.modal.persen },
  { label: "Tak terduga", n: bln.takTerduga.realisasi, pct: bln.takTerduga.persen },
  { label: "Transfer bagi hasil", n: bln.bagiHasil.realisasi, pct: bln.bagiHasil.persen },
  { label: "Bantuan keuangan", n: bln.bantuanKeuangan.realisasi, pct: bln.bantuanKeuangan.persen },
];
const shareBln = (x: { realisasi: number }): string => d((100 * x.realisasi) / bln.total.realisasi, 1);
const pangkatRupiah = (v: number): string => n(Math.round(v));
const shareTransferPusat = 100 * (pdp.transferPusat.realisasi / pdp.total.realisasi);
const shareTransferAntar = 100 * (pdp.transferAntar.realisasi / pdp.total.realisasi);
const shareTransfer = shareTransferPusat + shareTransferAntar;
const duoUrusan = p2u.kelompok.map((k) => ({
  label: k.nama,
  a: k.anggaran,
  b: k.realisasi,
  sorot: k.persen === Math.max(...p2u.kelompok.map((x) => x.persen)),
}));
const urusanTinggi = p2u.kelompok.reduce((m, k) => (k.persen > m.persen ? k : m), p2u.kelompok[0]);
const urusanRendah = p2u.kelompok.reduce((m, k) => (k.persen < m.persen ? k : m), p2u.kelompok[0]);

// ── Pilar 3: makro ──────────────────────────────────────────────────────────
const ipm = pilar3.ipm;
const kem = pilar3.kemiskinan;
const kk = pilar3.ketenagakerjaan;
const ktd = pilar3.ketimpangan;
const kemPeriod = [...new Set(kem.perDaerah.map((x) => x.periode))];
const kemTerakhir = kemPeriod[kemPeriod.length - 1];
const kemSebelum = kemPeriod[1];
const ipmKomponen = ipm.komponen.map((k) => ({
  label: pangkas(k.nama, 40),
  a: k.nilai.t2020,
  b: k.nilai.t2023,
  catatan: k.satuan,
}));
const kemSeri = (["Perkotaan", "Perdesaan"] as const).map((nm, i) => ({
  label: nm,
  seri: String(i + 1),
  nilai: kemPeriod.map((pd) =>
    kem.perDaerah.filter((k) => k.daerah === nm && k.periode === pd).map((k) => k.ribu)[0] ?? null,
  ),
}));
const kemTotalSeri = {
  label: "DIY",
  seri: "highlight" as const,
  nilai: kemPeriod.map((pd) =>
    kem.perDaerah.filter((k) => k.daerah === "Total" && k.periode === pd).map((k) => k.ribu)[0] ?? null,
  ),
};
const kkDuo = kk.baris.map((b) => ({ label: b.label, a: b.t2022, b: b.t2023 }));
const ktd22 = ktd.perDaerah.filter((x) => x.periode === "Maret 2022");
const ktd23 = ktd.perDaerah.filter((x) => x.periode === "Maret 2023");
const ktdDuo = ktd23
  .filter((x) => x.daerah !== "Total")
  .map((x) => {
    const lama = ktd22.find((y) => y.daerah === x.daerah)!;
    return {
      label: x.daerah,
      a: lama.p40Bawah,
      b: x.p40Bawah,
      catatan: `${d(x.p20Atas, 2)}% bagian 20% teratas pada Maret 2023`,
    };
  });

// ── Pilar 4: IKK dan investasi ──────────────────────────────────────────────
const ikkP = pilar4.ikkPendidikan;
const ikkH = pilar4.ikkKesehatan;
const ikkU = pilar4.ikkPU;
const inv = pilar4.investasi;
const invKumulatif = [
  { label: "Total kumulatif", a: inv.seri[0].totalMiliar, b: inv.seri[1].totalMiliar, sorot: true },
  { label: "PMDN", a: inv.seri[0].pmdnMiliar, b: inv.seri[1].pmdnMiliar },
  { label: "PMA", a: inv.seri[0].pmaMiliar, b: inv.seri[1].pmaMiliar },
  { label: "Tambahan pada tahun", a: inv.seri[0].tambahanMiliar, b: inv.seri[1].tambahanMiliar },
];
const invTahun = ["2019", "2020", "2021", "2022", "2023"];
const invKabSeri = inv.perKab.map((k, i) => ({
  label: k.kabkota.replace("Kabupaten ", "").replace("Kota ", ""),
  seri: String(i + 1),
  nilai: [k.t2019, k.t2020, k.t2021, k.t2022, k.t2023],
}));

// ── Pilar 5: keistimewaan & BKK ─────────────────────────────────────────────
const nA = pilar5.nilaiAkhir;
const urK = pilar5.urusan;
const bkk = pilar5.bkk;
const duoKes = urK.baris.map((b) => ({ label: pangkas(b.nama, 40), a: b.anggaran, b: b.realisasi }));
const bkkRow = [...bkk.baris]
  .filter((x) => x.realisasi !== null)
  .sort((a, b) => b.pagu - a.pagu)
  .map((x) => ({
    label: pangkas(x.jenis, 46),
    n: x.realisasi as number,
    pct: x.keuangan,
  }));

// ── Pilar 6: SPM ────────────────────────────────────────────────────────────
const kat = pilar6.kategori;
const pInd = pilar6.pendidikanIndikator;
const khus = pilar6.pendidikanKhusus;
const barKat = kat.map((k) => ({ label: k.bidang, n: k.indeks }));
const paripurna = kat.filter((k) => k.kategori === "PARIPURNA");
const indSma = pInd.filter((x) => x.jenjang === "SMA").map((x) => ({
  label: pangkas(x.label, 34),
  delta: +(x.capaian - x.target).toFixed(2),
  catatan: `${d(x.capaian, 2)} vs target ${d(x.target, 2)}`,
}));
const indSmaTerang = indSma.reduce((m, x) => (x.delta < m.delta ? x : m), indSma[0]);
const indSmaTembak = indSma.filter((x) => x.delta > 0).length;

// ── Penutup: celah dan unduhan ──────────────────────────────────────────────
const unduhan = manifes.unduhan;
const celah = manifes.catatanCelah;
---

<Layout judul={i.judul} deskripsi={i.deskripsi}>
  {/* ═════════════════════════ 0. Pembuka ═════════════════════════ */}
  <header class="hero" id="pembuka">
    <div class="wrap">
      <p class="hero__eyebrow">{i.pembuka.eyebrow}</p>
      <h1>{i.pembuka.judul}</h1>
      <p class="hero__lead">{i.pembuka.lead}</p>

      <div class="hero__figures" data-anim="kartu">
        {
          heroKartu.map((k) => (
            <div class="hero__figure" data-anim="kartu">
              <span class="n">{k.tampil}</span>
              <span class="l">
                {k.nama} · {k.satuan}
              </span>
              <span class="l">
                {k.perubahan > 0 ? "▲ naik" : k.perubahan < 0 ? "▼ turun" : "— tetap"} {d(Math.abs(k.perubahan), 2)} terhadap 2022
              </span>
            </div>
          ))
        }
      </div>

      <p class="hero__note">{i.pembuka.note}</p>
    </div>
  </header>

  {/* ═════════════════════════ 0-1 · Adegan pembuka ═════════════════════════ */}
  <Pilar
    no={0}
    id="pilar-0"
    judul="Enam indikator makro dulu"
    bidang={["Capaian kinerja makro"]}
    lead="Sebelum memasuki pilar, enam angka makro memetakan arah kebijakan: kesejahteraan naik, pengeluaran tertahan, dan ketimpangan nyaris tenang."
  >
    <Adegan
      id="0-1"
      pertanyaan="Ke mana arah kebijakan DIY pada tahun 2023?"
      tafsir={`Enam angka pembuka: IPM <strong>${d(ipmC.nilai2023, 2)}</strong> poin, kemiskinan <strong>${d(kemC.nilai2023, 2)}%</strong>, pengangguran <strong>${d(pptC.nilai2023, 2)}%</strong>, pertumbuhan ekonomi <strong>${d(grwC.perubahan, 2)}%</strong> — masing-masing membaik dari 2022. Pendapatan per kapita <strong>${d(pkpC.nilai2023, 2)} juta rupiah</strong>; rasio gini <strong>${d(ginC.nilai2023, 3)}</strong>.`}
      sumber={SB(188, 2, "bab2-2_1_capaian-kinerja-makro.md")}
    >
      <StatCards
        judul="Enam indikator makro, 2022 berbanding 2023"
        kartu={[
          { label: `${ipmC.nama} (${ipmC.satuan})`, nilai: berHasil(ipmC, 2), sub: `2022 ${d(ipmC.nilai2022, 2)} · ${arrh(ipmC.perubahan)}${d(ipmC.perubahan, 2)}%`, sorot: true },
          { label: `${kemC.nama} (${kemC.satuan})`, nilai: berHasil(kemC, 2), sub: `2022 ${d(kemC.nilai2022, 2)} · ${arrh(kemC.perubahan)}${d(kemC.perubahan, 2)}%` },
          { label: `${pptC.nama} (${pptC.satuan})`, nilai: berHasil(pptC, 2), sub: `2022 ${d(pptC.nilai2022, 2)} · ${arrh(pptC.perubahan)}${d(pptC.perubahan, 2)}%` },
          { label: `${grwC.nama} (${grwC.satuan})`, nilai: `${d(grwC.perubahan, 2)}%`, sub: `ADHK 2010 · ${d(grwC.nilai2022, 0)} — ${d(grwC.nilai2023, 0)} juta` },
          { label: `${pkpC.nama} (${pkpC.satuan})`, nilai: `${d(pkpC.nilai2023, 2)}`, sub: `2022 ${d(pkpC.nilai2022, 2)} · ${arrh(pkpC.perubahan)}${d(pkpC.perubahan, 2)}%` },
          { label: `${ginC.nama} (${ginC.satuan})`, nilai: berHasil(ginC, 3), sub: `2022 ${d(ginC.nilai2022, 3)} · ${arrh(ginC.perubahan)}${d(ginC.perubahan, 2)}%` },
        ]}
      />
      <TabelAlt
        judul="enam indikator makro"
        keterangan="Enam indikator makro DIY — nilai 2022, 2023, dan perubahan"
        kolom={[
          { judul: "Indikator" },
          { judul: "Satuan" },
          { judul: "2022", num: true },
          { judul: "2023", num: true },
          { judul: "Perubahan (%)", num: true },
        ]}
        baris={md.map((x) => [
          x.nama,
          x.satuan,
          x.jenis === "gini" ? d(x.nilai2022, 3) : d(x.nilai2022, 2),
          x.jenis === "gini" ? d(x.nilai2023, 3) : d(x.nilai2023, 2),
          d(x.perubahan, 2),
        ])}
      />
    </Adegan>
  </Pilar>

  {/* ═════════════════════════ 1. Pilar satu ═════════════════════════ */}
  <Pilar no={1} id={i.pilar[0].id} judul={i.pilar[0].judul} bidang={i.pilar[0].bidang} lead={i.pilar[0].lead}>
    <Adegan
      id="1-1"
      pertanyaan="Seberapa luas wilayah DIY dan bagaimana bagiannya?"
      tafsir={`Luas daratan DIY <strong>${d(luas.total ?? 0, 2)} km persegi</strong> — ${d(luas.persenIndonesia ?? 0, 2)}% luas daratan Indonesia. Yang terluas <strong>${luasTerbesar?.nama ?? ""}</strong> menempati ${p(luasTerbesar?.persen ?? 0, 2)} dari luas DIY, membentuk ceruk karst selatan yang ikut menentukan tinggalnya penduduk Gunungkidul.`}
      sumber={SB("27", "naskah geografi wilayah", F1)}
    >
      <HorizontalBar
        caption="Luas daratan per kabupaten/kota (kilometer persegi)"
        label="Luas daratan per kabupaten/kota"
        rows={barLuas}
        satuan="km²"
        sorot="Gunungkidul"
        penyebutLabel="dari luas DIY"
      />
      <TabelAlt
        judul="luas daratan per kabupaten/kota"
        kolom={[{ judul: "Kabupaten/Kota" }, { judul: "Luas (km²)", num: true }, { judul: "% DIY", num: true }]}
        baris={luas.perKab.map((x) => [x.nama, d(x.km2, 2), d(x.persen, 2)])}
      />
    </Adegan>

    <Adegan
      id="1-2"
      pertanyaan="Berapa jumlah penduduk dan bagaimana pembagiannya?"
      tafsir={`Penduduk DIY <strong>${n(pd.total)} jiwa</strong> — ${d(pd.lakiPersen, 2)}% laki-laki dan ${d(pd.perempuanPersen, 2)}% perempuan yang tersebar tidak merata: ${pendudukTerbanyak.nama} menampung paling banyak (${d(pendudukTerbanyak.jumlahPersen, 2)}%), sedangkan ${pendudukTersedikit.nama} paling sedikit (${d(pendudukTersedikit.jumlahPersen, 2)}%). Pembagian administrasinya: ${adm.kapanewon} kapanewon/kemantren, ${adm.kalurahan} kalurahan, dan ${adm.kelurahan} kelurahan.`}
      sumber={[
        SB(29, 1, F1),
        SB(31, 4, F1),
      ]}
    >
      <HorizontalBar
        caption="Penduduk per kabupaten/kota (jiwa)"
        label="Jumlah penduduk per kabupaten/kota"
        rows={barPenduduk}
        sorot="Sleman"
        penyebutLabel="dari penduduk DIY"
      />
      <TabelAlt
        judul="penduduk per kabupaten/kota menurut jenis kelamin"
        kolom={[
          { judul: "Kabupaten/Kota" },
          { judul: "Laki-laki", num: true },
          { judul: "Perempuan", num: true },
          { judul: "Jumlah", num: true },
          { judul: "% DIY", num: true },
        ]}
        baris={pd.perKab.map((k) => [k.nama, n(k.laki), n(k.perempuan), n(k.jumlah), d(k.jumlahPersen, 2)])}
      />
      <Legenda
        items={[
          { label: "Laki-laki", seri: "2" },
          { label: "Perempuan", seri: "1" },
        ]}
      />
      <DuaTitik
        caption="Penduduk laki-laki berbanding perempuan per kabupaten/kota (jiwa)"
        label="Penduduk laki-laki dan perempuan per kabupaten/kota"
        rows={duaGender}
        kiri="Laki-laki"
        kanan="Perempuan"
        satuan="jiwa"
        digit={0}
      />
      <TabelAlt
        judul="penduduk laki-laki dan perempuan per kabupaten/kota"
        kolom={[
          { judul: "Kabupaten/Kota" },
          { judul: "Laki-laki", num: true },
          { judul: "Perempuan", num: true },
        ]}
        baris={pd.perKab.map((k) => [k.nama, n(k.laki), n(k.perempuan)])}
      />
    </Adegan>

    <Adegan
      id="1-3"
      pertanyaan="Bagaimana susunan umur penduduk?"
      tafsir={`Kelompok umur paling ramai adalah usia <strong>${usiaTerbesar.label} tahun</strong> (${d(usiaTerbesar.persen, 2)}% penduduk), paling sedikit <strong>${usiaTerkecil.label} tahun</strong> (${d(usiaTerkecil.persen, 2)}%). Kedua ujung ceruk ini menandai penduduk yang melayani penduduk: generasi pekerja di puncak, anak-anak yang menyempit di dasar.`}
      sumber={SB(31, 1, F1)}
    >
      <KolomLolipop
        caption="Penduduk menurut kelompok umur (jiwa)"
        label="Penduduk menurut kelompok umur"
        rows={lolUsia}
        satuan="jiwa"
        penyebutLabel="dari penduduk DIY"
        labelSumbu="Kelompok umur"
        sorot={usia.perKelompok.reduce((m, g) => (g.jumlah > m.jumlah ? g : m)).label}
      />
      <TabelAlt
