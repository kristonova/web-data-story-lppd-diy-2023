  { id: "biaya", label: "Pembiayaan", pendek: "Pembiayaan", warna: "#ac6249", tampil: rpS(bln.pembiayaanNetto.realisasi) },
];
const grupKanan = [
  { id: "operasi", label: "Belanja operasi", pendek: "Operasi", warna: "#045b87", tampil: rpS(bln.operasi.realisasi) },
  { id: "modal", label: "Belanja modal", pendek: "Modal", warna: "#184531", tampil: rpS(bln.modal.realisasi) },
  { id: "tt", label: "Tidak terduga", pendek: "Tak terduga", warna: "#f08519", tampil: rpS(bln.takTerduga.realisasi) },
  { id: "transfer", label: "Belanja transfer", pendek: "Transfer", warna: "#a72185", tampil: rpS(bln.transfer.realisasi) },
