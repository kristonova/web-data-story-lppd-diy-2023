  S("barangjasa", "Barang dan jasa", bln.barangJasa, "operasi"),
  S("hibah", "Hibah", bln.hibah, "operasi"),
  S("subsidi", "Subsidi", bln.subsidi, "operasi"),
  S("bansos", "Bantuan sosial", bln.bansos, "operasi"),
