      id="5-1"
      pertanyaan="Seberapa baik urusan keistimewaan dijalankan?"
      tafsir={`Nilai akhir penyelenggaraan keistimewaan 2023 <strong>${d(nA.total, 2)}</strong> dari 100. Capaian fisik dan keuangan nyaris sempurna, ${d(nA.rerataCapaian, 2)}. Poin terbanyak hilang di ${(namaNA[naHilangIdx] ?? naHilang.nama).toLowerCase()}: skornya ${d(naHilang.nilai, 2)}, sehingga <strong>${d(naHilang.bobot - naHilang.hasil, 2)} poin</strong> dari bobotnya tidak teraih.`}
      sumber={SB(800, 1, FK)}
    >
      <Figur judul="Susunan nilai akhir kinerja keistimewaan" satuan="lebar ruas = bobot; isian = hasil yang diraih">
        <SkorBobot label="Susunan nilai akhir kinerja penyelenggaraan keistimewaan DIY 2023" komponen={komponenNA} total={`Nilai akhir ${d(nA.total, 2)}`} totalNilai={nA.total} />
        <TabelAlt
          slot="tabel"
          judul="rincian nilai akhir keistimewaan"
          kolom={[{ judul: "Komponen" }, { judul: "Nilai", num: true }, { judul: "Bobot (%)", num: true }, { judul: "Hasil", num: true }]}
          baris={[...nA.baris.map((b) => [b.nama, d(b.nilai, 2), d(b.bobot, 0), d(b.hasil, 2)]), ["Nilai akhir", null, null, d(nA.total, 2)]]}
        />
      </Figur>
    </Adegan>

    <Adegan
      id="5-2"
      pertanyaan="Ke mana Dana Keistimewaan dibelanjakan?"
      tafsir={`Dana Keistimewaan 2023 dianggarkan <strong>${rp(urK.total.anggaran)}</strong>; ${p((100 * urKeb.anggaran) / urK.total.anggaran, 1)} di antaranya untuk urusan ${urKeb.nama.toLowerCase()}. Realisasi keuangannya ${p(urK.total.keuangan, 2)} dan fisiknya ${p(urK.total.fisik, 2)}. ${kalimat(urRendah.nama)} menjadi urusan dengan serapan keuangan terendah, <strong>${p(urRendah.keuangan, 2)}</strong>.`}
      sumber={SB(800, 2, FK)}
    >
      <Figur
        judul="Komposisi anggaran Dana Keistimewaan"
        satuan="persen dari total anggaran"
        legenda={[...urK.baris].sort((a, b) => b.anggaran - a.anggaran).map((b) => ({ label: kalimat(b.nama), warna: warnaUrusan[b.nama] ?? C.dasar }))}
      >
        <Tumpuk
          label="Komposisi anggaran Dana Keistimewaan 2023 menurut urusan"
          lebarLabel="0rem"
          tebal={44}
          rows={[
            {
              label: "",
              ruas: [...urK.baris]
                .sort((a, b) => b.anggaran - a.anggaran)
                .map((b) => ({
                  label: kalimat(b.nama),
                  n: b.anggaran,
                  tampil: p((100 * b.anggaran) / urK.total.anggaran, 1),
                  warna: warnaUrusan[b.nama] ?? C.dasar,
                  teks: b.nama === "Pertanahan" ? "var(--ink)" : undefined,
                })),
            },
          ]}
        />
      </Figur>
      <Figur judul="Anggaran dan realisasi per urusan keistimewaan" satuan="persen serapan keuangan">
        <BulletH label="Anggaran dan realisasi Dana Keistimewaan per urusan" rows={barisUrusanK} lebarLabel="8rem" />
        <TabelAlt
          slot="tabel"
          judul="realisasi urusan keistimewaan"
          kolom={[{ judul: "Urusan" }, { judul: "Anggaran (Rp)", num: true }, { judul: "Realisasi (Rp)", num: true }, { judul: "Keuangan (%)", num: true }, { judul: "Fisik (%)", num: true }]}
          baris={[...urK.baris.map((b) => [b.nama, n(b.anggaran), n(b.realisasi), d(b.keuangan, 2), d(b.fisik, 2)]), ["Jumlah", n(urK.total.anggaran), n(urK.total.realisasi), d(urK.total.keuangan, 2), d(urK.total.fisik, 2)]]}
        />
      </Figur>
    </Adegan>

    <Adegan
      id="5-3"
      pertanyaan="Program apa saja yang dibiayai bantuan keuangan khusus kalurahan?"
      tafsir={`Bantuan keuangan khusus kalurahan tersalur lewat ${n(bkk.baris.length)} program dengan pagu <strong>${rp(bkk.jumlah.pagu)}</strong> dan realisasi ${rp(bkk.jumlah.realisasi)} (${p((100 * bkk.jumlah.realisasi) / bkk.jumlah.pagu, 2)}). ${bkkFisikPenuh ? "Seluruh program melaporkan capaian fisik 100%. " : ""}Program terbesar adalah ${awalKecil(namaBkk(bkkTerbesar.jenis))} dengan pagu <strong>${rp(bkkTerbesar.pagu)}</strong>.`}
      sumber={[SB(739, 1, FB), SB(740, 1, FB)]}
    >
      <Figur judul="Pagu bantuan keuangan khusus kalurahan per program" satuan="rupiah, diurutkan dari pagu terbesar">
        <BarH
          label="Pagu BKK kalurahan per program"
          rapat
          lebarLabel="15rem"
          rows={bkkUrut.map((b) => ({
            label: namaBkk(b.jenis),
            n: b.pagu,
            tampil: rpS(b.pagu),
            sorot: b === bkkTerbesar,
            tip: [b.realisasi !== null ? `Realisasi ${rp(b.realisasi)}` : null, b.keuangan !== null ? `Keuangan ${p(b.keuangan, 2)}` : null, b.fisik !== null ? `Fisik ${p(b.fisik, 0)}` : null].filter((x): x is string => x !== null),
          }))}
        />
        <TabelAlt
          slot="tabel"
          judul="realisasi BKK kalurahan"
          kolom={[{ judul: "Program" }, { judul: "Pagu (Rp)", num: true }, { judul: "Realisasi (Rp)", num: true }, { judul: "Keuangan (%)", num: true }, { judul: "Fisik (%)", num: true }]}
          baris={[
            ...bkkUrut.map((b) => [b.jenis, n(b.pagu), b.realisasi === null ? null : n(b.realisasi), b.keuangan === null ? null : d(b.keuangan, 2), b.fisik === null ? null : d(b.fisik, 2)]),
            ["Jumlah", n(bkk.jumlah.pagu), n(bkk.jumlah.realisasi), d((100 * bkk.jumlah.realisasi) / bkk.jumlah.pagu, 2), null],
          ]}
        />
      </Figur>
    </Adegan>
  </Bab>

  {/* ═════════════════════════ Bab 6 ═════════════════════════ */}
  <Bab no={6} id={i.bab[5]!.id} judul={i.bab[5]!.judul} sub={i.bab[5]!.sub} lead={leadBab[5]!} ikon={i.bab[5]!.ikon} ikonNama={i.bab[5]!.ikonNama}>
    <Adegan
      id="6-1"
      pertanyaan="Bidang SPM mana yang sudah tuntas?"
      tafsir={`${awalBesar(kata(paripurna.length))} dari ${kata(spmKat.length)} bidang SPM meraih kategori paripurna dengan indeks ${d(paripurna[0]?.indeks ?? 0, 0)}. ${nonParipurna.map((k) => `${k.bidang} berada satu tingkat di bawahnya, kategori ${k.kategori.toLowerCase()}, dengan indeks <strong>${d(k.indeks, 2)}</strong>`).join("; ")}.`}
      sumber={SB("1046–1105", "kategori dan indikator SPM per bidang", FS)}
    >
      <Figur judul="Indeks pencapaian SPM per bidang" satuan="indeks, skor penuh 100">
        <BarH
          label="Indeks pencapaian SPM per bidang"
          trek
          maks={100}
          lebarLabel="14rem"
          rows={[...spmKat].sort((a, b) => a.indeks - b.indeks).map((k) => ({ label: k.bidang, n: k.indeks, tampil: d(k.indeks, 2), sub: kalimat(k.kategori), sorot: k.kategori !== "PARIPURNA" }))}
        />
        <TabelAlt
          slot="tabel"
          judul="kategori dan indeks SPM per bidang"
          kolom={[{ judul: "Bidang" }, { judul: "Kategori" }, { judul: "Indeks", num: true }]}
          baris={spmKat.map((k) => [k.bidang, kalimat(k.kategori), d(k.indeks, 2)])}
        />
      </Figur>
    </Adegan>

    <Adegan
      id="6-2"
      lebar
      pertanyaan="Di mana layanan pendidikan belum mencapai targetnya?"
      tafsir={`Dari ${n(pInd.length)} indikator SPM pendidikan yang terbaca, <strong>${n(indBelum.length)}</strong> belum mencapai target. Celah terbesar ada pada ${indTerendah.label.toLowerCase()} ${indTerendah.jenjang.toLowerCase()}: <strong>${p(indTerendah.pct, 2)}</strong> dari target. Di jenjang lain, indikator yang tertinggal meliputi ${gabungDan(labelBelumSmaSmk)}.`}
      sumber={[SB(1046, 1, FS), SB(1047, 1, FS)]}
    >
      <Figur judul="Capaian indikator SPM pendidikan terhadap target" satuan="persen dari target; merah: belum mencapai target">
        <DaftarCapaian label="Capaian indikator SPM pendidikan per jenjang" kelompok={kelompokSpm} />
        <TabelAlt
          slot="tabel"
          judul="capaian dan target indikator SPM pendidikan"
          kolom={[{ judul: "Jenjang" }, { judul: "Indikator" }, { judul: "Satuan" }, { judul: "Target", num: true }, { judul: "Capaian", num: true }, { judul: "% target", num: true }]}
          baris={pInd.map((x) => [x.jenjang, x.label, x.satuan, d(x.target, 2), d(x.capaian, 2), d(x.pct, 2)])}
        />
      </Figur>
    </Adegan>

    <Adegan
      id="6-3"
      pertanyaan="Berapa anak berkebutuhan khusus yang sudah terlayani?"
      tafsir={`Layanan pendidikan khusus menjangkau <strong>${n(khus.terlayani)}</strong> dari ${n(khus.harusDilayani)} anak yang harus dilayani (${p(khus.persen, 2)}). Masih ada <strong>${n(khus.belumTerlayani)} anak</strong> yang belum terlayani. Indeks pencapaian SPM pendidikan khusus ${d(khus.indeksKhusus, 2)}.`}
      sumber={SB(1047, 1, FS)}
    >
      <Figur judul="Anak berkebutuhan khusus yang harus dilayani" satuan="satu kotak = satu persen">
        <Waffle
          label="Layanan pendidikan khusus: terlayani dan belum terlayani"
          kat={[
            { label: "Terlayani", n: khus.terlayani, tampil: `${n(khus.terlayani)} anak`, porsi: p(khus.persen, 2), warna: C.sorot },
            { label: "Belum terlayani", n: khus.belumTerlayani, tampil: `${n(khus.belumTerlayani)} anak`, porsi: p(100 - khus.persen, 2), warna: C.redup },
          ]}
        />
        <TabelAlt
          slot="tabel"
          judul="layanan pendidikan khusus"
          kolom={[{ judul: "Uraian" }, { judul: "Nilai", num: true }]}
          baris={[
            ["Anak yang harus dilayani", n(khus.harusDilayani)],
            ["Terlayani", n(khus.terlayani)],
            ["Belum terlayani", n(khus.belumTerlayani)],
            ["Persentase terlayani", d(khus.persen, 2)],
            ["Indeks pencapaian SPM pendidikan khusus", d(khus.indeksKhusus, 2)],
            ["Indeks penerima layanan", d(khus.indeksPenerimaLD, 2)],
          ]}
        />
      </Figur>
    </Adegan>
  </Bab>

  {/* ═════════════════════════ Penutup ═════════════════════════ */}
  <section class="penutup" id="penutup" aria-labelledby="penutup-judul">
    <div class="wrap">
      <header class="jb" data-reveal>
        <span class="jb__no">{i.penutup.label}</span>
        <h2 class="jb__teks" id="penutup-judul">{i.penutup.judul}</h2>
        <div class="jb__garis" aria-hidden="true"></div>
      </header>
      <p class="ringkasan__lead" data-reveal>{i.penutup.lead}</p>
    </div>

    <Adegan
      id="7-1"
      pertanyaan="Catatan apa saja yang direkam selama pengolahan data?"
      tafsir={`Pipeline merekam <strong>${n(celah.length)} catatan</strong>: pembulatan antartabel, sel yang tak terbaca mesin, ralat yang dicatat laporan sendiri, dan angka yang satuannya bukan persen. Sel yang rusak tidak pernah ditampilkan sebagai angka; ia dilaporkan di sini.`}
      sumberTeks="manifes catatan celah, dihasilkan scripts/build_data.mjs dari pemeriksaan aritmetika atas tabel LPPD DIY 2023 (bab 1–4)."
    >
      <ol class="daftar-celah">
        {celah.map((c) => <li data-anim="naik">{c}</li>)}
      </ol>
    </Adegan>

    <Adegan
      id="7-2"
      pertanyaan="Bagaimana mengunduh dan memeriksa angkanya?"
      tafsir={`Tersedia <strong>${n(unduhan.length)} berkas CSV</strong> berisi tabel agregat yang sudah melewati pemeriksaan aritmetika otomatis. Setiap berkas menunjuk kembali halaman dan tabel sumbernya, dan dapat dibuka di aplikasi lembar kerja apa pun.`}
      sumberTeks="berkas unduhan dihasilkan pipeline dari tabel LPPD DIY 2023 (bab 1–4), pemisah titik koma, desimal koma."
    >
      <ul class="unduhan">
        {
          unduhan.map((u) => (
            <li data-anim="naik">
              <a href={`./data/${u.berkas}`} download>
                <b>{u.berkas}</b>
                <span>{u.tentang}</span>
                <small>{u.sumber}</small>
                <em>Unduh CSV</em>
              </a>
            </li>
          ))
        }
      </ul>
    </Adegan>

    <div class="wrap">
      <div class="kolofon" data-reveal>
        <p><b>Data.</b> {i.penutup.kolofonData}</p>
        <p>
          <b>Desain.</b> {i.penutup.kolofonDesain}{" "}
          <a href="./lisensi/Jogjakartype-EULA.pdf">Lisensi Jogjakartype</a> · <a href="./lisensi/SourceSans3-OFL.txt">Lisensi Source Sans 3</a>
        </p>
      </div>
    </div>
  </section>

  {/* ═════════════════════════ Matur Nuwun ═════════════════════════ */}
  <section class="akhir" id="akhir" data-reveal aria-label="Penutup">
    <p class="akhir__kata" lang="jv">{i.akhir.kata}</p>
    <p class="akhir__sub">{i.akhir.sub}</p>
    <a class="akhir__atas" href="#sampul">{i.akhir.atas}</a>
    <img class="deret" src="./brand/deret-ikon-emas.svg" alt="" width="842" height="141" loading="lazy" />
  </section>
</Layout>
