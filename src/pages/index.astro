      id="6-1"
      judul="Akses Pendidikan Menengah"
      pertanyaan="Seberapa optimal daya jangkau partisipasi sekolah menengah dan layanan pendidikan inklusi?"
      tafsir={`Angka Partisipasi Kasar (APK) pendidikan menengah di DIY mencapai <strong>${p(ikkP.apk.rasio, 2)}</strong>. Capaian di atas 100% ini mencerminkan tingginya daya tarik DIY sebagai kota pelajar, yang menampung banyak siswa lintas kelompok usia serta pelajar dari luar daerah. Sementara itu, Angka Partisipasi Murni (APM) berada di level ${p(ikkP.apm.rasio, 2)}. Pada layanan pendidikan inklusi, penjangkauan anak berkebutuhan khusus telah mencapai ${p(ikkP.abk.persen, 2)}, dengan sisa <strong>${n(abkBelum)} anak</strong> yang masih dalam proses pemenuhan akses layanan.`}
      sumber={SB("333–335", "blok rasio partisipasi sekolah dan ABK", F2)}
    >
      <Figur judul="Kinerja kunci pendidikan" satuan="persen">
        <BarH
          label="Angka partisipasi sekolah dan layanan anak berkebutuhan khusus"
          trek
          maks={Math.ceil(ikkP.apk.rasio / 10) * 10}
          acuan={{ nilai: 100, label: "100%" }}
          lebarLabel="13rem"
          rows={[
            { label: "Angka partisipasi kasar", n: ikkP.apk.rasio, tampil: p(ikkP.apk.rasio, 2), sub: `${n(ikkP.apk.sma + ikkP.apk.smk + ikkP.apk.ma)} siswa` },
            { label: "Angka partisipasi murni", n: ikkP.apm.rasio, tampil: p(ikkP.apm.rasio, 2), sub: `dari ${n(ikkP.apm.penduduk)} penduduk usia sekolah` },
            { label: "Anak berkebutuhan khusus terlayani", n: ikkP.abk.persen, tampil: p(ikkP.abk.persen, 2), sub: `${n(ikkP.abk.terlayani)} dari ${n(ikkP.abk.total)} anak`, sorot: true },
          ]}
        />
        <TabelAlt
          slot="tabel"
          judul="indikator kinerja kunci pendidikan"
          kolom={[{ judul: "Indikator" }, { judul: "Nilai (%)", num: true }, { judul: "Rincian" }]}
          baris={[
            ["Angka partisipasi murni", d(ikkP.apm.rasio, 2), `SMA ${n(ikkP.apm.sma)} · SMK ${n(ikkP.apm.smk)} · MA ${n(ikkP.apm.ma)} · tamat ${n(ikkP.apm.tamat)} · penduduk usia sekolah ${n(ikkP.apm.penduduk)}`],
            ["Angka partisipasi kasar", d(ikkP.apk.rasio, 2), `SMA ${n(ikkP.apk.sma)} · SMK ${n(ikkP.apk.smk)} · MA ${n(ikkP.apk.ma)}`],
            ["Anak berkebutuhan khusus terlayani", d(ikkP.abk.persen, 2), `SLB ${n(ikkP.abk.slb)} · inklusi ${n(ikkP.abk.inklusi)} · belum terlayani ${n(ikkP.abk.tidakDiri)} · total ${n(ikkP.abk.total)}`],
          ]}
        />
      </Figur>
    </Adegan>

    <Adegan
      id="6-2"
      judul="Layanan Infrastruktur Dasar"
      pertanyaan="Bagaimana kondisi kemantapan jalan, air baku regional, dan kapasitas fasilitas rujukan kesehatan?"
      tafsir={`Pemenuhan kebutuhan air minum curah regional lintas kabupaten/kota dengan debit ${d(ikkU.airMinum.nilai, 2)} liter/detik berhasil terpenuhi <strong>${p(ikkU.airMinum.persen, 0)}</strong>, serta sebanyak ${p(ikkU.jalan.persen, 2)} ruas jalan provinsi berada dalam kondisi mantap. Pada sektor sanitasi wilayah, utilisasi Sistem Pengolahan Air Limbah (SPAL) domestik regional tercatat sebesar <strong>${p(ikkU.spal.persen, 2)}</strong> dari total kapasitas terpasang. Pada sektor kesehatan rujukan, tersedia sebanyak ${n(ikkH.tempatTidurRsRujukan)} tempat tidur rumah sakit atau setara dengan rasio <strong>${d(ikkH.rasioPerRibu, 2)} per seribu penduduk</strong>.`}
      sumber={[SB("337–339", "blok infrastruktur dasar provinsi", F2), SB("335–337", "blok rumah sakit rujukan", F2)]}
    >
      <Figur judul="Infrastruktur dasar kewenangan provinsi" satuan="persen">
        <Cincin
          label="Capaian infrastruktur dasar: air minum, jalan, dan pengolahan air limbah"
          items={[
            { label: "Air minum curah lintas kabupaten/kota", nilai: ikkU.airMinum.persen, desimal: 0, tampil: d(ikkU.airMinum.persen, 0), sub: `${d(ikkU.airMinum.nilai, 2)} liter per detik terpenuhi` },
            { label: "Kemantapan jalan provinsi", nilai: ikkU.jalan.persen, desimal: 2, tampil: d(ikkU.jalan.persen, 2), sub: `${d(ikkU.jalan.mantapKm, 2)} dari ${d(ikkU.jalan.totalKm, 2)} km mantap` },
            { label: "Pemanfaatan SPAL domestik regional", nilai: ikkU.spal.persen, desimal: 2, tampil: d(ikkU.spal.persen, 2), sub: `volume limbah terolah ${n(ikkU.spal.dilayani)} dari kapasitas ${n(ikkU.spal.total)}`, sorot: true },
          ]}
        />
        <TabelAlt
          slot="tabel"
          judul="indikator infrastruktur dasar dan rumah sakit rujukan"
          kolom={[{ judul: "Indikator" }, { judul: "Nilai", num: true }, { judul: "Rincian" }]}
          baris={[
            ["Air minum curah lintas kabupaten/kota (%)", d(ikkU.airMinum.persen, 2), `${d(ikkU.airMinum.nilai, 2)} ${ikkU.airMinum.satuan}`],
            ["Kemantapan jalan provinsi (%)", d(ikkU.jalan.persen, 2), `${d(ikkU.jalan.mantapKm, 3)} dari ${d(ikkU.jalan.totalKm, 3)} km`],
            ["Pemanfaatan SPAL domestik regional (%)", d(ikkU.spal.persen, 2), `${n(ikkU.spal.dilayani)} dari ${n(ikkU.spal.total)}`],
            ["Tempat tidur RS rujukan per seribu penduduk", d(ikkH.rasioPerRibu, 2), `${n(ikkH.tempatTidurRsRujukan)} tempat tidur · ${n(ikkH.penduduk)} penduduk`],
          ]}
        />
      </Figur>
    </Adegan>

    <Adegan
      id="6-3"
      lebar
      judul="Air Bersih & Sanitasi Layak"
      pertanyaan="Bagaimana sebaran pemenuhan akses air minum aman dan fasilitas sanitasi rumah tangga?"
      tafsir={`Sebagian besar rumah tangga di DIY (<strong>${p(aksesAirPct, 2)}</strong>) telah memiliki akses terhadap air minum layak, dengan ${p(pipaPct, 1)} di antaranya terhubung melalui jaringan perpipaan. Namun, masih terdapat ${n(airTot[2]!)} rumah tangga yang belum terjangkau fasilitas memadai, di mana <strong>${p((100 * air(belumTop)[2]!) / airTot[2]!, 1)}</strong> di antaranya berada di ${namaK(belumTop)}. ${tanpaBelum.length ? `Sebaliknya, ${gabungDan(tanpaBelum)} telah berhasil menuntaskan akses air minum hingga 100%. ` : ""}Jangkauan perpipaan tertinggi berada di ${namaK(pipaTop)} (${p((100 * air(pipaTop)[0]!) / rtKab(pipaTop), 1)}) dan terendah di ${namaK(pipaLow)} (${p((100 * air(pipaLow)[0]!) / rtKab(pipaLow), 1)}). Pada sektor sanitasi, ${p(sanLayakPct, 2)} rumah tangga telah memiliki akses sanitasi layak${tanpaBabs ? " dan bebas dari praktik buang air besar sembarangan" : ""}, meski baru <strong>${p(sanAmanPct, 2)}</strong> yang memenuhi kualifikasi sanitasi aman—dengan capaian tertinggi di ${namaK(amanTop)} dan terendah di ${namaK(amanLow)}.`}
      sumber={[SB(467, 3, F7a), SB(463, 1, F7a)]}
    >
      <Figur judul="Akses air minum rumah tangga" satuan="satu kotak = satu persen rumah tangga wilayahnya, 2023">
        <WaffleDeret label="Akses air minum rumah tangga per kabupaten/kota 2023" kat={KAT_AIR} rows={rowsAir} />
        <TabelAlt
          slot="tabel"
          judul="akses air minum rumah tangga per kabupaten/kota"
          kolom={[{ judul: "Kabupaten/kota" }, { judul: "Perpipaan", num: true }, { judul: "Bukan perpipaan", num: true }, { judul: "Belum ada akses", num: true }, { judul: "Rumah tangga", num: true }]}
          baris={[...KODE.map((k) => [namaK(k), n(air(k)[0]!), n(air(k)[1]!), n(air(k)[2]!), n(rtKab(k))]), ["DIY", n(airTot[0]!), n(airTot[1]!), n(airTot[2]!), n(rtDIY)]]}
        />
      </Figur>
      <Figur
        judul="Akses sanitasi rumah tangga"
        satuan="persen rumah tangga wilayahnya, 2023"
        legenda={[
          { label: "Aman", warna: "#184531" },
          { label: "Layak, individu", warna: "#73a888" },
          { label: "Layak, bersama", warna: "#bcd8c0" },
          { label: "Belum layak", warna: "#d82128" },
        ]}
      >
        <Tumpuk label="Akses sanitasi rumah tangga per kabupaten/kota 2023" rows={rowsSanitasi} lebarLabel="9rem" />
        <TabelAlt
          slot="tabel"
          judul="akses sanitasi rumah tangga per kabupaten/kota"
          kolom={[{ judul: "Wilayah" }, { judul: "BABS", num: true }, { judul: "Belum layak", num: true }, { judul: "Layak individu", num: true }, { judul: "Layak bersama", num: true }, { judul: "Aman", num: true }, { judul: "Jumlah", num: true }]}
          baris={[...KODE, "DIY"].map((k) => [namaK(k), ...san(k).map((v) => n(v))])}
        />
      </Figur>
    </Adegan>

    <Adegan
      id="6-4"
      lebar
      judul="Evaluasi Capaian SPM"
      pertanyaan="Bidang pelayanan dasar mana yang telah berhasil menuntaskan target Standar Pelayanan Minimal?"
      tafsir={`Sebanyak ${kata(paripurna.length)} dari ${kata(spmKat.length)} bidang SPM di DIY berhasil meraih predikat tertinggi (kategori "Paripurna") dengan indeks sempurna ${d(paripurna[0]?.indeks ?? 0, 0)}. Sementara itu, bidang lainnya mencatatkan capaian mendekati tuntas: ${nonParipurna.map((k) => `bidang ${k.bidang} berada pada predikat ${k.kategori.toLowerCase()} dengan capaian indeks <strong>${d(k.indeks, 2)}</strong>`).join("; ")}.`}
      sumber={SB("1046–1105", "kategori dan indikator SPM per bidang", FS)}
    >
      <Figur judul="Indeks pencapaian SPM" satuan="indeks per bidang, skor penuh 100">
        <Cincin
          label="Indeks pencapaian SPM per bidang"
          items={[...spmKat]
            .sort((a, b) => a.indeks - b.indeks)
            .map((k) => ({
              label: k.bidang,
              nilai: k.indeks,
              desimal: Number.isInteger(k.indeks) ? 0 : 2,
              tampil: d(k.indeks, Number.isInteger(k.indeks) ? 0 : 2),
              sub: kalimat(k.kategori),
              sorot: k.kategori !== "PARIPURNA",
              warna: k.kategori === "PARIPURNA" ? "#184531" : undefined,
            }))}
        />
        <TabelAlt
          slot="tabel"
          judul="kategori dan indeks SPM per bidang"
          kolom={[{ judul: "Bidang" }, { judul: "Kategori" }, { judul: "Indeks", num: true }]}
          baris={spmKat.map((k) => [k.bidang, kalimat(k.kategori), d(k.indeks, 2)])}
        />
      </Figur>
    </Adegan>

    <Adegan
      id="6-5"
      lebar
      judul="Rincian SPM Pendidikan"
      pertanyaan="Indikator mutu pendidikan pada jenjang mana saja yang masih memerlukan akselerasi pemenuhan?"
      tafsir={`Dari total ${n(pInd.length)} indikator SPM pendidikan yang dievaluasi, tercatat <strong>${n(indBelum.length)} indikator</strong> yang belum memenuhi target 100%. Kesenjangan pemenuhan terbesar terdapat pada indikator ${indTerendah.label.toLowerCase()} jenjang ${indTerendah.jenjang.toLowerCase()} yang baru mencapai <strong>${p(indTerendah.pct, 2)}</strong> dari target. Pada jenjang lainnya, akselerasi masih diperlukan pada aspek ${gabungDan(labelBelumSmaSmk)}.`}
      sumber={[SB(1046, 1, FS), SB(1047, 1, FS)]}
    >
      <Figur judul="Indikator SPM pendidikan" satuan="persen dari target; merah: belum mencapai target">
        <DaftarCapaian label="Capaian indikator SPM pendidikan per jenjang" kelompok={kelompokSpm} />
        <TabelAlt
          slot="tabel"
          judul="capaian dan target indikator SPM pendidikan"
          kolom={[{ judul: "Jenjang" }, { judul: "Indikator" }, { judul: "Satuan" }, { judul: "Target", num: true }, { judul: "Capaian", num: true }, { judul: "% target", num: true }]}
          baris={pInd.map((x) => [x.jenjang, x.label, x.satuan, d(x.target, 2), d(x.capaian, 2), d(x.pct, 2)])}
        />
      </Figur>
    </Adegan>

    <Adegan
      id="6-6"
      judul="Pendidikan Khusus & Inklusi"
      pertanyaan="Berapa banyak anak berkebutuhan khusus yang telah memperoleh layanan pendidikan khusus?"
      tafsir={`Penyelenggaraan layanan pendidikan khusus di DIY telah menjangkau sebanyak <strong>${n(khus.terlayani)} anak</strong> dari total sasaran ${n(khus.harusDilayani)} anak berkebutuhan khusus (${p(khus.persen, 2)}). Upaya pemenuhan terus ditingkatkan untuk memfasilitasi <strong>${n(khus.belumTerlayani)} anak</strong> yang belum terlayani secara optimal. Adapun indeks pencapaian SPM pendidikan khusus secara keseluruhan berhasil mencapai angka <strong>${d(khus.indeksKhusus, 2)}</strong>.`}
      sumber={SB(1047, 1, FS)}
    >
      <Figur judul="Layanan pendidikan khusus" satuan="satu kotak = satu persen anak yang harus dilayani">
        <Waffle
          label="Layanan pendidikan khusus: terlayani dan belum terlayani"
          kat={[
            { label: "Terlayani", n: khus.terlayani, tampil: `${n(khus.terlayani)} anak`, porsi: p(khus.persen, 2), warna: "#045b87" },
            { label: "Belum terlayani", n: khus.belumTerlayani, tampil: `${n(khus.belumTerlayani)} anak`, porsi: p(100 - khus.persen, 2), warna: C.sorot },
          ]}
        />
        <TabelAlt
          slot="tabel"
          judul="layanan pendidikan khusus"
          kolom={[{ judul: "Uraian" }, { judul: "Nilai", num: true }]}
          baris={[
            ["Anak yang harus dilayani", n(khus.harusDilayani)],
            ["Terlayani", n(khus.terlayani)],
            ["Belum terlayani", n(khus.belumTerlayani)],
            ["Persentase terlayani", d(khus.persen, 2)],
            ["Indeks pencapaian SPM pendidikan khusus", d(khus.indeksKhusus, 2)],
            ["Indeks penerima layanan", d(khus.indeksPenerimaLD, 2)],
          ]}
        />
      </Figur>
    </Adegan>
  </Bab>

  {/* ═════════════════════════ Penutup ═════════════════════════ */}
  <section class="penutup" id="penutup" aria-labelledby="penutup-judul">
    <div class="wrap">
      <header class="jb" data-reveal>
        <span class="jb__no">{i.penutup.label}</span>
        <h2 class="jb__teks" id="penutup-judul">{i.penutup.judul}</h2>
        <div class="jb__garis" aria-hidden="true"></div>
      </header>
      <p class="ringkasan__lead" data-reveal>{i.penutup.lead}</p>
    </div>

    <Adegan
      id="7-1"
      judul="Catatan Rekonsiliasi Data"
      pertanyaan="Hal teknis dan diskrepansi apa saja yang ditemukan saat verifikasi data laporan resmi?"
      tafsir={`Selama proses verifikasi dan ekstraksi data dokumen LPPD DIY 2023, sistem mencatat secara transparan <strong>${n(celah.length)} poin anomali teknis</strong>. Catatan ini mencakup selisih pembulatan antar-tabel, sel dokumen pindaian yang buram (OCR), ralat resmi yang dicantumkan dalam naskah laporan, serta variasi penulisan angka. Seluruh data yang tidak terbaca utuh tidak direkayasa, melainkan dicatat apa adanya demi menjaga akuntabilitas informasi.`}
      sumberTeks="manifes catatan celah, dihasilkan scripts/build_data.mjs dari pemeriksaan aritmetika atas tabel LPPD DIY 2023 (bab 1–5)."
    >
      <ol class="daftar-celah">
        {celah.map((c) => <li data-anim="naik">{c}</li>)}
      </ol>
    </Adegan>

    <Adegan
      id="7-2"
      judul="Dataset & Unduhan Publik"
      pertanyaan="Bagaimana cara mengunduh dan memanfaatkan dataset terbuka dari data story ini?"
      tafsir={`Tersedia <strong>${n(unduhan.filter((u) => u.berkas.endsWith(".csv")).length)} berkas dataset CSV</strong> berisi tabel-tabel agregat yang telah lolos validasi aritmetika, serta ${kata(unduhan.filter((u) => u.berkas.endsWith(".geojson")).length)} berkas GeoJSON batas wilayah yang dapat digunakan langsung pada perangkat lunak GIS maupun aplikasi pengolah data. Setiap berkas memuat rujukan tabel sumber secara lengkap untuk memudahkan audit dan analisis lanjutan.`}
      sumberTeks="berkas unduhan dihasilkan pipeline dari tabel LPPD DIY 2023 (bab 1–5), pemisah titik koma, desimal koma; GeoJSON dalam EPSG:4326."
    >
      <ul class="unduhan">
        {
          unduhan.map((u) => (
            <li data-anim="naik">
              <a href={`./data/${u.berkas}`} download>
                <b>{u.berkas}</b>
                <span>{u.tentang}</span>
                <small>{u.sumber}</small>
                <em>{u.berkas.endsWith(".geojson") ? "Unduh GeoJSON" : "Unduh CSV"}</em>
              </a>
            </li>
          ))
        }
      </ul>
    </Adegan>

    <div class="wrap">
      <div class="kolofon" data-reveal>
        <p><b>Data.</b> {i.penutup.kolofonData}</p>
        <p>
          <b>Desain.</b> {i.penutup.kolofonDesain}{" "}
          <a href="./lisensi/Jogjakartype-EULA.pdf">Lisensi Jogjakartype</a> · <a href="./lisensi/SourceSans3-OFL.txt">Lisensi Source Sans 3</a>
        </p>
      </div>
    </div>
  </section>

  {/* ═════════════════════════ Matur Nuwun ═════════════════════════ */}
  <section class="akhir" id="akhir" data-reveal aria-label="Penutup">
    <p class="akhir__kata" lang="jv">{i.akhir.kata}</p>
    <p class="akhir__sub">{i.akhir.sub}</p>
    <a class="akhir__atas" href="#sampul">{i.akhir.atas}</a>
    <img class="deret" src="./brand/deret-ikon-emas.svg" alt="" width="842" height="141" loading="lazy" />
  </section>
</Layout>
