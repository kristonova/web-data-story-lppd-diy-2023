// ── Pembantu ────────────────────────────────────────────────────────────────
const SB = (halaman: string | number, tabel: string | number, berkas: string): Sumber => ({ berkas, halaman, tabel });
const F1 = "bab-1-pendahuluan.md";
const FM = "bab2-2_1_capaian-kinerja-makro.md";
const F2 = "bab2-2_2_2_indikator-kinerja-kunci-hasil.md";
const FP = "bab2-2_2_6_22_urusan-penanaman-modal-dinas-penanaman-modal-dan-pelayanan.md";
const FK = "bab2-2_2_11_2_perencanaan-pembangunan-paniradya-kaistimewan-diy.md";
const FB = "bab2-2_2_8_5_bantuan-keuangan-khusus-bkk-kalurahan.md";
const FS = "bab-4-penerapan-standar.md";
const maks = <T,>(xs: T[], f: (x: T) => number): T => xs.reduce((m, x) => (f(x) > f(m) ? x : m), xs[0]!);
const mins = <T,>(xs: T[], f: (x: T) => number): T => xs.reduce((m, x) => (f(x) < f(m) ? x : m), xs[0]!);
const jumlah = (xs: number[]) => xs.reduce((s, v) => s + v, 0);
const arahKata = (v: number) => (v > 0 ? "naik" : v < 0 ? "turun" : "tetap");
const arah = (v: number): "naik" | "turun" => (v >= 0 ? "naik" : "turun");
const awalKecil = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const awalBesar = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const gabungDan = (xs: string[]) => (xs.length < 2 ? xs.join("") : `${xs.slice(0, -1).join(", ")}, dan ${xs[xs.length - 1]}`);

const C = {
  sorot: "var(--c-sorot)",
  tinta: "var(--c-tinta)",
  dasar: "var(--c-dasar)",
  redup: "var(--c-redup)",
  emas: "var(--c-emas)",
  ink: "var(--ink)",
};

// Klasifikasi rujukan di luar LPPD — disebut namanya di kalimat tafsir.
/** BPS: IPM ≥ 80 berkategori "sangat tinggi". */
const IPM_SANGAT_TINGGI = 80;
/** Bank Dunia: porsi pengeluaran 40% terbawah < 12% ketimpangan tinggi, 12–17% sedang, > 17% rendah. */
const BD = { tinggi: 12, rendah: 17 };
const kategoriBD = (v: number) => (v < BD.tinggi ? "tinggi" : v <= BD.rendah ? "sedang" : "rendah");

// ══ Ringkasan: enam indikator makro ═════════════════════════════════════════
const md = pembuka.indikator;
const cari = (j: string) => md.find((x) => x.jenis === j)!;
const ipmC = cari("ipm");
const kemC = cari("kemiskinan");
const pptC = cari("pengangguran");
const grwC = cari("pertumbuhan");
const pkpC = cari("perkapita");
const ginC = cari("gini");
const membaik = [
  ipmC.nilai2023 > ipmC.nilai2022,
  kemC.nilai2023 < kemC.nilai2022,
  pptC.nilai2023 < pptC.nilai2022,
  grwC.perubahan > 0,
  pkpC.nilai2023 > pkpC.nilai2022,
  ginC.nilai2023 < ginC.nilai2022,
].filter(Boolean).length;
const kpi = [
  {
    nilai: ipmC.nilai2023, desimal: 2, tampil: d(ipmC.nilai2023, 2),
    label: "Indeks Pembangunan Manusia",
    sub: `${arahKata(ipmC.nilai2023 - ipmC.nilai2022)} ${d(Math.abs(ipmC.nilai2023 - ipmC.nilai2022), 2)} poin dari ${d(ipmC.nilai2022, 2)} pada 2022`,
    arah: arah(ipmC.nilai2023 - ipmC.nilai2022), baik: ipmC.nilai2023 >= ipmC.nilai2022, sorot: true,
  },
  {
    nilai: kemC.nilai2023, desimal: 2, tampil: d(kemC.nilai2023, 2), satuan: "%",
    label: "Penduduk miskin",
    sub: `${arahKata(kemC.nilai2023 - kemC.nilai2022)} ${d(Math.abs(kemC.nilai2023 - kemC.nilai2022), 2)} poin persen dari ${d(kemC.nilai2022, 2)}%`,
    arah: arah(kemC.nilai2023 - kemC.nilai2022), baik: kemC.nilai2023 <= kemC.nilai2022,
  },
  {
    nilai: pptC.nilai2023, desimal: 2, tampil: d(pptC.nilai2023, 2), satuan: "%",
    label: "Tingkat pengangguran terbuka",
    sub: `${arahKata(pptC.nilai2023 - pptC.nilai2022)} ${d(Math.abs(pptC.nilai2023 - pptC.nilai2022), 2)} poin persen dari ${d(pptC.nilai2022, 2)}%`,
    arah: arah(pptC.nilai2023 - pptC.nilai2022), baik: pptC.nilai2023 <= pptC.nilai2022,
  },
  {
    nilai: grwC.perubahan, desimal: 2, tampil: d(grwC.perubahan, 2), satuan: "%",
    label: "Pertumbuhan ekonomi",
    sub: `PDRB atas dasar harga konstan ${rp(grwC.nilai2023 * 1e6)}`,
    arah: arah(grwC.perubahan), baik: grwC.perubahan >= 0,
  },
  {
    awalan: "Rp", nilai: pkpC.nilai2023, desimal: 2, tampil: d(pkpC.nilai2023, 2), satuan: "juta",
    label: "Pendapatan per kapita",
    sub: `${arahKata(pkpC.perubahan)} ${d(Math.abs(pkpC.perubahan), 2)}% dari Rp${d(pkpC.nilai2022, 2)} juta`,
    arah: arah(pkpC.perubahan), baik: pkpC.perubahan >= 0,
  },
  {
    nilai: ginC.nilai2023, desimal: 3, tampil: d(ginC.nilai2023, 3),
    label: "Rasio gini",
    sub: `${arahKata(ginC.nilai2023 - ginC.nilai2022)} dari ${d(ginC.nilai2022, 3)} pada 2022`,
    arah: arah(ginC.nilai2023 - ginC.nilai2022), baik: ginC.nilai2023 <= ginC.nilai2022,
  },
];
const leadRingkasan =
  `Sepanjang 2023, ${membaik === md.length ? `ke${kata(md.length)}` : `${kata(membaik)} dari ${kata(md.length)}`} indikator makro DIY bergerak ke arah yang lebih baik. ` +
  `Indeks pembangunan manusia mencapai <strong>${d(ipmC.nilai2023, 2)}</strong>, kemiskinan turun menjadi <strong>${d(kemC.nilai2023, 2)}%</strong>, dan ekonomi tumbuh <strong>${d(grwC.perubahan, 2)}%</strong>.`;

// ══ Bab 1: wilayah dan penduduk ═════════════════════════════════════════════
const luas = pilar1.luas;
const pdk = pilar1.penduduk;
const adm = pilar1.administrasi;
const kab = luas.perKab.map((l) => {
  const nm = namaKab(l.nama);
  const pk = pdk.perKab.find((k) => namaKab(k.nama) === nm)!;
  const ad = adm.perKab.find((a) => namaKab(a.nama) === nm)!;
  return {
    nama: nm,
    km2: l.km2,
    luasPct: l.persen,
    jiwa: pk.jumlah,
    jiwaPct: pk.jumlahPersen,
    laki: pk.laki,
    perempuan: pk.perempuan,
    padat: pk.jumlah / l.km2,
    kap: ad.kapanewonKemantren,
    kal: ad.kalurahan ?? 0,
    kel: ad.kelurahan ?? 0,
  };
});
const kabLuas = [...kab].sort((a, b) => b.km2 - a.km2);
const kabTerluas = kabLuas[0]!;
const kabTerpadat = maks(kab, (k) => k.padat);
const kabTerramai = maks(kab, (k) => k.jiwa);
const padatDIY = pdk.total / luas.total;
const kaliPadat = Math.floor(kabTerpadat.padat / kabTerluas.padat);
const kabRamai = [...kab].sort((a, b) => b.jiwa - a.jiwa);
const kabDesa = [...kab].sort((a, b) => b.kal + b.kel - (a.kal + a.kel));
const kabDesaTerbanyak = kabDesa[0]!;

const usia = pilar1.usia.perKelompok;
const ikhtisar = pilar1.usia.ikhtisar;
const [ikAnak, ikProd, ikLansia] = [ikhtisar[0]!, ikhtisar[1]!, ikhtisar[2]!];
const labelUsia = (s: string) => s.replace(/^usia\s*/i, "").replace(/^produktif\s*/i, "").replace("-", "–");
const rasioTanggungan = (100 * (ikAnak.jumlah + ikLansia.jumlah)) / ikProd.jumlah;
const awalLansia = Number(labelUsia(ikLansia.nama).replace(/\D+$/, ""));
const awalProduktif = Number(labelUsia(ikProd.nama).split("–")[0]);
const grupUsia = (label: string) => {
  const awal = Number(label.split("-")[0]!.replace(/\D/g, ""));
  return awal >= awalLansia ? C.sorot : awal >= awalProduktif ? C.dasar : C.redup;
};
const usiaTerbesar = maks(usia, (g) => g.jumlah);
const satuDari = Math.round(100 / ikLansia.persen);

// ══ Bab 2: keuangan daerah ══════════════════════════════════════════════════
const pdp = pilar2.pendapatan;
const bln = pilar2.belanja;
const tumbuhPendapatan = 100 * (pdp.total.realisasi / pdp.total.realisasi2022 - 1);
const sharePdp = (v: number) => p((100 * v) / pdp.total.realisasi, 1);
const petakPendapatan = [
  { label: "Pajak daerah", n: pdp.pajak.realisasi, warna: C.sorot },
  { label: "Retribusi daerah", n: pdp.retribusi.realisasi, warna: C.sorot },
  { label: "Hasil kekayaan daerah yang dipisahkan", n: pdp.kekayaan.realisasi, warna: C.sorot },
  { label: "Lain-lain PAD yang sah", n: pdp.lainPad.realisasi, warna: C.sorot },
  { label: "Transfer pemerintah pusat", n: pdp.transferPusat.realisasi, warna: C.tinta },
  { label: "Transfer antardaerah", n: pdp.transferAntar.realisasi, warna: C.tinta },
  { label: "Lain-lain pendapatan daerah yang sah", n: pdp.lainSah.realisasi, warna: C.emas, teks: "var(--ink)" },
].map((x) => ({ ...x, tampil: rpS(x.n), porsi: sharePdp(x.n), sub: x.warna === C.sorot ? "Pendapatan asli daerah" : undefined }));
const shareTransferPusat = (100 * pdp.transferPusat.realisasi) / pdp.total.realisasi;
const sharePajak = (100 * pdp.pajak.realisasi) / pdp.total.realisasi;

const B = (label: string, x: { anggaran: number; realisasi: number; persen: number }, tingkat: 0 | 1, sorot = false) => ({
  label,
  anggaran: x.anggaran,
  realisasi: x.realisasi,
  tampilA: rp(x.anggaran),
  tampilR: rpS(x.realisasi),
  serapan: p(x.persen, 1),
  tingkat,
  sorot,
});
const barisBelanja = [
  B("Belanja operasi", bln.operasi, 0),
  B("Pegawai", bln.pegawai, 1),
  B("Barang dan jasa", bln.barangJasa, 1, true),
  B("Subsidi", bln.subsidi, 1),
  B("Hibah", bln.hibah, 1),
  B("Bantuan sosial", bln.bansos, 1),
  B("Belanja modal", bln.modal, 0),
  B("Tanah", bln.modalTanah, 1),
  B("Peralatan dan mesin", bln.modalMesin, 1),
  B("Gedung dan bangunan", bln.modalGeuting, 1),
  B("Jalan, irigasi, dan jaringan", bln.modalJalan, 1),
  B("Aset tetap lainnya", bln.modalAsetTetap, 1),
  B("Belanja tidak terduga", bln.takTerduga, 0),
  B("Belanja transfer", bln.transfer, 0),
  B("Bagi hasil", bln.bagiHasil, 1),
  B("Bantuan keuangan", bln.bantuanKeuangan, 1),
];
const shareBelanja = (x: { realisasi: number }) => (100 * x.realisasi) / bln.total.realisasi;
const sisaBJ = bln.barangJasa.anggaran - bln.barangJasa.realisasi;

const NAMA_KELOMPOK: Record<string, string> = {
  "1": "Urusan wajib pelayanan dasar",
  "2": "Urusan wajib non-pelayanan dasar",
  "3": "Urusan pilihan",
  "4": "Unsur pendukung",
  "5": "Unsur penunjang",
  "6": "Unsur pengawasan",
  "8": "Unsur pemerintahan umum",
};
const NAMA_DASAR: Record<string, string> = {
  "1.01": "Pendidikan",
  "1.02": "Kesehatan",
  "1.03": "Pekerjaan umum dan penataan ruang",
  "1.04": "Perumahan dan kawasan permukiman",
  "1.05": "Ketenteraman, ketertiban umum, dan perlindungan masyarakat",
  "1.06": "Sosial",
};
const urDasar = pilar2u.dasar;
const urKes = mins(urDasar, (u) => u.persen);
const urPend = maks(urDasar, (u) => u.anggaran);
const dotBaris = (u: (typeof urDasar)[number], nama: string, sorot: boolean) => ({
  label: nama,
  persen: u.persen,
  tampil: p(u.persen, 2),
  bobot: u.anggaran,
  sub: `Anggaran ${rpS(u.anggaran)} · realisasi ${rpS(u.realisasi)}`,
  sorot,
});
const serapanMin = Math.floor(Math.min(...[...pilar2u.kelompok, ...urDasar].map((u) => u.persen)) / 5) * 5;

// ══ Bab 3: kesejahteraan ════════════════════════════════════════════════════
const ipm = pilar3.ipm;
const tahunIpm = ["2020", "2021", "2022", "2023"] as const;
const nilaiIpm = (k: (typeof ipm.komponen)[number]) => [k.nilai.t2020, k.nilai.t2021, k.nilai.t2022, k.nilai.t2023];
const fmtKomponen = (k: (typeof ipm.komponen)[number], v: number) =>
  /rupiah/.test(k.satuan) ? `Rp${d(v / 1000, 2)} juta` : `${d(v, 2)} tahun`;
const semuaNaik = ipm.komponen.every((k) => k.nilai.t2023 > k.nilai.t2020);
const kPPP = ipm.komponen.find((k) => /rupiah/.test(k.satuan))!;
const kRLS = ipm.komponen.find((k) => /Rata-rata/i.test(k.nama))!;
const pppTumbuh = 100 * (kPPP.nilai.t2023 / kPPP.nilai.t2020 - 1);
const panelIpm = ipm.komponen.map((k) => ({
  judul: k.nama.replace(" (PPP)", ""),
  ringkas: fmtKomponen(k, k.nilai.t2023),
  perubahan: /rupiah/.test(k.satuan)
    ? `${sel2(pppTumbuh, 1)}% sejak 2020`
    : `${sel2(k.nilai.t2023 - k.nilai.t2020, 2)} tahun sejak 2020`,
  nilai: nilaiIpm(k),
  tampil: nilaiIpm(k).map((v) => fmtKomponen(k, v)),
  sorot: k === kPPP,
}));

const kem = pilar3.kemiskinan;
const periode = [...new Set(kem.perDaerah.map((x) => x.periode))];
const pendek = (s: string) => s.replace("September", "Sep").replace("Maret", "Mar");
const ambilKem = (daerah: string, per: string) => kem.perDaerah.find((x) => x.daerah === daerah && x.periode === per)!;
const kemSeri = [
  { label: "Perdesaan", warna: C.sorot },
  { label: "DIY", warna: C.dasar, putus: true },
  { label: "Perkotaan", warna: C.tinta },
].map((s) => {
  const daerah = s.label === "DIY" ? "Total" : s.label;
  const v = periode.map((per) => ambilKem(daerah, per).persen);
  return { ...s, nilai: v, tampil: v.map((x) => p(x, 2)) };
});
const perAkhir = periode[periode.length - 1]!;
const perAwal = periode[0]!;
const kemAkhir = ambilKem("Total", perAkhir);
const kemAwal = ambilKem("Total", perAwal);
const kemDesa = ambilKem("Perdesaan", perAkhir);
const kemKota = ambilKem("Perkotaan", perAkhir);
const desaSelaluLebih = periode.every((per) => ambilKem("Perdesaan", per).persen > ambilKem("Perkotaan", per).persen);
const kemMin = Math.floor(Math.min(...kemSeri.flatMap((s) => s.nilai)) - 1);
const kemMax = Math.ceil(Math.max(...kemSeri.flatMap((s) => s.nilai)) + 1);
const kemTik = Array.from({ length: Math.floor((kemMax - kemMin) / 2) + 1 }, (_, j) => kemMin + 2 * j)
  .filter((v) => v <= kemMax)
  .map((v) => ({ nilai: v, label: `${v}%` }));

const kk = pilar3.ketenagakerjaan;
const kkB = (label: string) => kk.baris.find((b) => b.label.includes(label))!;
const kkPUK = kkB("usia kerja");
const kkKerja = kkB("Bekerja");
const kkPeng = kkB("Pengangguran");
const kkBAK = kkB("Bukan angkatan");
const rowKerja = (["t2022", "t2023"] as const).map((t) => ({
  label: `Agustus ${t.slice(1)}`,
  total: `${n(kkPUK[t])} ribu penduduk usia kerja`,
  ruas: [
    { label: "Bekerja", n: kkKerja[t], tampil: `${n(kkKerja[t])} ribu`, warna: C.tinta },
    { label: "Pengangguran", n: kkPeng[t], tampil: `${d(kkPeng[t], 2)} ribu`, warna: C.sorot },
    { label: "Bukan angkatan kerja", n: kkBAK[t], tampil: `${n(kkBAK[t])} ribu`, warna: C.redup, teks: "var(--ink)" },
  ],
}));

const ktd = pilar3.ketimpangan;
const ktdAkhir = ktd.perDaerah.filter((x) => x.periode === "Maret 2023");
const ktdAmbil = (dae: string) => ktdAkhir.find((x) => x.daerah === dae)!;
const rowTimpang = (["Perkotaan", "Perdesaan", "Total"] as const).map((dae) => {
  const x = ktdAmbil(dae);
  return {
    label: dae === "Total" ? "DIY" : dae,
    sub: `Maret 2023 · kriteria Bank Dunia: ketimpangan ${kategoriBD(x.p40Bawah)}`,
    ruas: [
      { label: "40% terbawah", n: x.p40Bawah, tampil: p(x.p40Bawah, 2), warna: C.sorot },
      { label: "40% menengah", n: x.p40Tengah, tampil: p(x.p40Tengah, 2), warna: C.dasar },
      { label: "20% teratas", n: x.p20Atas, tampil: p(x.p20Atas, 2), warna: C.tinta },
    ],
  };
});
const tKota = ktdAmbil("Perkotaan");
const tDesa = ktdAmbil("Perdesaan");

// ══ Bab 4: kinerja kunci dan investasi ══════════════════════════════════════
const ikkP = pilar4.ikkPendidikan;
const ikkH = pilar4.ikkKesehatan;
const ikkU = pilar4.ikkPU;
const abkBelum = ikkP.abk.total - ikkP.abk.terlayani;
const inv = pilar4.investasi;
const [inv22, inv23] = [inv.seri[0]!, inv.seri[1]!];
const pmdnShare = (100 * inv23.pmdnTriliun) / inv23.totalTriliun;
const tahunInv = ["2019", "2020", "2021", "2022", "2023"];
const nilaiKab = (k: (typeof inv.perKab)[number]) => [k.t2019, k.t2020, k.t2021, k.t2022, k.t2023];
const fmtM = (v: number) => (v === 0 ? "0" : v >= 1000 ? `Rp${d(v / 1000, 2)} T` : `Rp${n(v)} M`);
const kabInv = [...inv.perKab].sort((a, b) => b.t2023 - a.t2023);
const invTerbesar = kabInv[0]!;
const totalInv23 = jumlah(inv.perKab.map((k) => k.t2023));
const kp = inv.perKab.find((k) => /Kulon/.test(k.kabkota))!;
const kpTurunTerus = nilaiKab(kp).every((v, j, a) => j === 0 || v < a[j - 1]!);
const bantul = inv.perKab.find((k) => /Bantul/.test(k.kabkota))!;
const bantulKali = bantul.t2023 / bantul.t2021;

// ══ Bab 5: keistimewaan ═════════════════════════════════════════════════════
const nA = pilar5.nilaiAkhir;
const urK = pilar5.urusan;
const bkk = pilar5.bkk;
const namaNA = [
  "Capaian fisik dan keuangan urusan keistimewaan",
  "Kepuasan masyarakat atas penyebarluasan informasi keistimewaan",
  "Kepuasan Paramparapraja atas pelayanan",
];
const warnaNA = [C.tinta, C.sorot, C.dasar];
const komponenNA = nA.baris.map((b, j) => ({
  label: namaNA[j] ?? b.nama,
  bobot: b.bobot,
  hasil: b.hasil,
  rincian: `${d(b.nilai, 2)} × ${b.bobot}% = ${d(b.hasil, 2)}`,
  sisa: `${d(b.bobot - b.hasil, 2)} poin dari bobot ${b.bobot} tidak teraih`,
  warna: warnaNA[j] ?? C.dasar,
}));
const naHilang = maks(nA.baris, (b) => b.bobot - b.hasil);
const naHilangIdx = nA.baris.indexOf(naHilang);
const urKeb = maks(urK.baris, (b) => b.anggaran);
const urRendah = mins(urK.baris, (b) => b.keuangan);
const warnaUrusan: Record<string, string> = { Kebudayaan: C.sorot, "Tata Ruang": C.tinta, Kelembagaan: C.dasar, Pertanahan: C.redup };
const barisUrusanK = [...urK.baris]
  .sort((a, b) => b.anggaran - a.anggaran)
  .map((b) => ({
    label: kalimat(b.nama),
    anggaran: b.anggaran,
    realisasi: b.realisasi,
    tampilA: rp(b.anggaran),
    tampilR: rpS(b.realisasi),
    serapan: p(b.keuangan, 2),
    tingkat: 0 as const,
    sorot: b === urRendah,
  }));
const AKRONIM = ["DIY", "DLHK", "DPUPESDM", "DISBUD", "WBTB", "DPKP", "DINKOP", "DISPAR", "SATPOL", "PP", "RTLH", "DPTR", "DISNAKERTRAN", "TAPEM", "BKK"];
const namaBkk = (s: string) =>
  kalimat(s.replace(/^BKK\s*KALURAHAN\s*-\s*/i, "").replace(/^BKK\s*-\s*/i, "").replace(/^BKK\s*KALURAHAN-/i, ""), AKRONIM);
const bkkUrut = [...bkk.baris].sort((a, b) => b.pagu - a.pagu);
const bkkTerbesar = bkkUrut[0]!;
const bkkFisikPenuh = bkk.baris.every((b) => b.fisik === 100);

// ══ Bab 6: SPM ══════════════════════════════════════════════════════════════
const spmKat = pilar6.kategori;
const paripurna = spmKat.filter((k) => k.kategori === "PARIPURNA");
const nonParipurna = spmKat.filter((k) => k.kategori !== "PARIPURNA");
const pInd = pilar6.pendidikanIndikator;
const jenjang = [...new Set(pInd.map((x) => x.jenjang))];
const kelompokSpm = jenjang.map((j) => {
  const rows = pInd.filter((x) => x.jenjang === j);
  const belum = rows.filter((x) => x.pct < 100).length;
  return {
    judul: j,
    ringkas: `${belum} dari ${rows.length} indikator belum mencapai target`,
    rows: rows.map((x) => ({
      label: x.label,
      persen: x.pct,
      tampil: p(x.pct, 2),
      rinci: `Capaian ${d(x.capaian, 2)} · target ${d(x.target, 2)}${x.satuan === "%" ? "%" : ""}`,
    })),
  };
});
const indBelum = pInd.filter((x) => x.pct < 100);
const indTerendah = mins(pInd, (x) => x.pct);
const labelBelumSmaSmk = [...new Set(indBelum.filter((x) => x !== indTerendah && x.jenjang !== indTerendah.jenjang).map((x) => x.label.toLowerCase()))];
const khus = pilar6.pendidikanKhusus;

// ══ Penutup ═════════════════════════════════════════════════════════════════
const unduhan = manifes.unduhan;
const celah = manifes.catatanCelah;

const nav = [
  { href: "#ringkasan", label: "Ringkasan" },
  ...i.bab.map((b) => ({ href: `#${b.id}`, label: b.nav })),
  { href: "#penutup", label: "Penutup" },
];
const leadBab = [
  `DIY adalah provinsi dengan wilayah daratan terkecil kedua di Indonesia. Penduduknya padat di kota dan menyebar di perbukitan selatan; yang paling luas bukan yang paling ramai.`,
  `Pendapatan hampir seluruhnya terealisasi, belanja menyusul sedikit di belakangnya. Porsi terbesar pendapatan masih datang dari transfer pemerintah pusat, bukan dari pungutan daerah sendiri.`,
  `Ukuran-ukuran kesejahteraan bergerak ke arah yang sama: pembangunan manusia naik, kemiskinan dan pengangguran turun. Ketimpangan bergeser tipis, dan jarak antara kota dan desa masih terlihat.`,
  `Sebagian layanan dasar sudah penuh, sebagian lain menyisakan pekerjaan rumah yang nyata. Penanaman modal terus tumbuh, tetapi petanya tidak merata antarkabupaten.`,
  `Urusan keistimewaan dinilai dari capaian fisik dan keuangan serta kepuasan masyarakat. Sebagian besar dananya mengalir ke kebudayaan, dan sebagian diturunkan langsung ke kalurahan.`,
  `${awalBesar(kata(paripurna.length))} dari ${kata(spmKat.length)} bidang layanan dasar meraih kategori tertinggi. ${nonParipurna.map((k) => k.bidang).join(", ")} menjadi bidang yang belum tuntas, dan rinciannya menunjukkan di mana celahnya.`,
];
