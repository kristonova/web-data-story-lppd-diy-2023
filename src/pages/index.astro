const S = (id: string, label: string, x: { realisasi: number }, grup: string, baris?: string[]) => ({ id, label, nilai: x.realisasi, tampil: rpS(x.realisasi), grup, baris });
const arusKiri = [
  S("pajak", "Pajak daerah", pdp.pajak, "pad"),
  S("retribusi", "Retribusi daerah", pdp.retribusi, "pad"),
