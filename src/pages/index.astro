      id="5-1"
      pertanyaan="Seberapa tinggi nilai akhir penyelenggaraan keistimewaan?"
      tafsir={`Nilai akhir 2023 <strong>${d(nA.total, 2)}</strong>. Aspeknya: capaian fisik-keuangan ${d(nA.baris[0].nilai, 2)} (bobot ${d(nA.baris[0].bobot, 0)}%, berjalan ${d(nA.baris[0].hasil, 2)}), kepuasan masyarakat ${d(nA.baris[1].nilai, 2)}, dan kepuasan masyarakat (paramparapraja) ${d(nA.baris[2].nilai, 2)}.`}
      sumber={SB(800, 1, FK)}
    >
      <MeterRing
        caption="Nilai akhir kinerja penyelenggaraan keistimewaan DIY 2023"
        label="Nilai akhir kinerja keistimewaan"
        nilai={nA.total}
        besar={d(nA.total, 2)}
        sub={`rerata capaian ${d(nA.rerataCapaian, 2)}`}
        pembanding={100}
        pembandingLabel="garis pembanding: skor penuh"
      />
      <TabelAlt
        judul="rincian skor nilai akhir keistimewaan"
        kolom={[
          { judul: "Komponen" },
          { judul: "Nilai", num: true },
          { judul: "Bobot (%)", num: true },
          { judul: "Hasil", num: true },
        ]}
        baris={[
          ...nA.baris.map((b) => [b.nama, d(b.nilai, 2), d(b.bobot, 0), d(b.hasil, 2)]),
          ["TOTAL", "", "", d(nA.total, 2)],
        ]}
        gulir
      />
    </Adegan>

    <Adegan
      id="5-2"
      pertanyaan="Bagaimana urusan keistimewaan dijalankan?"
      tafsir={`Empat urusan keistimewaan (${urK.baris.map((b) => b.nama).join(", ")}) diperhitungkan bersama: realisasi keuangan <strong>${d(urK.total.keuangan, 2)}%</strong> dan realisasi fisik <strong>${d(urK.total.fisik, 2)}%</strong>. Panjang garis penghubung adalah selisih anggaran–realisasi tiap urusan; angkanya di tabel.`}
      sumber={SB(800, 2, FK)}
    >
      <DuaTitik
        caption="Anggaran dan realisasi urusan keistimewaan (rupiah)"
        label="Anggaran dan realisasi urusan keistimewaan"
        rows={duoKes}
        kiri="Anggaran"
        kanan="Realisasi"
        satuan="Rp"
        digit={0}
      />
      <TabelAlt
        judul="realisasi urusan keistimewaan"
        kolom={[
          { judul: "Urusan" },
          { judul: "Anggaran (Rp)", num: true },
          { judul: "Realisasi (Rp)", num: true },
          { judul: "% keuangan", num: true },
          { judul: "% fisik", num: true },
        ]}
        baris={[
          ...urK.baris.map((b) => [b.nama, pangkatRupiah(b.anggaran), pangkatRupiah(b.realisasi), d(b.keuangan, 2), d(b.fisik, 2)]),
          ["TOTAL", pangkatRupiah(urK.total.anggaran), pangkatRupiah(urK.total.realisasi), d(urK.total.keuangan, 2), d(urK.total.fisik, 2)],
        ]}
      />
    </Adegan>

    <Adegan
      id="5-3"
      pertanyaan="Bagaimana bantuan keuangan khusus diturunkan ke kalurahan?"
      tafsir={`BKK kalurahan dilaporkan baris demi baris: pagu <strong>${pangkatRupiah(bkk.jumlah.pagu)}</strong>, realisasi <strong>${pangkatRupiah(bkk.jumlah.realisasi)}</strong> — ${bkk.baris.length} jenis program seluruhnya keterangan fisik dan keuangannya <strong>${d(100, 0)}%</strong>. Selisih satu rupiah antara pembukuhan laporan dan penjumlahan baris dicatat pada penutup.`}
      sumber={[
        SB(739, 1, FB),
        SB(740, 1, FB),
      ]}
    >
      <HorizontalBar
        caption="Realisasi pagu BKK kalurahan menurut jenis (rupiah), diurut berdasarkan pagu"
        label="Realisasi BKK kalurahan per jenis program"
        rows={bkkRow}
        satuan="Rp"
        persen={true}
        penyebutLabel="% keuangan"
      />
      <TabelAlt
        judul="realisasi BKK kalurahan"
        kolom={[
          { judul: "Jenis" },
          { judul: "Pagu (Rp)", num: true },
          { judul: "Realisasi (Rp)", num: true },
          { judul: "% keuangan", num: true },
          { judul: "% fisik", num: true },
        ]}
        baris={bkk.baris.map((b) => [
          b.jenis,
          pangkatRupiah(b.pagu),
          b.realisasi === null ? null : pangkatRupiah(b.realisasi),
          b.keuangan === null ? null : d(b.keuangan, 2),
          b.fisik === null ? null : d(b.fisik, 2),
        ])}
        gulir
      />
    </Adegan>
  </Pilar>

  {/* ═════════════════════════ 6. Pilar enam ═════════════════════════ */}
  <Pilar no={6} id={i.pilar[5].id} judul={i.pilar[5].judul} bidang={i.pilar[5].bidang} lead={i.pilar[5].lead}>
    <Adegan
      id="6-1"
      pertanyaan="Bagaimana pengakuan bidang standar pelayanan minimum?"
      tafsir={`Enam bidang SPM menampilkan kategorinya: <strong>${paripurna.length}</strong> bidang berstatus PARIPURNA dengan indeks ${d(paripurna[0]?.indeks ?? 0, 0)}; Pendidikan berstatus UTAMA dengan indeks <strong>${d(kat[0].indeks, 2)}</strong> — satu-satunya bidang yang masih menuntaskan sisa kecil.`}
      sumber={SB("1046–1105", "kategori & indikator SPM per bidang", FB4)}
    >
      <HorizontalBar
        caption="Indeks SPM per bidang"
        label="Indeks SPM per bidang"
        rows={barKat.map((k) => ({ label: k.label, n: k.n }))}
        satuan=""
        persen={false}
        sorot="Pendidikan"
      />
      <TabelAlt
        judul="kategori dan indeks SPM per bidang"
        kolom={[
          { judul: "Bidang" },
          { judul: "Kategori" },
          { judul: "Indeks", num: true },
        ]}
        baris={kat.map((k) => [k.bidang, k.kategori, d(k.indeks, 2)])}
      />
    </Adegan>

    <Adegan
      id="6-2"
      pertanyaan="Di mana bidang pendidikan tertinggal dari targetnya?"
      tafsir={`Selisih capaian terhadap target untuk ${indSma.length} indikator jenjang SMA: terendah ${indSmaTerang.label} sebesar <strong>${d(indSmaTerang.delta, 2)} poin</strong> (${indSmaTerang.catatan}).${indSmaTembak > 0 ? ` ${indSmaTembak} indikator lain justru menembak target.` : ""} Rincian seluruh jenjang ada di tabel.`}
      sumber={[
        SB(1046, 1, FB4),
        SB(1047, 1, FB4),
      ]}
    >
      <BatangSelisih
        caption="Selisih capaian terhadap target, indikator SPM jenjang SMA (poin)"
        label="Selisih capaian terhadap target indikator SMA"
        rows={indSma}
        satuan="poin"
        digit={2}
      />
      <TabelAlt
        judul="selisih capaian terhadap target, indikator SPM"
        kolom={[
          { judul: "Jenjang" },
          { judul: "Indikator" },
          { judul: "Target", num: true },
          { judul: "Capaian", num: true },
          { judul: "Selisih", num: true },
        ]}
        baris={pInd.map((x) => [x.jenjang, x.label, d(x.target, 2), d(x.capaian, 2), d(x.capaian - x.target, 2)])}
        gulir
      />
    </Adegan>

    <Adegan
      id="6-3"
      pertanyaan="Berapa murid berkebutuhan khusus yang sudah terlayani?"
      tafsir={`Pendidikan khusus di DIY terlayani <strong>${n(khus.terlayani)}</strong> dari ${n(khus.harusDilayani)} murid (${d(khus.persen, 2)}%), meninggalkan ${n(khus.belumTerlayani)} murid yang belum terlayani. Indeks khusus ${d(khus.indeksKhusus, 2)}; indeks penerima layanan ${d(khus.indeksPenerimaLD, 2)}.`}
      sumber={SB(1047, 1, FB4)}
    >
      <StatCards
        judul="Pendidikan khusus dan proses layanannya"
        kartu={[
          { label: "Harus dilayani", nilai: n(khus.harusDilayani), sorot: true },
          { label: "Terlayani", nilai: n(khus.terlayani), sub: `${d(khus.persen, 2)}%` },
          { label: "Belum terlayani", nilai: n(khus.belumTerlayani), sub: `indeks khusus ${d(khus.indeksKhusus, 2)} · penerima LD ${d(khus.indeksPenerimaLD, 2)}` },
        ]}
      />
      <TabelAlt
        judul="pendidikan khusus"
        kolom={[
          { judul: "Uraian" },
          { judul: "Nilai", num: true },
        ]}
        baris={[
          ["Pendidik khusus yang harus dilayani", n(khus.harusDilayani)],
          ["Terlayani", n(khus.terlayani)],
          ["Belum terlayani", n(khus.belumTerlayani)],
          ["Persen terlayani", d(khus.persen, 2)],
          ["Indeks khusus", d(khus.indeksKhusus, 2)],
          ["Indeks penerima layanan", d(khus.indeksPenerimaLD, 2)],
        ]}
      />
    </Adegan>
  </Pilar>

  {/* ═════════════════════════ 7. Penutup ═════════════════════════ */}
  <section class="babak" id="penutup" aria-labelledby="penutup-judul">
    <div class="wrap">
      <div class="babak__label" aria-hidden="true">Penutup</div>
      <h2 id="penutup-judul">{i.penutup.judul}</h2>
      <hr class="rule-accent" />
      <p class="babak__lead">{i.penutup.lead}</p>

      <Adegan
        id="7-1"
        pertanyaan="Apa catatan celah data yang sudah direkam?"
        tafsir={`Pipeline menjumlahkan ${celah.length} catatan celah — pembulatan antartabel, sel yang tak terbaca mesin, koreksi yang dicatat laporan, dan angka yang maknanya bukan persen. Catatan ini justru yang membuat halaman tetap tahu apa yang dibicarakannya: pembaca tahu tepat data mana yang sebaiknya tidak dijadikan dasar kesimpulan.`}
        sumberTeks="Manifes catatan celah dihasilkan pipeline build_data.mjs dari pemeriksaan aritmetika dan pembacaan tabel LPPD DIY 2023 (bab 1–4)."
      >
        <ul class="daftar-celah" role="list">
          {
            celah.map((c) => (
              <li data-anim="pudar">{c}</li>
            ))
          }
        </ul>
      </Adegan>

      <Adegan
        id="7-2"
        pertanyaan="Bagaimana mengunduh dan memeriksa angka-angkanya?"
        tafsir={`${unduhan.length} berkas CSV terbuka tanpa login, berisi tabel-tabel yang sudah melewati pemeriksaan aritmetika otomatis; setiap unduhan menunjuk kembali halaman dan tabel sumbernya. Formatnya CSV standar, siap dibuka di aplikasi lembar kerja apa pun.`}
        sumberTeks="Unduhan dihasilkan pipeline dari tabel LPPD DIY 2023 (bab 1–4); berkas disajikan format CSV standar."
      >
        <ul class="unduhan" role="list">
          {
            unduhan.map((u) => (
              <li>
                <a href={`./data/${u.berkas}`} download>
                  <b>{u.berkas}</b>
                  <span>{u.tentang}</span>
                  <small>{u.sumber}</small>
                </a>
              </li>
            ))
          }
        </ul>
      </Adegan>

      <p class="kolofon">{i.penutup.kolofonLead}</p>
    </div>
  </section>
</Layout>

<style>
  .daftar-celah {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }
  .daftar-celah li {
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    padding: var(--space-4) var(--space-5);
    font-size: var(--size-body-sm);
    color: var(--text-body);
  }
  .daftar-celah li::before {
    content: "○";
    color: var(--accent);
    margin-inline-end: var(--space-3);
    font-weight: var(--fw-bold);
  }
  .unduhan {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-3);
  }
  .unduhan a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    text-decoration: none;
    color: var(--text-body);
    height: 100%;
  }
  .unduhan a:hover {
    border-color: var(--accent);
  }
  .unduhan b {
    font-family: var(--font-mono);
    font-size: var(--size-body-sm);
    color: var(--text-strong);
    word-break: break-word;
  }
  .unduhan span {
    font-size: var(--size-body-sm);
  }
  .unduhan small {
    color: var(--text-muted);
    font-size: var(--size-micro);
  }
  .kolofon {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-hairline);
    color: var(--text-muted);
    font-size: var(--size-body-sm);
    max-width: 74ch;
  }
</style>
