/**
 * Satu halaman berurutan: sampul, ringkasan, enam bab, penutup, Matur Nuwun.
 *
 * Seluruh angka disusun dari src/lib/data.ts (JSON turunan pipeline). Tidak
 * ada angka hasil pengukuran yang diketik manual; kalimat yang memuat angka
 * disusun dengan templat sehingga tetap benar bila data diperbarui.
 *
 * Setiap adegan: satu pertanyaan → satu atau dua visual → tabel angka →
 * tafsir → penunjuk sumber (halaman + tabel LPPD).
 */
import Layout from "../layouts/Cerita.astro";
import Bab from "../components/Bab.astro";
import Adegan from "../components/Adegan.astro";
import Figur from "../components/Figur.astro";
import TabelAlt from "../components/TabelAlt.astro";
import Angka from "../components/charts/Angka.astro";
import BarH from "../components/charts/BarH.astro";
import BulletH from "../components/charts/BulletH.astro";
import Kupu from "../components/charts/Kupu.astro";
import UnitTitik from "../components/charts/UnitTitik.astro";
import Kolom from "../components/charts/Kolom.astro";
import Tumpuk from "../components/charts/Tumpuk.astro";
import Treemap from "../components/charts/Treemap.astro";
import DotSerapan from "../components/charts/DotSerapan.astro";
import MultiKecil from "../components/charts/MultiKecil.astro";
import Garis from "../components/charts/Garis.astro";
import Cincin from "../components/charts/Cincin.astro";
