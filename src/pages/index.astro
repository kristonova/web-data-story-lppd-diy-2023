    sub: b.realisasi !== null ? `Realisasi ${rpS(b.realisasi)}${b.keuangan !== null ? ` (${p(b.keuangan, 2)})` : ""}` : undefined,
  };
});
const bkkTigaBesar = jumlah(bkkUrut.slice(0, 3).map((b) => b.pagu));

// Warisan budaya
const cagar = W.cagarBudaya;
const cagarUrut = [...cagar.baris].sort((a, b) => b.jumlah - a.jumlah);
const WARNA_CAGAR = ["#d82128", "#811c1d", "#b08a3e", "#ac6249", "#184531"];

// ══ Bab 6: layanan dasar ════════════════════════════════════════════════════
const ikkP = pilar4.ikkPendidikan;
const ikkH = pilar4.ikkKesehatan;
const ikkU = pilar4.ikkPU;
const abkBelum = ikkP.abk.total - ikkP.abk.terlayani;

// Air minum dan sanitasi per kabupaten/kota
const air = (k: string) => W.airMinum.nilai[k]!;
const san = (k: string) => W.sanitasi.nilai[k]!;
const rtKab = (k: string) => jumlah(air(k));
const airTot = [0, 1, 2].map((j) => jumlah(KODE.map((k) => air(k)[j]!)));
const rtDIY = jumlah(airTot);
const aksesAirPct = (100 * (airTot[0]! + airTot[1]!)) / rtDIY;
const pipaPct = (100 * airTot[0]!) / rtDIY;
const belumTop = maks(KODE, (k) => air(k)[2]!);
const tanpaBelum = KODE.filter((k) => air(k)[2] === 0).map(namaK);
const pipaTop = maks(KODE, (k) => (air(k)[0]!) / rtKab(k));
const pipaLow = mins(KODE, (k) => (air(k)[0]!) / rtKab(k));
const sanDIY = san("DIY");
const sanLayakPct = (100 * (sanDIY[2]! + sanDIY[3]! + sanDIY[4]!)) / sanDIY[5]!;
const sanAmanPct = (100 * sanDIY[4]!) / sanDIY[5]!;
const tanpaBabs = KODE.every((k) => san(k)[0] === 0);
const amanTop = maks(KODE, (k) => (san(k)[4]!) / san(k)[5]!);
const amanLow = mins(KODE, (k) => (san(k)[4]!) / san(k)[5]!);
const KAT_AIR = [
  { label: "Perpipaan", warna: "#045b87" },
  { label: "Bukan perpipaan", warna: "#62a2c6" },
  { label: "Belum ada akses", warna: "#d82128" },
];
const rowsAir = [...KODE]
  .sort((a, b) => (air(b)[2]!) / rtKab(b) - (air(a)[2]!) / rtKab(a))
  .map((k) => ({
    label: namaK(k),
    n: air(k),
    tampil: air(k).map((v) => `${n(v)} rumah tangga`),
    porsi: air(k).map((v) => p((100 * v) / rtKab(k), 2)),
    ringkas: `${p((100 * (air(k)[0]! + air(k)[1]!)) / rtKab(k), 2)} berakses`,
    sub: air(k)[2] ? `${n(air(k)[2]!)} rumah tangga belum` : "seluruh rumah tangga berakses",
    sorot: k === belumTop,
  }));
const rowsSanitasi = [...KODE]
  .sort((a, b) => (san(b)[4]!) / san(b)[5]! - (san(a)[4]!) / san(a)[5]!)
  .map((k) => ({
    label: namaK(k),
    ruas: [
      { label: "Aman", n: san(k)[4]!, tampil: p((100 * san(k)[4]!) / san(k)[5]!, 1), warna: "#184531" },
      { label: "Layak, individu", n: san(k)[2]!, tampil: p((100 * san(k)[2]!) / san(k)[5]!, 1), warna: "#73a888", teks: "var(--ink)" },
      { label: "Layak, bersama", n: san(k)[3]!, tampil: p((100 * san(k)[3]!) / san(k)[5]!, 1), warna: "#bcd8c0", teks: "var(--ink)" },
      { label: "Belum layak", n: san(k)[1]!, tampil: p((100 * san(k)[1]!) / san(k)[5]!, 1), warna: "#d82128" },
    ],
  }));

// SPM
const spmKat = pilar6.kategori;
const paripurna = spmKat.filter((k) => k.kategori === "PARIPURNA");
const nonParipurna = spmKat.filter((k) => k.kategori !== "PARIPURNA");
const pInd = pilar6.pendidikanIndikator;
const jenjang = [...new Set(pInd.map((x) => x.jenjang))];
const kelompokSpm = jenjang.map((j) => {
  const rows = pInd.filter((x) => x.jenjang === j);
  const belum = rows.filter((x) => x.pct < 100).length;
  return {
    judul: j,
    ringkas: `${belum} dari ${rows.length} indikator belum mencapai target`,
    rows: rows.map((x) => ({
      label: x.label,
      persen: x.pct,
      tampil: p(x.pct, 2),
      rinci: `Capaian ${d(x.capaian, 2)} · target ${d(x.target, 2)}${x.satuan === "%" ? "%" : ""}`,
    })),
  };
});
const indBelum = pInd.filter((x) => x.pct < 100);
const indTerendah = mins(pInd, (x) => x.pct);
const labelBelumSmaSmk = [...new Set(indBelum.filter((x) => x !== indTerendah && x.jenjang !== indTerendah.jenjang).map((x) => x.label.toLowerCase()))];
const khus = pilar6.pendidikanKhusus;

// ══ Penutup ═════════════════════════════════════════════════════════════════
const unduhan = manifes.unduhan;
const celah = manifes.catatanCelah;

const nav = [
  { href: "#ringkasan", label: "Ringkasan" },
  ...i.bab.map((b) => ({ href: `#${b.id}`, label: b.nav })),
  { href: "#penutup", label: "Penutup" },
];
const leadBab = [
  `Sebagai salah satu provinsi dengan luas daratan paling kompak di Indonesia, DIY mengelola ruang yang dinamis. Bab ini memetakan perbandingan luas wilayah, konsentrasi sebaran warga, serta profil struktur demografi di setiap kabupaten/kota.`,
  `Kemandirian fiskal daerah ditopang oleh optimalisasi PAD dan alokasi transfer pemerintah pusat. Bab ini membedah postur aliran pendapatan, realisasi belanja operasional dan modal, hingga efektivitas serapan anggaran di setiap urusan.`,
  `Kemajuan pembangunan manusia terus meningkat, meski tantangan disparitas antardaerah masih nyata. Akselerasi kesejahteraan melaju pesat di kawasan perkotaan, sementara pengentasan kemiskinan dan pemerataan terus didorong di seluruh penjuru wilayah.`,
  `Setelah melewati tekanan pandemi pada 2020, perekonomian DIY bangkit kembali ke jalur pertumbuhan positif. Dinamika pemulihan tercermin pada geliat lapangan usaha unggulan, lonjakan arus investasi, serta geliat industri perhotelan dan pariwisata.`,
  `Penyelenggaraan urusan keistimewaan DIY mewujud dalam pelestarian budaya, penataan ruang, kelembagaan, dan pengelolaan pertanahan. Tahun 2023 menjadi tonggak bersejarah dengan penetapan Sumbu Filosofi sebagai Warisan Budaya Dunia oleh UNESCO, didukung pemerataan manfaat Dana Keistimewaan hingga ke tingkat kalurahan.`,
  `Pemerintah daerah berkomitmen menjamin hak-hak mendasar masyarakat melalui pemenuhan Standar Pelayanan Minimal (SPM). Evaluasi kinerja menunjukkan ${kata(paripurna.length)} bidang SPM telah tuntas paripurna, diiringi peningkatan mutu pendidikan inklusi, infrastruktur dasar, serta perluasan akses air bersih dan sanitasi.`,
];
---

<Layout judul={i.judul} deskripsi={i.deskripsi} nav={nav}>
  <PetaDefs />

  {/* ═════════════════════════ Sampul ═════════════════════════ */}
  <header class="sampul" id="sampul">
    <p class="sampul__label" data-sampul style="--i:0">{i.sampul.label}</p>
    <h1 data-sampul style="--i:1">{i.sampul.judul}</h1>
    <p class="sampul__sub" data-sampul style="--i:2">{i.sampul.sub}</p>
    <p class="sampul__meta" data-sampul style="--i:3">{i.sampul.meta}</p>
    <img class="deret" src="./brand/deret-ikon-emas.svg" alt="" width="842" height="141" />
  </header>

  {/* ═════════════════════════ Ringkasan ═════════════════════════ */}
  <section class="ringkasan" id="ringkasan" aria-labelledby="ringkasan-judul">
    <div class="wrap">
      <section id="adegan-0-1" aria-labelledby="ringkasan-judul">
        <header class="jb" data-reveal>
          <span class="jb__no">{i.ringkasan.label}</span>
          <h2 class="jb__teks" id="ringkasan-judul">{i.ringkasan.judul}</h2>
          <div class="jb__garis" aria-hidden="true"></div>
        </header>
        <p class="ringkasan__lead" data-reveal set:html={leadRingkasan} />
        <Angka items={kpi} label="Enam indikator makro DIY 2023" />
        <div data-reveal>
          <TabelAlt
            judul="enam indikator makro"
            keterangan="Enam indikator makro DIY, nilai 2022 dan 2023, beserta persentase perubahannya"
            kolom={[{ judul: "Indikator" }, { judul: "Satuan" }, { judul: "2022", num: true }, { judul: "2023", num: true }, { judul: "Perubahan (%)", num: true }]}
            baris={md.map((x) => [
              x.nama,
              x.satuan,
              x.jenis === "gini" ? d(x.nilai2022, 3) : d(x.nilai2022, 2),
              x.jenis === "gini" ? d(x.nilai2023, 3) : d(x.nilai2023, 2),
              d(x.perubahan, 2),
            ])}
          />
          <p class="sumber"><b>Sumber</b> {prov(SB(188, 2, FM))}</p>
          <p class="ringkasan__catatan">{i.ringkasan.catatan}</p>
        </div>
      </section>

      <nav class="isi-laporan" aria-labelledby="isi-judul" data-reveal>
        <h2 class="isi-laporan__judul" id="isi-judul">{i.ringkasan.isiJudul}</h2>
        <ol>
          {
            i.bab.map((b, j) => (
              <li>
                <a href={`#${b.id}`}>
                  <img src={`./brand/${b.ikon}.svg`} alt="" width="72" height="72" loading="lazy" />
                  <span class="isi-laporan__no">Bab {j + 1}</span>
                  <span class="isi-laporan__nama">{b.judul}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  {/* ═════════════════════════ Bab 1 ═════════════════════════ */}
  <Bab no={1} id={i.bab[0]!.id} judul={i.bab[0]!.judul} sub={i.bab[0]!.sub} lead={leadBab[0]!} ikon={i.bab[0]!.ikon} ikonNama={i.bab[0]!.ikonNama}>
    <Adegan
      id="1-1"
      lebar
      judul="Peta Sebaran Wilayah"
      pertanyaan="Bagaimana perbandingan luas wilayah dan sebaran konsentrasi penduduk di DIY?"
      tafsir={`Total luas daratan DIY tercatat sebesar <strong>${d(luas.total, 2)} km²</strong> atau sekitar ${p(luas.persenIndonesia, 2)} dari luas daratan Indonesia. ${kabTerluas.nama} merupakan daerah terluas yang mencakup <strong>${p(kabTerluas.luasPct, 2)}</strong> wilayah provinsi, namun hanya dihuni ${p(kabTerluas.jiwaPct, 2)} penduduk. Sebaliknya, ${kabTerpadat.nama} hanya menempati ${p(kabTerpadat.luasPct, 2)} area namun menampung ${p(kabTerpadat.jiwaPct, 2)} penduduk, dengan kepadatan tertinggi mencapai <strong>${n(kabTerpadat.padat)} jiwa/km²</strong>—atau lebih dari ${kaliPadat} kali lipat kepadatan di ${kabTerluas.nama}. Pilih lapisan peta untuk membandingkan aspek luas, jumlah penduduk, dan kepadatan.`}
      sumber={[SB(27, "naskah geografi wilayah", F1), SB(30, 1, F1)]}
      sumberLain={[SUMBER_PETA]}
    >
      <Figur judul="Peta luas, penduduk, dan kepadatan" satuan="per kabupaten/kota; garis tipis: batas kapanewon">
        <Peta label="Peta DIY per kabupaten/kota: luas daratan, penduduk, dan kepadatan" lapis={lapisWilayah} kapanewon panel judulPilih="Pilih ukuran yang dipetakan" />
        <TabelAlt
          slot="tabel"
          judul="luas, penduduk, dan kepadatan per kabupaten/kota"
          kolom={[
            { judul: "Kabupaten/kota" },
            { judul: "Luas (km²)", num: true },
            { judul: "% luas", num: true },
            { judul: "Laki-laki", num: true },
            { judul: "Perempuan", num: true },
            { judul: "Penduduk", num: true },
            { judul: "% penduduk", num: true },
            { judul: "Jiwa/km²", num: true },
          ]}
          baris={[
            ...kabLuas.map((k) => [k.nama, d(k.km2, 2), d(k.luasPct, 2), n(k.laki), n(k.perempuan), n(k.jiwa), d(k.jiwaPct, 2), n(k.padat)]),
            ["DIY", d(luas.total, 2), "100", n(pdk.laki), n(pdk.perempuan), n(pdk.total), "100", n(padatDIY)],
          ]}
        />
      </Figur>
    </Adegan>

    <Adegan
      id="1-2"
      judul="Pembagian Administratif"
      pertanyaan="Bagaimana struktur administrasi pemerintahan daerah dan persebaran warganya?"
      tafsir={`Jumlah penduduk DIY mencapai <strong>${n(pdk.total)} jiwa</strong> dengan proporsi perempuan sebesar ${p(pdk.perempuanPersen, 1)}. ${kabTerramai.nama} menjadi wilayah berpenduduk terbanyak dengan menampung ${p(kabTerramai.jiwaPct, 2)} total warga. Struktur pemerintahan daerah ditopang oleh <strong>${n(adm.kapanewon)}</strong> kapanewon dan kemantren, <strong>${n(adm.kalurahan)}</strong> kalurahan, serta <strong>${n(adm.kelurahan)}</strong> kelurahan. ${kabDesaTerbanyak.nama} membawahi unit administratif terbanyak, yaitu ${n(kabDesaTerbanyak.kap)} kapanewon dan ${n(kabDesaTerbanyak.kal)} kalurahan. Arahkan kursor pada peta untuk melihat rincian setiap kapanewon.`}
      sumber={[SB(30, 1, F1), SB(31, 4, F1)]}
      sumberLain={[SUMBER_PETA]}
    >
      <Figur judul="Peta kapanewon dan kemantren" satuan="warna mengikuti kabupaten/kota">
        <Peta label="Peta kapanewon dan kemantren DIY menurut kabupaten/kota" mode="kategori" catatanKab={catatanAdm} />
        <TabelAlt
          slot="tabel"
          judul="wilayah administrasi per kabupaten/kota"
          kolom={[{ judul: "Kabupaten/kota" }, { judul: "Kapanewon/kemantren", num: true }, { judul: "Kalurahan", num: true }, { judul: "Kelurahan", num: true }]}
          baris={[...kabDesa.map((k) => [k.nama, n(k.kap), k.kal ? n(k.kal) : null, k.kel ? n(k.kel) : null]), ["DIY", n(adm.kapanewon), n(adm.kalurahan), n(adm.kelurahan)]]}
        />
      </Figur>
      <Figur
        judul="Kalurahan dan kelurahan"
        satuan="satu titik = satu kalurahan atau kelurahan"
        legenda={[{ label: "Kalurahan", warna: "#b08a3e" }, { label: "Kelurahan", warna: C.sorot }]}
      >
        <UnitTitik
          label="Jumlah kalurahan dan kelurahan per kabupaten/kota"
          rows={kabDesa.map((k) => ({
            label: k.nama,
            ringkas: `${n(k.kal + k.kel)} wilayah`,
            sub: `${n(k.kap)} ${/Kota/.test(k.nama) ? "kemantren" : "kapanewon"}`,
            jenis: [
              { n: k.kal, label: "kalurahan", warna: "#b08a3e" },
              { n: k.kel, label: "kelurahan", warna: C.sorot },
            ],
          }))}
        />
        <TabelAlt
          slot="tabel"
          judul="penduduk per kabupaten/kota menurut jenis kelamin"
          kolom={[{ judul: "Kabupaten/kota" }, { judul: "Laki-laki", num: true }, { judul: "Perempuan", num: true }, { judul: "Jumlah", num: true }, { judul: "% DIY", num: true }]}
          baris={[...kabRamai.map((k) => [k.nama, n(k.laki), n(k.perempuan), n(k.jiwa), d(k.jiwaPct, 2)]), ["DIY", n(pdk.laki), n(pdk.perempuan), n(pdk.total), "100"]]}
        />
      </Figur>
    </Adegan>

    <Adegan
      id="1-3"
      judul="Struktur Usia Penduduk"
      pertanyaan="Bagaimana komposisi kelompok usia penduduk dan wilayah mana yang memiliki proporsi lansia tertinggi?"
      tafsir={`Karakteristik demografi DIY memperlihatkan tren penuaan penduduk, di mana sekitar satu dari ${kata(satuDari)} warga telah berusia ${labelUsia(ikLansia.nama).replace("+", "")} tahun ke atas (<strong>${p(ikLansia.persen, 1)}</strong>)—hampir sebanding dengan kelompok usia anak ${labelUsia(ikAnak.nama)} tahun (${p(ikAnak.persen, 1)}). Rasio ketergantungan berada di angka <strong>${d(rasioTanggungan, 0)}</strong>, yang berarti setiap 100 penduduk usia produktif menanggung sekitar ${d(rasioTanggungan, 0)} penduduk nonproduktif. ${namaK(kabTertua.kode)} memiliki proporsi lansia tertinggi mencapai <strong>${p(kabTertua.persen, 1)}</strong>, sedangkan ${namaK(kabTermuda.kode)} mencatatkan struktur demografi paling muda dengan proporsi lansia sebesar ${p(kabTermuda.persen, 1)}.`}
      sumber={[SB(30, 2, F1), SB(31, 1, F1)]}
    >
      <Figur
        judul="Komposisi umur penduduk DIY"
        satuan="persen penduduk"
        legenda={[
          { label: `Anak ${labelUsia(ikAnak.nama)} tahun`, warna: "#f0dfae" },
          { label: `Usia produktif ${labelUsia(ikProd.nama)} tahun`, warna: "#b08a3e" },
          { label: `Lansia ${labelUsia(ikLansia.nama)} tahun`, warna: C.sorot },
        ]}
      >
        <Tumpuk
          label="Komposisi penduduk menurut kelompok umur besar"
          lebarLabel="0rem"
          tebal={44}
          rows={[
            {
              label: "",
              ruas: [
                { label: `Anak ${labelUsia(ikAnak.nama)} tahun`, n: ikAnak.persen, tampil: p(ikAnak.persen, 1), warna: "#f0dfae", teks: "var(--ink)" },
                { label: `Produktif ${labelUsia(ikProd.nama)} tahun`, n: ikProd.persen, tampil: p(ikProd.persen, 1), warna: "#b08a3e" },
                { label: `Lansia ${labelUsia(ikLansia.nama)} tahun`, n: ikLansia.persen, tampil: p(ikLansia.persen, 1), warna: C.sorot },
              ],
            },
          ]}
        />
      </Figur>
      <Figur judul="Sebaran umur per kabupaten/kota" satuan="persen penduduk wilayahnya per kelompok umur lima tahunan">
        <Punggung label="Sebaran umur penduduk per kabupaten/kota" x={labelX} rows={rowsPunggung} awalLansia={iLansia} />
        <TabelAlt
          slot="tabel"
          judul="penduduk menurut kelompok umur dan kabupaten/kota"
          kolom={[{ judul: "Kelompok umur" }, ...URUT_USIA.map((k) => ({ judul: namaK(k), num: true })), { judul: "DIY", num: true }, { judul: "% DIY", num: true }]}
          baris={[...usia.map((g) => [g.label, ...g.perKab.map((v) => n(v)), n(g.jumlah), d(g.persen, 2)]), ...ikhtisar.map((x) => [x.nama, null, null, null, null, null, n(x.jumlah), d(x.persen, 1)])]}
        />
      </Figur>
    </Adegan>
  </Bab>

  {/* ═════════════════════════ Bab 2 ═════════════════════════ */}
  <Bab no={2} id={i.bab[1]!.id} judul={i.bab[1]!.judul} sub={i.bab[1]!.sub} lead={leadBab[1]!} ikon={i.bab[1]!.ikon} ikonNama={i.bab[1]!.ikonNama}>
    <Adegan
      id="2-1"
      lebar
      judul="Arus Keuangan Daerah"
      pertanyaan="Bagaimana sumber pendapatan daerah dihimpun dan dialokasikan ke pos belanja?"
      tafsir={`Total kapasitas fiskal daerah sepanjang 2023 mencapai <strong>${rp(danaTersedia)}</strong>, bersumber dari realisasi pendapatan daerah sebesar ${rp(pdp.total.realisasi)} (${p(pdp.total.persen, 2)} dari target, ${arahKata(tumbuhPendapatan)} ${p(Math.abs(tumbuhPendapatan), 2)} dibandingkan 2022) serta pembiayaan netto ${rp(bln.pembiayaanNetto.realisasi)}. Pendapatan Asli Daerah (PAD) menyumbang <strong>${p(pdp.sharePad, 2)}</strong> dari total pendapatan dengan pajak daerah sebagai penopang utama (${p(sharePajak, 1)}), sementara dana transfer pusat tetap menjadi porsi terbesar mencapai <strong>${p(shareTransferPusat, 2)}</strong>. Pada sisi belanja, porsi terbesar dialokasikan untuk belanja operasi (${p(shareDana(bln.operasi.realisasi), 1)}), disusul belanja transfer (${p(shareDana(bln.transfer.realisasi), 1)}), belanja modal (${p(shareDana(bln.modal.realisasi), 1)}), serta menyisakan SiLPA sebesar ${rp(bln.slpa.realisasi)}.`}
      sumber={[SB(60, 1, F1), SB(61, 1, F1), SB(62, 1, F1), SB(63, 1, F1)]}
    >
      <Figur judul="Arus anggaran pendapatan dan belanja 2023" satuan="realisasi; lebar pita sebanding nilai">
        <Arus
          label="Arus APBD DIY 2023 dari sumber pendapatan ke jenis belanja"
          kiri={arusKiri}
          kanan={arusKanan}
          grupKiri={grupKiri}
          grupKanan={grupKanan}
          tengah={{ label: "Dana tersedia 2023", tampil: rpS(danaTersedia) }}
          porsi={(v) => p(shareDana(v), 1)}
        />
        <TabelAlt
          slot="tabel"
          judul="anggaran dan realisasi pendapatan"
          kolom={[{ judul: "Komponen" }, { judul: "Anggaran (Rp)", num: true }, { judul: "Realisasi (Rp)", num: true }, { judul: "%", num: true }, { judul: "Realisasi 2022 (Rp)", num: true }]}
          baris={[
            ...([
              ["Pendapatan asli daerah", pdp.pad],
              ["Pajak daerah", pdp.pajak],
