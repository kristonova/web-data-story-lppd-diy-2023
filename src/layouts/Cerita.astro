---
/**
 * Tata letak halaman. Satu rute, satu tata letak, identitas Jogja Istimewa.
 *
 * JavaScript di halaman ini hanya mengerjakan enam hal: kepala halaman yang
 * memadat saat sampul lewat, penanda bab aktif, progres baca, gerak saat
 * gulir (blok muncul, grafik tergambar, angka menghitung naik), pendaftaran
 * service worker, dan lapisan interaksi grafik (components/InteraksiGrafik).
 * Seluruh isi tetap terbaca ketika JavaScript dimatikan.
 */
import InteraksiGrafik from "../components/InteraksiGrafik.astro";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/print.css";

interface Props {
  judul: string;
  deskripsi: string;
  nav: { href: string; label: string; penting?: boolean }[];
}

const { judul, deskripsi, nav } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{judul}</title>
    <meta name="description" content={deskripsi} />
    <meta name="theme-color" content="#d82128" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="./brand/ikon-tugu.svg" type="image/svg+xml" />

    {/* Huruf dimuat dari public/fonts/ lewat @font-face. Tanpa preload huruf: preload
        bertanda crossorigin ditolak peramban bila halaman dibuka dari USB (file:). */}
    <link rel="preload" href="./brand/latar-sampul.jpg" as="image" />

    <script is:inline>
      document.documentElement.classList.add("js");
      // Bila skrip gerak di akhir halaman gagal sebelum memasang .gerak-hidup,
      // kelas .js dilepas lagi supaya tidak ada isi yang tertahan tersembunyi.
      document.addEventListener("DOMContentLoaded", function () {
        var h = document.documentElement;
        if (!h.classList.contains("gerak-hidup")) h.classList.remove("js");
      });
    </script>
  </head>

  <body>
    <a class="lewati" href="#ringkasan">Lompat ke isi</a>

    <header class="kepala" id="kepala">
      <a class="kepala__logo" href="#sampul" aria-label="Kembali ke sampul">
        <img class="logo-putih" src="./brand/jogja-istimewa-putih.svg" alt="" width="96" height="38" />
        <img class="logo-merah" src="./brand/jogja-istimewa-merah.svg" alt="" width="96" height="38" />
      </a>
      <span class="kepala__judul">LPPD DIY 2023</span>
      <nav class="kepala__nav" aria-label="Bab laporan">
        {nav.map((it) => <a href={it.href} class={it.penting ? "penting" : undefined}>{it.label}</a>)}
      </nav>
      <button class="tombol" id="tombol-cetak" type="button">Cetak</button>
      <div class="kemajuan" id="kemajuan" aria-hidden="true"></div>
    </header>

    <InteraksiGrafik />

    <main>
      <slot />
    </main>

    <script is:inline>
      (function () {
        var akar = document.documentElement;
        var halus = matchMedia("(prefers-reduced-motion: reduce)").matches;

        var cetak = document.getElementById("tombol-cetak");
        if (cetak) cetak.addEventListener("click", function () { window.print(); });

        // ── Kepala memadat sesudah sampul, progres baca ──────────────────
        var kepala = document.getElementById("kepala");
        var kemajuan = document.getElementById("kemajuan");
        var sampul = document.getElementById("sampul");
        var tik = false;
        function gambar() {
          tik = false;
          var y = window.scrollY || akar.scrollTop;
          var batas = sampul ? sampul.offsetHeight - 72 : 40;
          if (kepala) kepala.classList.toggle("is-padat", y > batas);
          var maks = akar.scrollHeight - akar.clientHeight;
          if (kemajuan) kemajuan.style.transform = "scaleX(" + (maks > 0 ? Math.min(1, y / maks) : 0) + ")";
        }
        addEventListener("scroll", function () {
          if (!tik) { tik = true; requestAnimationFrame(gambar); }
        }, { passive: true });
        addEventListener("resize", gambar, { passive: true });
        gambar();

        // ── Penanda bab aktif di navigasi ─────────────────────────────────
        var tautan = Array.prototype.slice.call(document.querySelectorAll(".kepala__nav a"));
        var bab = tautan.map(function (a) { return document.querySelector(a.getAttribute("href")); });
        if ("IntersectionObserver" in window) {
          var pengamatBab = new IntersectionObserver(function (entri) {
            entri.forEach(function (e) {
              if (!e.isIntersecting) return;
              var i = bab.indexOf(e.target);
              tautan.forEach(function (a, j) {
                if (j === i) a.setAttribute("aria-current", "true");
                else a.removeAttribute("aria-current");
              });
            });
          }, { rootMargin: "-45% 0px -50% 0px" });
          bab.forEach(function (b) { if (b) pengamatBab.observe(b); });
        }

        // ── Gerak saat gulir ──────────────────────────────────────────────
        var blok = document.querySelectorAll("[data-reveal]");
        var JENJANG = 110;

        // Tanda dalam satu wadah bergerak berjenjang, total paling lama ~700ms.
        var LANGKAH = { titik: 45, pudar: 30, naik: 70, x: 55, y: 35, busur: 160, sapu: 0 };
        function jenjangTanda(akarBlok) {
          var peta = new Map();
          akarBlok.querySelectorAll("[data-anim]").forEach(function (el) {
            var wadah = el.closest("[data-anim-grup], [data-viz], svg") || akarBlok;
            var jenis = el.getAttribute("data-anim");
            var perJenis = peta.get(wadah);
            if (!perJenis) peta.set(wadah, (perJenis = {}));
            (perJenis[jenis] = perJenis[jenis] || []).push(el);
          });
          peta.forEach(function (perJenis) {
            Object.keys(perJenis).forEach(function (jenis) {
              var isi = perJenis[jenis];
              var dasar = LANGKAH[jenis] === undefined ? 50 : LANGKAH[jenis];
              var langkah = Math.min(dasar, 700 / isi.length);
              isi.forEach(function (el, i) {
                if (!el.style.getPropertyValue("--tunda-k")) {
                  el.style.setProperty("--tunda-k", Math.round(i * langkah) + "ms");
                }
              });
            });
          });
        }

        // Angka bertanda data-count menghitung naik. Teks akhirnya dikembalikan
        // persis seperti yang ditulis server, jadi pemformatan tidak menyimpang.
        function hitungNaik(akarBlok, tunda) {
          if (halus) return;
          akarBlok.querySelectorAll("[data-count]").forEach(function (el) {
            var target = parseFloat(el.getAttribute("data-count"));
            if (!(target > 0)) return;
            var digit = parseInt(el.getAttribute("data-desimal") || "0", 10);
            var fmt = new Intl.NumberFormat("id-ID", {
              minimumFractionDigits: digit,
              maximumFractionDigits: digit,
            });
            var akhirTeks = el.textContent;
            var durasi = 1600;
            el.style.display = "inline-block";
            el.style.minWidth = el.getBoundingClientRect().width + "px";
            el.textContent = fmt.format(0);
            setTimeout(function () {
              var mulai = null;
              function langkah(ts) {
                if (mulai === null) mulai = ts;
                var t = Math.min((ts - mulai) / durasi, 1);
                var ease = 1 - Math.pow(1 - t, 4);
                el.textContent = t === 1 ? akhirTeks : fmt.format(ease * target);
                if (t < 1) requestAnimationFrame(langkah);
                else el.style.minWidth = "";
              }
              requestAnimationFrame(langkah);
            }, tunda + 250);
          });
        }

        function tampil(el, tunda) {
          if (el.classList.contains("is-in")) return;
          tunda += parseInt(el.getAttribute("data-tunda") || "0", 10);
          el.style.setProperty("--blok-tunda", tunda + "ms");
          jenjangTanda(el);
          hitungNaik(el, tunda);
          el.classList.add("is-in");
        }
        function tampilSemua() {
          blok.forEach(function (el) { tampil(el, 0); });
        }
        addEventListener("beforeprint", function () {
          tampilSemua();
          document.querySelectorAll("details.tabel-alt").forEach(function (d) { d.open = true; });
        });

        if (halus || !("IntersectionObserver" in window)) {
          tampilSemua();
        } else {
          var menyala = false;
          var io = new IntersectionObserver(function (entri) {
            menyala = true;
            var urut = 0;
            entri.forEach(function (e) {
              if (!e.isIntersecting) return;
              tampil(e.target, Math.min(urut++, 5) * JENJANG);
              io.unobserve(e.target);
            });
          }, { rootMargin: "0px 0px -12% 0px", threshold: 0 });
          blok.forEach(function (el) { io.observe(el); });

          // Jaring pengaman untuk pengamat yang tidak pernah menyala.
          function jaga() {
            setTimeout(function () { if (!menyala) tampilSemua(); }, 2500);
          }
          if (document.visibilityState === "hidden") {
            document.addEventListener("visibilitychange", function tunggu() {
              if (document.visibilityState === "hidden") return;
              document.removeEventListener("visibilitychange", tunggu);
              jaga();
            });
          } else {
            jaga();
          }
        }
        akar.classList.add("gerak-hidup");

        // Service worker: setelah satu kali dibuka, halaman terbuka penuh
        // tanpa jaringan. Dilewati bila dibuka langsung dari USB (file:).
        if ("serviceWorker" in navigator && location.protocol.indexOf("http") === 0) {
          addEventListener("load", function () {
            navigator.serviceWorker.register("./sw.js", { scope: "./" }).catch(function () {});
          });
        }
      })();
    </script>
  </body>
</html>
