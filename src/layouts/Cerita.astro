---
/**
 * Tata letak halaman. Satu rute, satu tata letak.
 *
 * JavaScript di halaman ini hanya mengerjakan lima hal: sakelar tema, progres
 * baca, gerak saat gulir (blok muncul, grafik digambar, angka menghitung
 * naik), pendaftaran service worker, dan
 * lapisan interaksi grafik (components/InteraksiGrafik.astro).
 * Seluruh isi tetap terbaca ketika JavaScript dimatikan.
 */
import SvgDefs from "../components/SvgDefs.astro";
import InteraksiGrafik from "../components/InteraksiGrafik.astro";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/print.css";

interface Props {
  judul: string;
  deskripsi: string;
}

const { judul, deskripsi } = Astro.props;

const nav = [
  { href: "#pilar-1", label: "Data Dasar" },
  { href: "#pilar-2", label: "APBD" },
  { href: "#pilar-3", label: "Makro" },
  { href: "#pilar-4", label: "IKK" },
  { href: "#pilar-5", label: "Keistimewaan" },
  { href: "#pilar-6", label: "SPM" },
  { href: "#penutup", label: "Penutup" },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{judul}</title>
    <meta name="description" content={deskripsi} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="./brand/sadasa-mark-red.png" type="image/png" />

    {/* Huruf dimuat dari public/fonts/. Tidak ada satu pun permintaan ke domain luar. */}
    <link rel="preload" href="./fonts/GothamNarrow-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="./fonts/GothamNarrow-700.woff2" as="font" type="font/woff2" crossorigin />

    {/* Tema dipulihkan sebelum halaman digambar supaya tidak ada kedipan.
        Bila JavaScript mati, halaman tetap terbuka dalam mode terang. */}
    <script is:inline>
      document.documentElement.classList.add("js");
      // Kelas .js membuat blok menunggu digulir. Bila skrip gerak di akhir
      // halaman gagal (galat apa pun sebelum ia memasang .gerak-hidup), kelas
      // itu dilepas lagi supaya tidak ada isi yang tertahan tersembunyi.
      document.addEventListener("DOMContentLoaded", function () {
        var h = document.documentElement;
        if (!h.classList.contains("gerak-hidup")) h.classList.remove("js");
      });
      try {
        var t = localStorage.getItem("tema-lppd-diy");
        if (t === "ink") document.documentElement.setAttribute("data-theme", "ink");
      } catch (e) {
        /* localStorage dapat ditolak; halaman tetap jalan dalam mode terang. */
      }
    </script>
  </head>

  <body>
    <div class="progress no-print" aria-hidden="true"><div class="progress__bar" id="progress-bar"></div></div>

    <a class="lewati" href="#pembuka">Lompat ke isi</a>

    <header class="topbar no-print">
      <span class="topbar__title">LPPD DIY 2023 dalam Angka</span>
      <span class="topbar__spacer"></span>
      <nav class="topbar__nav" aria-label="Loncat ke pilar">
        {nav.map((it) => <a href={it.href}>{it.label}</a>)}
      </nav>
      <button class="btn-ghost" id="tombol-tema" type="button" aria-pressed="false">
        Mode gelap
      </button>
      <button class="btn-ghost" id="tombol-cetak" type="button">Cetak</button>
    </header>

    <SvgDefs />
    <InteraksiGrafik />

    <main>
      <slot />
    </main>

    <script is:inline>
      (function () {
        // Sakelar tema. Mode gelap dipilih, tidak pernah diambil otomatis
        // dari preferensi sistem.
        var akar = document.documentElement;
        var tombol = document.getElementById("tombol-tema");
        function pasang(gelap) {
          if (gelap) akar.setAttribute("data-theme", "ink");
          else akar.removeAttribute("data-theme");
          if (tombol) {
            tombol.setAttribute("aria-pressed", gelap ? "true" : "false");
            tombol.textContent = gelap ? "Mode terang" : "Mode gelap";
          }
          try {
            localStorage.setItem("tema-lppd-diy", gelap ? "ink" : "terang");
          } catch (e) {}
        }
        pasang(akar.getAttribute("data-theme") === "ink");
        if (tombol) {
          tombol.addEventListener("click", function () {
            pasang(akar.getAttribute("data-theme") !== "ink");
          });
        }

        var cetak = document.getElementById("tombol-cetak");
        if (cetak) cetak.addEventListener("click", function () { window.print(); });

        // Progres baca.
        var bar = document.getElementById("progress-bar");
        if (bar) {
          var tik = false;
          function gambar() {
            var h = document.documentElement;
            var maks = h.scrollHeight - h.clientHeight;
            var v = maks > 0 ? (h.scrollTop || document.body.scrollTop) / maks : 0;
            bar.style.width = Math.min(100, Math.max(0, v * 100)) + "%";
            tik = false;
          }
          addEventListener("scroll", function () {
            if (!tik) { tik = true; requestAnimationFrame(gambar); }
          }, { passive: true });
          gambar();
        }

        // Gerak saat gulir. Daftar BLOK harus sama dengan pemilih blok di
        // bagian "Gerak saat gulir" global.css, dengan print.css.
        var BLOK =
          ".hero__figures, .babak .wrap > *, .pilar > .wrap > :not(.adegan), " +
          ".adegan > :not(.adegan__body), .adegan__body > *";
        var JENJANG = 90; // = --gerak-jenjang: jarak antarblok yang masuk bersamaan
        var MULAI = 180; // = --gerak-mulai: tanda mulai sesudah bloknya muncul
        var halus = matchMedia("(prefers-reduced-motion: reduce)").matches;
        var blok = document.querySelectorAll(BLOK);

        var LANGKAH_MAKS = { kartu: 90, busur: 180 };
        function jenjangTanda(akarBlok) {
          var peta = new Map();
          akarBlok.querySelectorAll("[data-anim]").forEach(function (el) {
            var wadah = el.closest("[data-anim-grup], svg, [data-viz]") || akarBlok;
            var jenis = el.getAttribute("data-anim");
            var perJenis = peta.get(wadah);
            if (!perJenis) peta.set(wadah, (perJenis = {}));
            (perJenis[jenis] = perJenis[jenis] || []).push(el);
          });
          peta.forEach(function (perJenis) {
            Object.keys(perJenis).forEach(function (jenis) {
              var isi = perJenis[jenis];
              var langkah = Math.min(LANGKAH_MAKS[jenis] || 60, 600 / isi.length);
              isi.forEach(function (el, i) {
                el.style.setProperty("--tunda-k", Math.round(i * langkah) + "ms");
              });
            });
          });
        }

        // Angka bertanda data-count menghitung naik dari nol. Teks akhirnya
        // dikembalikan persis seperti yang ditulis server, jadi pemformatan
        // di sini tidak pernah bisa menyimpang dari lib/format.ts.
        function hitungNaik(akarBlok, tunda) {
          if (halus) return;
          akarBlok.querySelectorAll("[data-count]").forEach(function (el) {
            var target = parseFloat(el.getAttribute("data-count"));
            if (!(target > 0)) return;
            var digit = parseInt(el.getAttribute("data-desimal") || "0", 10);
            var fmt = new Intl.NumberFormat("id-ID", {
              minimumFractionDigits: digit,
              maximumFractionDigits: digit,
            });
            var akhir = el.textContent;
            var durasi = 1400;
            el.textContent = fmt.format(0);
            setTimeout(function () {
              var mulai = null;
              function langkah(ts) {
                if (mulai === null) mulai = ts;
                var t = Math.min((ts - mulai) / durasi, 1);
                var ease = 1 - Math.pow(2, -10 * t);
                el.textContent = t === 1 ? akhir : fmt.format(ease * target);
                if (t < 1) requestAnimationFrame(langkah);
              }
              requestAnimationFrame(langkah);
            }, tunda + MULAI);
          });
        }

        function tampil(el, tunda) {
          if (el.classList.contains("is-in")) return;
          tunda += parseInt(el.getAttribute("data-tunda") || "0", 10);
          el.style.setProperty("--blok-tunda", tunda + "ms");
          jenjangTanda(el);
          hitungNaik(el, tunda);
          el.classList.add("is-in");
        }
        function tampilSemua() {
          blok.forEach(function (el) { tampil(el, 0); });
        }
        addEventListener("beforeprint", tampilSemua);

        if (halus || !("IntersectionObserver" in window)) {
          tampilSemua();
        } else {
          var menyala = false;
          var io = new IntersectionObserver(function (entri) {
            menyala = true;
            var urut = 0;
            entri.forEach(function (e) {
              if (!e.isIntersecting) return;
              tampil(e.target, Math.min(urut++, 6) * JENJANG);
              io.unobserve(e.target);
            });
          }, { rootMargin: "0px 0px -10% 0px", threshold: 0 });
          blok.forEach(function (el) { io.observe(el); });

          // Jaring pengaman untuk pengamat yang tidak pernah menyala.
          function jaga() {
            setTimeout(function () { if (!menyala) tampilSemua(); }, 2500);
          }
          if (document.visibilityState === "hidden") {
            document.addEventListener("visibilitychange", function tunggu() {
              if (document.visibilityState === "hidden") return;
              document.removeEventListener("visibilitychange", tunggu);
              jaga();
            });
          } else {
            jaga();
          }
        }
        akar.classList.add("gerak-hidup");

        // Service worker: setelah satu kali dibuka, halaman terbuka penuh
        // tanpa jaringan. Dilewati bila dibuka langsung dari USB (file:).
        if ("serviceWorker" in navigator && location.protocol.indexOf("http") === 0) {
          addEventListener("load", function () {
            navigator.serviceWorker.register("./sw.js", { scope: "./" }).catch(function () {});
          });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  .lewati {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--surface-brand);
    color: var(--text-on-brand);
    padding: var(--space-3) var(--space-5);
    border-radius: 0 0 var(--radius-md) 0;
    font-size: var(--size-body-sm);
    text-decoration: none;
  }
  .lewati:focus {
    left: 0;
  }
</style>
