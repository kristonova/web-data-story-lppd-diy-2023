---
/**
 * Pilar — pembungkus satu dari enam pilar penyelenggaraan pemerintahan
 * daerah (LPPD 2023). Label bidang di kepala pilar membantu lembaga peran
 * menemukan bagian yang menjadi wilayahnya.
 */
interface Props {
  no: number;
  judul: string;
  bidang: string[];
  lead: string;
  id: string;
}

const { no, judul, bidang, lead, id } = Astro.props;
---

<section class="pilar" id={id} aria-labelledby={`${id}-judul`}>
  <div class="wrap">
    <div class="pilar__head">
      <span class="pilar__no" aria-hidden="true">{String(no).padStart(2, "0")}</span>
      <h2 id={`${id}-judul`}>
        <span class="sr-only">Pilar {no}. </span>{judul}
      </h2>
    </div>

    <p class="sr-only">Bidang yang dilayani pilar ini:</p>
    <div class="pilar__bidang-baris">
      {bidang.map((b) => <span class="pilar__bidang">{b}</span>)}
    </div>

    <hr class="rule-accent" />
    <p class="pilar__lead">{lead}</p>

    <slot />
  </div>
</section>

<style>
  .pilar__bidang-baris {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
  }
</style>
