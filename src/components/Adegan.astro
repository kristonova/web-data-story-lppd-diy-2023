---
/**
 * Adegan — struktur tetap seluruh adegan bernomor:
 * judul bergaris (pertanyaan) → visual di kiri → tafsir dan sumber di kanan.
 *
 * Judul memakai pola SectionTitle pedoman Jogja Istimewa: judul pendek
 * berhuruf Jogjakartype, pertanyaan adegan sebagai anak judul, lalu garis
 * aksen yang berawal dari tepi kiri layar. Kalimat tafsir menyatakan apa
 * yang terlihat pada data; rekomendasi tidak muncul di sini.
 */
import type { Sumber } from "../lib/data";
import { prov } from "../lib/data";
import { anchor } from "../lib/format";

interface Props {
  id: string;
  /** Judul pendek (dua sampai empat kata), berhuruf Jogjakartype. */
  judul: string;
  pertanyaan: string;
  tafsir: string;
  sumber?: Sumber | Sumber[];
  sumberTeks?: string;
  /** Sumber di luar LPPD (mis. batas wilayah peta), ditulis apa adanya. */
  sumberLain?: { label: string; teks: string }[];
  /** Visual selebar wadah; tafsir pindah ke bawah dalam dua kolom. */
  lebar?: boolean;
}

const { id, judul, pertanyaan, tafsir, sumber = [], sumberTeks, sumberLain = [], lebar = false } = Astro.props;
const daftar = Array.isArray(sumber) ? sumber : [sumber];
const nomor = id.replace("-", ".");
const ank = anchor(id);
---

<section class:list={["adegan", lebar && "adegan--lebar"]} id={ank} aria-labelledby={`${ank}-judul`}>
  <div class="wrap">
    <header class="jb" data-reveal>
      <span class="jb__no" aria-hidden="true">{nomor}</span>
      <h3 class="jb__teks" id={`${ank}-judul`}><span class="sr-only">Adegan {id}. </span>{judul}</h3>
      <p class="jb__tanya">{pertanyaan}</p>
      <div class="jb__garis" aria-hidden="true"></div>
    </header>

    <div class="adegan__isi">
      <div class="adegan__visual" data-reveal>
        <slot />
      </div>

      <div class="adegan__teks" data-reveal data-tunda="120">
        <p class="tafsir" set:html={tafsir} />
        <div class="sumber-daftar">
          {
            sumberTeks ? (
              <p class="sumber"><b>Sumber</b> {sumberTeks}</p>
            ) : (
              daftar.map((s) => (
                <p class="sumber"><b>Sumber</b> {prov(s)}</p>
              ))
            )
          }
          {sumberLain.map((s) => (
            <p class="sumber"><b>{s.label}</b> {s.teks}</p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
