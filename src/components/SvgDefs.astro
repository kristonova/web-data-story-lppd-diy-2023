---
/**
 * Definisi SVG bersama, dirender sekali di dalam tata letak.
 *
 * · `arsir-celah` — arsiran untuk kategori "Tidak tercatat". Celah data tidak
 *   pernah disampaikan lewat warna saja (PRD §11.1).
 * · `pola-1` … `pola-5` — tekstur pembeda yang dipakai lembar gaya cetak
 *   supaya grafik tetap terbaca setelah warnanya hilang (PRD §11.3).
 */
---

<svg width="0" height="0" aria-hidden="true" focusable="false" class="svg-defs">
  <defs>
    <pattern id="arsir-celah" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="6" height="6" fill="var(--surface-card)"></rect>
      <line x1="0" y1="0" x2="0" y2="6" stroke="var(--mark-gap)" stroke-width="3"></line>
    </pattern>

    <pattern id="pola-1" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="6" height="6" fill="#ffffff"></rect>
      <line x1="0" y1="0" x2="0" y2="6" stroke="#000000" stroke-width="3"></line>
    </pattern>
    <pattern id="pola-2" width="6" height="6" patternUnits="userSpaceOnUse">
      <rect width="6" height="6" fill="#000000"></rect>
    </pattern>
    <pattern id="pola-3" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
      <rect width="6" height="6" fill="#ffffff"></rect>
      <line x1="0" y1="0" x2="0" y2="6" stroke="#000000" stroke-width="2"></line>
    </pattern>
    <pattern id="pola-4" width="5" height="5" patternUnits="userSpaceOnUse">
      <rect width="5" height="5" fill="#ffffff"></rect>
      <circle cx="2.5" cy="2.5" r="1.4" fill="#000000"></circle>
    </pattern>
    <pattern id="pola-5" width="6" height="6" patternUnits="userSpaceOnUse">
      <rect width="6" height="6" fill="#ffffff"></rect>
      <line x1="0" y1="3" x2="6" y2="3" stroke="#000000" stroke-width="2"></line>
      <line x1="3" y1="0" x2="3" y2="6" stroke="#000000" stroke-width="2"></line>
    </pattern>
    <pattern id="pola-celah" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="6" height="6" fill="#ffffff"></rect>
      <line x1="0" y1="0" x2="0" y2="6" stroke="#8a8a8a" stroke-width="2"></line>
    </pattern>
  </defs>
</svg>

<style>
  .svg-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
