---
/**
 * Tabel angka alternatif. Setiap grafik memilikinya, dan ia terbuka tanpa
 * JavaScript karena memakai <details>. Sel yang tidak tersedia ditulis "–".
 */
interface Kolom {
  judul: string;
  num?: boolean;
}

interface Props {
  judul: string;
  keterangan?: string;
  kolom: Kolom[];
  baris: (string | number | null)[][];
}

const { judul, keterangan, kolom, baris } = Astro.props;
---

<details class="tabel-alt">
  <summary>Tabel angka: {judul}</summary>
  <div class="tabel-wadah">
    <table>
      <caption>{keterangan ?? judul}</caption>
      <thead>
        <tr>
          {kolom.map((k) => <th scope="col" class={k.num ? "num" : undefined}>{k.judul}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          baris.map((r) => (
            <tr>
              {r.map((sel, i) => {
                const num = kolom[i]?.num ?? false;
                const kosong = sel === null || sel === "";
                const kelas = [num ? "num" : "", kosong ? "kosong" : ""].filter(Boolean).join(" ") || undefined;
                if (i === 0) return <th scope="row" class={kelas}>{sel ?? "–"}</th>;
                return <td class={kelas}>{kosong ? "–" : sel}</td>;
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</details>
