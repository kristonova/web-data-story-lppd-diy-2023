---
/**
 * DuaTitik — dumbbell: dua nilai per baris dihubungkan garis penghubung.
 * Dipakai untuk pasangan dua periode (mis. IPM 2020 → 2023, TPT 2022 → 2023).
 *
 * Panjang garis penghubung adalah selisihnya, sehingga pergerakan antarwaktu
 * terbaca tanpa menghitung. Skala bersama, sumbu tunggal; rentang dimulai dari
 * titik yang memuat seluruh nilai (bukan selalu nol), karena pasangan
 * antarwaktu adalah perbandingan, bukan penjumlahan.
 */
import { kisi, q } from "../../lib/chart";
import { d } from "../../lib/format";
import { kontainer, tip } from "../../lib/viz";

export interface BarisDua {
  label: string;
  /** Nilai titik kiri (periode lebih awal). */
  a: number | null;
  /** Nilai titik kanan (periode akhir). */
  b: number | null;
  catatan?: string;
  sorot?: boolean;
}

interface Props {
  caption: string;
  label: string;
  rows: BarisDua[];
  /** Nama titik kiri dan kanan, mis. "2022" dan "2023". */
  kiri: string;
  kanan: string;
  satuan: string;
  digit?: number;
}

const { caption, label, rows, kiri, kanan, satuan, digit = 2 } = Astro.props;

const angka = rows.flatMap((r) => [r.a, r.b].filter((v): v is number => v !== null));
const lo0 = Math.min(...angka);
const hi0 = Math.max(...angka);
const LUKA = (hi0 - lo0 || 1) * 0.12;
const lo = q(Math.max(0, lo0 - LUKA));
const hi = q(hi0 + LUKA);
const rentang = hi - lo || 1;

const W = 760;
const rowH = 28;
const GAP = 9;
const labelW = Math.round(
  Math.min(300, Math.max(150, rows.reduce((m, r) => Math.max(m, r.label.length), 0) * 6.5 + 12)),
);
const valW = 126;
const top = 40;
const tinggiG = top + rows.length * (rowH + GAP) + 46;

const POJOK = labelW + 10;
const plotW = W - POJOK - valW - 14;
const x = (v: number) => q(POJOK + ((v - lo) / rentang) * plotW);
const y = (i: number) => q(top + i * (rowH + GAP) + rowH / 2);
const teks = (v: number | null) => (v === null ? "\u2013" : d(v, digit));

const langkah = kisi(rentang);
const numKisi = rentang > 40 ? 0 : digit;
const WARNA_A = "var(--series-2)";
const WARNA_B = "var(--series-1)";

const atribut = (r: BarisDua, v: number | null, sisi: "a" | "b"): Record<string, string> =>
  v === null
    ? {}
    : tip({
        judul: r.label,
        nilai: `${d(v, digit)} ${satuan}`,
        baris: [`${sisi === "a" ? kiri : kanan}`, r.catatan ?? ""],
        warna: sisi === "a" ? WARNA_A : WARNA_B,
      });
---

<figure class="figur">
  <figcaption>{caption}</figcaption>

  <div class="viz" {...kontainer(label)}>
    <svg viewBox={`0 0 ${W} ${tinggiG}`} width="100%" preserveAspectRatio="xMinYMin meet"
         role="img" aria-label={label} aria-hidden="false">
      <g class="grid" aria-hidden="true">
        {langkah.map((c) => (
          <g>
            <line x1={q(POJOK + (c / rentang) * plotW)} x2={q(POJOK + (c / rentang) * plotW)}
                  y1={top - 10} y2={tinggiG - 36} />
            <text class="tick" x={q(POJOK + (c / rentang) * plotW)} y={tinggiG - 18}
                  text-anchor="middle">{d(lo + c, numKisi)}</text>
          </g>
        ))}
        <text class="judul-sumbu" x={POJOK} y={top - 16} text-anchor="start">{kiri} → {kanan}</text>
      </g>

      {
        rows.map((r, i) => {
          const ny = y(i);
          const xa = r.a === null ? null : x(r.a);
          const xb = r.b === null ? null : x(r.b);
          const naik = (r.a ?? 0) <= (r.b ?? 0);
          return (
            <g transform={`translate(0 ${ny})`}>
              <text class="nama" x={q(POJOK - 14)} y="4" text-anchor="end">
                {r.label.length > 30 ? `${r.label.slice(0, 29)}…` : r.label}
              </text>
              {xa !== null && xb !== null && (
                <line x1={xa} y1="0" x2={xb} y2="0" stroke="var(--mark-base)" stroke-width="2"
                      stroke-linecap="round" opacity="0.5" data-anim="pudar" />
              )}
              {xa === null && xb === null && (
                <text class="tick" x={POJOK} y="4" text-anchor="start">tidak dinyatakan</text>
              )}
              {xa !== null && (
                <circle cx={xa} cy="0" r="4.5" fill={WARNA_A} stroke="var(--surface-card)"
                        stroke-width="1.5" data-anim="titik" {...atribut(r, r.a, "a")} />
              )}
              {xb !== null && (
                <g>
                  <circle cx={xb} cy="0" r="5.5" fill={r.sorot ? "var(--mark-highlight)" : WARNA_B}
                          stroke="var(--surface-card)" stroke-width="1.5" data-anim="titik"
                          {...atribut(r, r.b, "b")} />
                  <text class="nilai" x={q(xb + (naik ? 11 : -11))} y="4"
                        text-anchor={naik ? "start" : "end"} data-anim="pudar">
                    {teks(r.b)}
                  </text>
                </g>
              )}
            </g>
          );
        })
      }
      <text class="satuan" x={W - 2} y={top - 16} text-anchor="end">{satuan}</text>
    </svg>
  </div>
</figure>

<style>
  .grid line {
    stroke: var(--chart-grid);
    stroke-width: 1;
  }
  .tick {
    fill: var(--text-subtle);
    font-size: 11px;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .satuan {
    fill: var(--text-subtle);
    font-size: 10.5px;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .nama {
    fill: var(--text-body);
    font-size: 12.5px;
    font-family: var(--font-body);
  }
  .nilai {
    fill: var(--text-strong);
    font-size: 13.5px;
    font-weight: var(--fw-bold);
    font-family: var(--font-body);
  }
  .judul-sumbu {
    fill: var(--text-muted);
    font-size: 11.5px;
    font-family: var(--font-body);
  }
</style>
