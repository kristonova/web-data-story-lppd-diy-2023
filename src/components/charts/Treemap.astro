---
/**
 * Treemap — luas petak sebanding dengan nilai (squarified). Petak bersudut
 * tajam dipisah garis putih. Rasio sisi kanvas boleh berubah antar-layar:
 * peregangan satu arah menjaga perbandingan luas antar-petak.
 */
import { kontainer, tip, squarify, css } from "../../lib/viz";

interface Petak {
  label: string;
  n: number;
  tampil: string;
  porsi: string;
  warna: string;
  teks?: string;
  sub?: string;
}
interface Props {
  label: string;
  items: Petak[];
}

const { label, items } = Astro.props;
const W = 1000;
const H = 560;
const kotak = squarify(items.map((d) => ({ nilai: d.n, data: d })), 0, 0, W, H);
---

<div class="viz tm" {...kontainer(label)}>
  {
    kotak.map((k, i) => {
      const w = (100 * k.w) / W;
      const h = (100 * k.h) / H;
      const kelas = w * h < 60 ? "kecil" : w < 22 || h < 22 ? "sedang" : "besar";
      return (
        <div
          class:list={["tm__petak", `tm__petak--${kelas}`]}
          style={`left:${css((100 * k.x) / W)};top:${css((100 * k.y) / H)};width:${css(w)};height:${css(h)};background:${k.data.warna};color:${k.data.teks ?? "var(--white)"};--tunda-k:${i * 70}ms`}
          data-anim="pudar"
          {...tip({ judul: k.data.label, nilai: k.data.tampil, baris: [`${k.data.porsi} dari total`, k.data.sub], warna: k.data.warna })}
        >
          <span class="tm__nama">{k.data.label}</span>
          <span class="tm__nilai">{k.data.tampil}</span>
          <span class="tm__porsi">{k.data.porsi}</span>
        </div>
      );
    })
  }
</div>

<style>
  .tm {
    position: relative;
    width: 100%;
    aspect-ratio: 1000 / 560;
  }
  .tm__petak {
    position: absolute;
    box-shadow: inset 0 0 0 1.5px var(--surface);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
    cursor: default;
  }
  .tm__nama {
    font-size: var(--fs-small);
    line-height: 1.2;
  }
  .tm__nilai {
    font-size: 1.375rem;
    font-weight: 300;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tm__porsi {
    font-size: var(--fs-micro);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .tm__petak--besar .tm__nilai {
    font-size: clamp(1.375rem, 1rem + 1.4vw, 2.25rem);
  }
  .tm__petak--sedang {
    padding: 8px 10px;
  }
  .tm__petak--sedang .tm__nilai {
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .tm__petak--kecil > * {
    display: none;
  }
  @media (max-width: 720px) {
    .tm {
      aspect-ratio: 1000 / 860;
    }
    .tm__petak--sedang > * {
      display: none;
    }
  }
</style>
