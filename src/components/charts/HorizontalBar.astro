---
/**
 * HorizontalBar — perbandingan besaran antarkategori dengan label panjang dalam
 * bahasa Indonesia. Dipakai di adegan 4.1, 4.3, 5.4, dan 5.5 — data berjenjang
 * dan daftar panjang berlabel, tempat batang tetap bentuk yang paling jujur.
 *
 * Dua tata letak dirender berdampingan dan dipilih lewat media query, keduanya
 * SVG murni: tata letak lebar meletakkan label di kiri batang, tata letak sempit
 * meletakkannya di atas batang. Dengan begitu halaman tetap terbaca pada lebar
 * 400 px tanpa gulir mendatar dan tanpa satu baris JavaScript pun (PRD §11).
 *
 * Warna mengikuti aturan anggaran merah SADASA: seluruh batang netral, dan satu
 * batang yang dibicarakan kalimat tafsir disorot merah. Kategori "Tidak
 * tercatat" selalu berarsir, sehingga celah data tidak disampaikan lewat warna
 * saja.
 */
import type { Row } from "../../lib/data";
import { isi, kisi, maksBaris, potong, q, sorotan, TIDAK_TERCATAT, type SeriKey } from "../../lib/chart";
import { n, p } from "../../lib/format";
import { kontainer, tip } from "../../lib/viz";

interface Props {
  rows: Row[];
  /** Label batang yang disorot merah — satu angka yang dibicarakan tafsir. */
  sorot?: string | string[];
  /** Keterangan di bawah judul grafik. */
  caption: string;
  /** Label aksesibel untuk pembaca layar. */
  label: string;
  /** Satuan yang ditulis di ujung batang. */
  satuan?: string;
  /** Tampilkan persentase di samping angka. */
  persen?: boolean;
  /** Beri setiap kategori slot serinya sendiri, bukan netral + sorotan. */
  warnaPerKategori?: boolean;
  /** Akhiran persentase di tooltip, misalnya "dari 12.614 jiwa terdaftar". */
  penyebutLabel?: string;
}

const {
  rows,
  sorot,
  caption,
  label,
  satuan = "jiwa",
  persen = true,
  warnaPerKategori = false,
  penyebutLabel = "",
} = Astro.props;

const maks = maksBaris(rows);
const garis = kisi(maks, 4);
const atas = garis[garis.length - 1] || 1;

const slot = (r: Row, i: number): SeriKey => {
  if (r.label === TIDAK_TERCATAT) return "gap";
  if (!warnaPerKategori) return sorotan(r.label, sorot);
  return String((i % 5) + 1) as SeriKey;
};

const teksNilai = (r: Row): string => {
  if (r.n === null) return "–";
  const dasar = n(r.n);
  return persen && r.pct !== null ? `${dasar} (${p(r.pct)})` : dasar;
};

// ── Geometri. Satu berkas, dua ukuran. ───────────────────────────────────────
// Kolom label mengikuti label terpanjang: label kategori dalam bahasa Indonesia
// jauh lebih panjang daripada bahasa Inggris, dan memotongnya terlalu dini
// membuat pembaca harus membuka tabel angka untuk hal yang sepele.
const panjangTerpanjang = rows.reduce((m, r) => Math.max(m, r.label.length), 0);
const LABEL_W = Math.round(Math.min(316, Math.max(150, panjangTerpanjang * 6.1 + 8)));
const POTONG_LEBAR = Math.floor((LABEL_W - 8) / 6.1);

const LEBAR = { rowH: 22, gap: 7, labelW: LABEL_W, valW: 96, top: 22, bottom: 8, W: 760, fs: 12.5 };
const SEMPIT = { rowH: 15, gap: 22, labelW: 0, valW: 0, top: 18, bottom: 8, W: 372, fs: 11.5 };

type Geo = typeof LEBAR;
const plotW = (g: Geo) => g.W - g.labelW - g.valW - 8;
const tinggi = (g: Geo) =>
  g.top + rows.length * (g.rowH + g.gap) - g.gap + g.bottom + (g.labelW === 0 ? rows.length * 14 : 0);

/** Batang dengan ujung kanan membulat 4 px. */
function batang(xr: number, yr: number, wr: number, hr: number): string {
  const [x, y, w, h] = [q(xr), q(yr), q(wr), q(hr)];
  const r = q(Math.min(4, w / 2, h / 2));
  if (w <= 0.6) return `M${x} ${y} h0.6 v${h} h-0.6 Z`;
  return `M${x} ${y} h${q(w - r)} a${r} ${r} 0 0 1 ${r} ${r} v${q(h - 2 * r)} a${r} ${r} 0 0 1 ${-r} ${r} h${q(-(w - r))} Z`;
}
---

<figure class="figur">
  <figcaption>{caption}</figcaption>

  <div class="viz" {...kontainer(label)}>
  {
    ([
      ["bar--lebar", LEBAR],
      ["bar--sempit", SEMPIT],
    ] as [string, Geo][]).map(([kelas, g]) => {
      const pw = plotW(g);
      const x0 = g.labelW === 0 ? 1 : g.labelW + 8;
      const lebarBatang = (v: number | null) => (v === null ? 0 : q((v / atas) * pw));
      const barisY = (i: number) =>
        g.labelW === 0 ? g.top + i * (g.rowH + g.gap + 14) : g.top + i * (g.rowH + g.gap);

      return (
        <svg
          class:list={["bar", kelas]}
          viewBox={`0 0 ${g.W} ${tinggi(g)}`}
          aria-hidden="true"
          preserveAspectRatio="xMinYMin meet"
        >
          {/* Garis kisi dan label sumbu. Sumbu tunggal, selalu dimulai dari nol. */}
          <g class="grid" aria-hidden="true">
            {garis.map((v) => {
              const x = q(x0 + (v / atas) * pw);
              return (
                <>
                  <line x1={x} y1={g.top - 6} x2={x} y2={tinggi(g) - g.bottom} />
                  <text class="tick" x={x} y={g.top - 10} text-anchor={v === 0 ? "start" : "middle"}>
                    {n(v)}
                  </text>
                </>
              );
            })}
          </g>

          {rows.map((r, i) => {
            const y = barisY(i);
            const s = slot(r, i);
            const f = isi(s);
            const w = lebarBatang(r.n);
            const yBatang = g.labelW === 0 ? y + 14 : y;

            return (
              <g
                class="baris"
                {...tip({
                  judul: r.label,
                  nilai: r.n === null ? "–" : `${n(r.n)} ${satuan}`,
                  warna: r.n === null || s === "gap" ? undefined : f.fill,
                  baris: [
                    r.pct !== null && `${p(r.pct)} ${penyebutLabel}`.trim(),
                    r.n === null && "nilai tidak dinyatakan",
                  ],
                })}
              >
                <rect x="0" y={q(y - g.gap / 2)} width={g.W} height={q(g.rowH + g.gap + (g.labelW === 0 ? 14 : 0))} fill="transparent" />
                {g.labelW === 0 ? (
                  <text class="label" x={1} y={y + 9}>
                    {potong(r.label, 34)}
                  </text>
                ) : (
                  <text class="label" x={g.labelW} y={yBatang + g.rowH / 2 + 4} text-anchor="end">
                    {potong(r.label, POTONG_LEBAR)}
                  </text>
                )}

                {r.n === null ? (
                  <text class="masked" x={x0} y={yBatang + g.rowH / 2 + 4}>
                    tidak dinyatakan
                  </text>
                ) : (
                  <path d={batang(x0, yBatang, w, g.rowH)} fill={f.fill} data-seri={f["data-seri"]} data-anim="x" />
                )}

                {r.n !== null &&
                  (g.labelW === 0 ? (
                    /* Tata letak sempit: angka duduk di ujung kanan baris label,
                       bukan di ujung batang, supaya tidak pernah keluar bidang
                       ketika batang mencapai batas sumbu. */
                    <text class="nilai" x={g.W - 1} y={y + 9} text-anchor="end" data-anim="pudar" style="--tunda:320ms">
                      {teksNilai(r)}
                    </text>
                  ) : (
                    <text class="nilai" x={g.W - g.valW + 6} y={yBatang + g.rowH / 2 + 4} data-anim="pudar" style="--tunda:320ms">
                      {teksNilai(r)}
                    </text>
                  ))}
              </g>
            );
          })}

          {g.labelW > 0 && (
            <text class="satuan" x={g.W - 2} y={g.top - 10} text-anchor="end" aria-hidden="true">
              {satuan}
            </text>
          )}
        </svg>
      );
    })
  }
  </div>

  <slot />
</figure>

<style>
  .bar {
    width: 100%;
    height: auto;
  }
  .bar--sempit {
    display: none;
  }
  @media (max-width: 640px) {
    .bar--lebar {
      display: none;
    }
    .bar--sempit {
      display: block;
    }
  }
  @media print {
    .bar--lebar {
      display: block !important;
    }
    .bar--sempit {
      display: none !important;
    }
  }

  .grid line {
    stroke: var(--chart-grid);
    stroke-width: 1;
  }
  .tick {
    fill: var(--text-subtle);
    font-size: 11px;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .label {
    fill: var(--text-body);
    font-size: 12.5px;
    font-family: var(--font-body);
  }
  .nilai {
    fill: var(--text-strong);
    font-size: 12.5px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .masked {
    fill: var(--text-subtle);
    font-size: 11.5px;
    font-style: italic;
  }
  .satuan {
    fill: var(--text-subtle);
    font-size: 10.5px;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
