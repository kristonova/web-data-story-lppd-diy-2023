---
/**
 * MeterRing — satu nilai persen dalam busur cincin.
 * Dipakai untuk nilai akhir penyelenggaraan keistimewaan DIY (90,04) dan
 * persentase serupa yang dibicarakan sebagai satu angka tunggal.
 *
 * Busur digambar dengan pathLength=100 sehingga animasi gerak-busur dapat
 * memanjangkannya dari nol; angkanya tetap terbaca tanpa JavaScript.
 */
import { d } from "../../lib/format";
import { kontainer, tip } from "../../lib/viz";

interface Props {
  caption: string;
  label: string;
  /** Nilai 0–100. */
  nilai: number;
  /** Teks besar di tengah cincin. */
  besar: string;
  /** Baris keterangan di bawah angka besar. */
  sub?: string;
  /** Nilai pembanding yang ditandai garis penunjuk di busur (0–100). */
  pembanding?: number;
  pembandingLabel?: string;
}

const { caption, label, nilai, besar, sub, pembanding, pembandingLabel } = Astro.props;

const NULLY = 0.00001; // garis sejajar; clamp
const v = Math.min(100, Math.max(NULLY, nilai || NULLY));
const vStandar = pembanding === undefined ? null : Math.min(100, Math.max(0, pembanding));

const R = 92;
const CX = 128;
const CY = 128;
const H = 260;
const W = 260;
---

<figure class="figur">
  <figcaption>{caption}</figcaption>

  <div class="viz" {...kontainer(label)}>
    <svg viewBox={`0 0 ${W} ${H}`} width="260" height="260" style="max-width:100%"
         role="img" aria-label={label} aria-hidden="false">
      <circle cx={CX} cy={CY} r={R} fill="none" stroke="var(--chart-grid)" stroke-width="6" />
      <circle cx={CX} cy={CY} r={R} fill="none" stroke="var(--mark-highlight)" stroke-width="12"
              stroke-linecap="round" pathLength="100" stroke-dasharray={`${v} ${(100 - v).toFixed(2)}`}
              transform={`rotate(-90 ${CX} ${CY})`} data-anim="busur"
              {...tip({
                judul: label,
                nilai: `${d(nilai, 2)}`,
                baris: [vStandar !== null ? `pembanding ${d(vStandar!, 2)}` : "", sub ?? ""],
                warna: "var(--mark-highlight)",
              })} />
      {vStandar !== null && (
        <line
          x1={(CX + (R + 6) * Math.cos((1 - vStandar / 100) * 2 * Math.PI - Math.PI / 2)).toFixed(2)}
          y1={(CY + (R + 6) * Math.sin((1 - vStandar / 100) * 2 * Math.PI - Math.PI / 2)).toFixed(2)}
          x2={(CX + (R - 10) * Math.cos((1 - vStandar / 100) * 2 * Math.PI - Math.PI / 2)).toFixed(2)}
          y2={(CY + (R - 10) * Math.sin((1 - vStandar / 100) * 2 * Math.PI - Math.PI / 2)).toFixed(2)}
          stroke="var(--text-subtle)" stroke-width="2"
        />
      )}
      <text class="besar" x={CX} y={CY + 2} text-anchor="middle">{besar}</text>
      {sub && <text class="sub" x={CX} y={CY + 26} text-anchor="middle">{sub}</text>}
      {vStandar !== null && <text class="ket" x={W / 2} y={H - 4} text-anchor="middle">{pembandingLabel ?? ""}</text>}
    </svg>
  </div>
</figure>

<style>
  .besar {
    fill: var(--text-strong);
    font-size: 34px;
    font-weight: var(--fw-bold);
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
  }
  .sub {
    fill: var(--text-muted);
    font-size: 12px;
    font-family: var(--font-body);
  }
  .ket {
    fill: var(--text-subtle);
    font-size: 11px;
    font-family: var(--font-mono);
  }
</style>
