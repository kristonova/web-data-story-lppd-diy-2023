---
/**
 * Kupu — batang punggung-ke-punggung: porsi kiri (mis. luas wilayah) dan
 * porsi kanan (mis. penduduk) untuk setiap baris, dengan nama di tengah.
 * Skala kedua sisi sama, sehingga panjang batang dapat dibandingkan langsung.
 */
import { kontainer, tip, css } from "../../lib/viz";

interface Baris {
  label: string;
  kiri: number;
  kanan: number;
  tampilKiri: string;
  tampilKanan: string;
  catatan?: string;
  sorotKiri?: boolean;
  sorotKanan?: boolean;
}
interface Props {
  label: string;
  rows: Baris[];
  judulKiri: string;
  judulKanan: string;
}

const { label, rows, judulKiri, judulKanan } = Astro.props;
const m = Math.max(...rows.flatMap((r) => [r.kiri, r.kanan])) * 1.22;
---

<div class="viz kp" {...kontainer(label)}>
  <div class="kp__kepala" aria-hidden="true">
    <span class="kp__jk">{judulKiri}</span>
    <span />
    <span class="kp__jn">{judulKanan}</span>
  </div>
  {
    rows.map((r) => (
      <div class="kp__baris" data-g={r.label}>
        <span
          class:list={["kp__sisi kp__sisi--kiri", r.sorotKiri && "is-sorot"]}
          data-g={r.label}
          {...tip({ judul: r.label, nilai: `${r.tampilKiri} ${judulKiri.toLowerCase()}`, baris: [`${r.tampilKanan} ${judulKanan.toLowerCase()}`, r.catatan] })}
        >
          <span class="kp__rel">
            <span class="kp__batang" data-anim="x-kanan" style={`width:${css((100 * r.kiri) / m)}`} />
            <span class="kp__angka" data-anim="pudar" style={`right:calc(${css((100 * r.kiri) / m)} + 8px)`}>{r.tampilKiri}</span>
          </span>
        </span>
        <span class="kp__nama">{r.label}</span>
        <span
          class:list={["kp__sisi kp__sisi--kanan", r.sorotKanan && "is-sorot"]}
          data-g={r.label}
          {...tip({ judul: r.label, nilai: `${r.tampilKanan} ${judulKanan.toLowerCase()}`, baris: [`${r.tampilKiri} ${judulKiri.toLowerCase()}`, r.catatan] })}
        >
          <span class="kp__rel">
            <span class="kp__batang" data-anim="x" style={`width:${css((100 * r.kanan) / m)}`} />
            <span class="kp__angka" data-anim="pudar" style={`left:calc(${css((100 * r.kanan) / m)} + 8px)`}>{r.tampilKanan}</span>
          </span>
        </span>
      </div>
    ))
  }
</div>

<style>
  .kp {
    display: grid;
    gap: 6px;
  }
  .kp__kepala,
  .kp__baris {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9.5rem minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-3);
  }
  .kp__kepala {
    font-size: var(--fs-small);
    font-weight: 600;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--hairline);
    margin-bottom: var(--space-2);
  }
  .kp__jk {
    text-align: right;
  }
  .kp__baris {
    min-height: 46px;
  }
  .kp__nama {
    text-align: center;
    font-size: var(--fs-small);
    line-height: 1.2;
  }
  .kp__sisi {
    display: grid;
    align-items: center;
    column-gap: var(--space-2);
    cursor: default;
  }
  .kp__sisi {
    grid-template-columns: minmax(0, 1fr);
  }
  .kp__rel {
    position: relative;
    height: 18px;
  }
  .kp__batang {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--c-redup);
  }
  .kp__sisi--kiri .kp__batang {
    right: 0;
  }
  .kp__sisi--kanan .kp__batang {
    left: 0;
    background: var(--c-dasar);
  }
  .kp__sisi.is-sorot .kp__batang {
    background: var(--c-sorot);
  }
  .kp__angka {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--fs-small);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    line-height: 1;
  }
  .kp__sisi.is-sorot .kp__angka {
    color: var(--red);
  }
  @media (max-width: 600px) {
    .kp__kepala,
    .kp__baris {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      row-gap: 4px;
    }
    .kp__kepala > :nth-child(2) {
      display: none;
    }
    .kp__nama {
      grid-column: 1 / -1;
      grid-row: 1;
      text-align: center;
      font-weight: 600;
    }
    .kp__sisi--kiri {
      grid-row: 2;
      grid-column: 1;
    }
    .kp__sisi--kanan {
      grid-row: 2;
      grid-column: 2;
    }
  }
</style>
