---
/**
 * DataGapCard — celah data adalah temuan, dan ia butuh bentuknya sendiri.
 * Dipakai di adegan 4.2, 5.6, dan 6.2.
 *
 * Kartu ini tidak pernah menyimpulkan apa pun dari data yang tidak ada; ia
 * melaporkan besaran celahnya (PRD §12).
 */
import { n, p } from "../../lib/format";

interface Props {
  judul: string;
  kosong: number;
  dari: number;
  pct?: number | null;
  akibat: string;
  usul?: string;
}

const { judul, kosong, dari, pct, akibat, usul } = Astro.props;
const persen = pct ?? (dari > 0 ? (100 * kosong) / dari : null);
---

<aside class="celah" aria-label={`Celah data: ${judul}`}>
  <div class="celah__head">
    <svg class="celah__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
      <line x1="12" y1="9" x2="12" y2="13"></line>
      <line x1="12" y1="17" x2="12.01" y2="17"></line>
    </svg>
    <span class="celah__title">Catatan kelengkapan data — {judul}</span>
  </div>

  <span class="celah__n">{n(kosong)}<span class="stat__unit">dari {n(dari)}{persen !== null ? ` \u00b7 ${p(persen)}` : ""}</span></span>
  <p>{akibat}</p>
  {usul && <p><b>Langkah penyempurnaan pada pembaruan data berikutnya:</b> {usul}</p>}
</aside>
