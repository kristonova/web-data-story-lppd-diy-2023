---
/**
 * Peta — peta tematik DIY dari batas GeoJSON (diproyeksikan saat build).
 *
 * Mode:
 *  · koroplet  — isian kabupaten/kota mengikuti nilai; beberapa lapis dapat
 *                dipilih dengan tombol (luas, penduduk, kepadatan, …).
 *  · kategori  — 78 kapanewon/kemantren diwarnai menurut kabupaten/kotanya.
 *  · gelembung — lingkaran sebanding nilai di tengah tiap kabupaten/kota;
 *                lapis (mis. tahun) dapat dipilih atau diputar berurutan.
 *  · penanda   — peta dasar netral dengan garis Sumbu Filosofi dan sisipan Kota.
 *
 * Jalur batas tidak diulang: setiap peta memakai <use href="#pk-…"> ke
 * PetaDefs. Seluruh teks (nama, nilai, legenda) adalah HTML yang diletakkan
 * dengan persen, sehingga tetap tajam dan terbaca di ponsel. Tanpa JavaScript
 * lapis pertama yang tampil; seluruh lapis ada di tabel angka di bawahnya.
 */
import { peta } from "../../lib/data";
import { kontainer, tip, css } from "../../lib/viz";
import { RAMP, WARNA_KAB, padaRamp, teksDi, gradien, type NamaRamp } from "../../lib/warna";

interface NilaiWil {
  nilai: number | null;
  tampil: string;
  baris?: (string | false | null | undefined)[];
  /** Nilai lingkaran dalam (mode gelembung), mis. hotel bintang dari seluruh hotel. */
  dalam?: number | null;
}
interface Lapis {
  judul: string;
  nilai: Record<string, NilaiWil>;
  ramp?: NamaRamp;
  /** Judul legenda gradasi; bawaan = judul lapis. */
  legenda?: string;
}
interface Props {
  label: string;
  mode?: "koroplet" | "kategori" | "gelembung" | "penanda";
  lapis?: Lapis[];
  /** Garis batas kapanewon di atas isian kabupaten. */
  kapanewon?: boolean;
  /** Baris teks tambahan di bawah nama kabupaten (mode kategori/penanda). */
  catatanKab?: Record<string, string[]>;
  kecil?: boolean;
  panel?: boolean;
  putar?: boolean;
  judulPilih?: string;
  /** Jari-jari lingkaran terbesar, satuan peta (lebar peta 1000). */
  rMaks?: number;
  /** Kabupaten/kota yang diberi garis tepi tebal. */
  sorot?: string[];
  tampilNama?: boolean;
  /** Keterangan legenda gelembung. */
  ketGelembung?: string;
  /** Lapis yang tampil pertama (juga tanpa JavaScript). */
  awal?: number;
}

const {
  label,
  mode = "koroplet",
  lapis = [],
  kapanewon = false,
  catatanKab = {},
  kecil = false,
  panel = false,
  putar = false,
  judulPilih = "Pilih lapisan peta",
  rMaks = 70,
  sorot = [],
  tampilNama = !kecil,
  ketGelembung,
  awal = 0,
} = Astro.props;

const vb = kecil ? peta.diyBox : ([0, 0, peta.lebar, peta.tinggi] as const);
const [vx, vy, vw, vh] = vb;
const pctX = (x: number) => css((100 * (x - vx)) / vw);
const pctY = (y: number) => css((100 * (y - vy)) / vh);
const KOTA = "3471";
const KOSONG = "#ece8e4";
const KAB_DASAR = "#f6f2ec";

const kodeKab = peta.kab.map((k) => k.kode);
const namaKab = (kode: string) => peta.kab.find((k) => k.kode === kode)?.nama ?? kode;
const jenisKap = (kodeK: string) => (kodeK === KOTA ? "Kemantren" : "Kapanewon");

// Kota terlalu kecil untuk label di dalamnya: label digeser dengan garis penunjuk.
const geserKota = kecil ? { dx: 108, dy: -6 } : { dx: 92, dy: -4 };
const posLabel = (k: (typeof peta.kab)[number]) =>
  k.kode === KOTA ? { x: k.lx + geserKota.dx, y: k.ly + geserKota.dy } : { x: k.lx, y: k.ly };

// ── Warna dan ukuran per lapis ───────────────────────────────────────────────
const nilaiKab = (L: Lapis) => kodeKab.map((k) => L.nilai[k]?.nilai).filter((v): v is number => v != null);
const isianLapis = lapis.map((L) => {
  const vs = nilaiKab(L);
  const [lo, hi] = [Math.min(...vs), Math.max(...vs)];
  const stops = RAMP[L.ramp ?? "merah"];
  const isi: Record<string, string> = {};
  for (const k of kodeKab) {
    const v = L.nilai[k]?.nilai;
    isi[k] = v == null ? KOSONG : padaRamp(stops, 0.14 + (0.86 * (v - lo)) / (hi - lo || 1));
  }
  return { isi, stops, lo, hi };
});
const isiKab = (kode: string, i: number) =>
  mode === "koroplet" ? isianLapis[i]?.isi[kode] ?? KOSONG : mode === "kategori" ? WARNA_KAB[kode]! : KAB_DASAR;

const vMaksGel = Math.max(1, ...lapis.flatMap((L) => nilaiKab(L)));
const skalaGel = (v: number | null | undefined) => (v == null || v <= 0 ? 0 : Math.sqrt(v / vMaksGel));

const warnaTeks = (f: string) => (mode === "koroplet" || mode === "kategori" ? teksDi(f) : "var(--ink)");
const gayaLapis = (kode: string) =>
  (lapis.length ? lapis : [null])
    .map((L, i) => {
      const f = isiKab(kode, i);
      const parts = [`--f${i}:${f}`, `--t${i}:${warnaTeks(f)}`];
      if (mode === "gelembung" && L) {
        parts.push(`--s${i}:${skalaGel(L.nilai[kode]?.nilai).toFixed(4)}`);
        parts.push(`--d${i}:${skalaGel(L.nilai[kode]?.dalam).toFixed(4)}`);
      }
      return parts.join(";");
    })
    .join(";");

const tipLapis = (kode: string) => {
  const a: Record<string, string> = {};
  lapis.forEach((L, i) => {
    const t = tip({ judul: `${namaKab(kode)} · ${L.judul}`, nilai: L.nilai[kode]?.tampil ?? "tidak tercatat", baris: L.nilai[kode]?.baris });
    a[`data-v${i}`] = t["data-v"]!;
    a[`data-t${i}`] = t["data-t"]!;
    if (t["data-s"]) a[`data-s${i}`] = t["data-s"];
  });
  const L0 = lapis[awal];
  return {
    ...tip({
      judul: L0 ? `${namaKab(kode)} · ${L0.judul}` : namaKab(kode),
      nilai: L0?.nilai[kode]?.tampil ?? catatanKab[kode]?.join(" · ") ?? namaKab(kode),
      baris: L0?.nilai[kode]?.baris,
      warna: mode === "kategori" ? WARNA_KAB[kode] : undefined,
    }),
    ...a,
  };
};

// Panel peringkat per lapis.
const panelLapis = lapis.map((L) => {
  const rows = kodeKab
    .map((k) => ({ kode: k, v: L.nilai[k]?.nilai ?? null, tampil: L.nilai[k]?.tampil ?? "" }))
    .sort((a, b) => (b.v ?? -Infinity) - (a.v ?? -Infinity));
  const maks = Math.max(...rows.map((r) => r.v ?? 0)) || 1;
  return rows.map((r) => ({ ...r, lebar: (100 * (r.v ?? 0)) / maks }));
});

// ── Sumbu Filosofi ───────────────────────────────────────────────────────────
const sumbu = peta.penanda.filter((p) => p.jenis === "sumbu");
const ruas = (a: number, b: number) => sumbu.slice(a, b + 1).map((p, j) => `${j ? "L" : "M"}${p.x} ${p.y}`).join("");
const sumbuImajiUtara = ruas(0, 1);
const sumbuInti = ruas(1, 3);
const sumbuImajiSelatan = ruas(3, 4);
const labelLain = peta.penanda.filter((p) => p.jenis !== "sumbu");
const [kx, ky, kw, kh] = peta.kotaBox;
const pctKX = (x: number) => css((100 * (x - kx)) / kw);
const pctKY = (y: number) => css((100 * (y - ky)) / kh);
// Hanya kapanewon yang tampak di bingkai sisipan, supaya penjelajahan papan ketik tidak tersesat.
const kapKota = peta.kapanewon.filter((c) => c.lx > kx - 45 && c.lx < kx + kw + 45 && c.ly > ky - 45 && c.ly < ky + kh + 45);

const nLapis = Math.max(1, lapis.length);
const kotaLabel = peta.kab.find((k) => k.kode === KOTA)!;
const kotaPos = posLabel(kotaLabel);
---

<div
  class:list={["peta", `peta--${mode}`, kecil && "peta--kecil", panel && "peta--panel"]}
  data-lapis={String(awal)}
  data-lapis-induk
  style={`--n-lapis:${nLapis}`}
>
  {
    lapis.length > 1 && (
      <div class="peta__pilih" role="group" aria-label={judulPilih}>
        {lapis.map((L, i) => (
          <button type="button" class="pil" data-pilih={i} aria-pressed={i === awal ? "true" : "false"}>
            {L.judul}
          </button>
        ))}
        {putar && (
          <button type="button" class="pil pil--putar" data-putar aria-pressed="false">
            <span class="pil__ikon" aria-hidden="true" />
            <span data-putar-teks>Putar</span>
          </button>
        )}
      </div>
    )
  }

  <div class="peta__tubuh">
    <div class="viz peta__kanvas" style={`aspect-ratio:${vw} / ${vh}`} {...kontainer(label)}>
      <svg class="peta__svg" viewBox={vb.join(" ")} aria-hidden="true" focusable="false">
        <rect class="peta__laut" x={vx} y={vy} width={vw} height={vh} />
        <g class="peta__sekitar">{peta.sekitar.map((_, i) => <use href={`#ps-${i}`} />)}</g>

        {
          mode === "kategori" ? (
            <g class="peta__kapisi">
              {peta.kapanewon.map((c, j) => (
                <use
                  href={`#pc-${c.kode}`}
                  class="peta__kapanewon"
                  style={`--f0:${WARNA_KAB[c.kodeKab]};--tunda-k:${(j % 18) * 40}ms`}
                  data-g={`kap${c.kode}`}
                  {...tip({ judul: `${jenisKap(c.kodeKab)} · ${namaKab(c.kodeKab)}`, nilai: c.nama, warna: WARNA_KAB[c.kodeKab] })}
                />
              ))}
            </g>
          ) : (
            <g class="peta__kabisi">
              {peta.kab.map((k, j) => (
                <use
                  href={`#pk-${k.kode}`}
                  class="peta__wil"
                  style={`${gayaLapis(k.kode)};--k-i:${j}`}
                  data-g={`k${k.kode}`}
                  {...(mode === "koroplet" ? tipLapis(k.kode) : {})}
                />
              ))}
            </g>
          )
        }

        {kapanewon && mode !== "kategori" && <g class="peta__kapgaris">{peta.kapanewon.map((c) => <use href={`#pc-${c.kode}`} />)}</g>}
        <g class="peta__kabgaris">{peta.kab.map((k) => <use href={`#pk-${k.kode}`} class:list={[sorot.includes(k.kode) && "is-sorot"]} />)}</g>

        {
          mode === "penanda" && (
            <g class="peta__sumbu" data-anim="pudar">
              <path class="peta__sumbu-imaji" d={sumbuImajiUtara + sumbuImajiSelatan} vector-effect="non-scaling-stroke" />
              <path class="peta__sumbu-inti" d={sumbuInti} vector-effect="non-scaling-stroke" />
              {sumbu.map((p) => <circle cx={p.x} cy={p.y} r="5" class="peta__sumbu-titik" vector-effect="non-scaling-stroke" />)}
            </g>
          )
        }

        {
          mode === "gelembung" &&
            peta.kab.map((k, j) => (
              <g class="peta__gel" style={`${gayaLapis(k.kode)};--w:${WARNA_KAB[k.kode]};--tunda-k:${j * 120}ms`} transform={`translate(${k.lx} ${k.ly})`}>
                <circle r={rMaks} class="peta__gel-luar" data-g={`k${k.kode}`} {...tipLapis(k.kode)} />
                <circle r={rMaks} class="peta__gel-dalam" />
              </g>
            ))
        }

        <line class="peta__penunjuk" x1={kotaLabel.lx + 6} y1={kotaLabel.ly} x2={kotaPos.x - 2} y2={kotaPos.y} vector-effect="non-scaling-stroke" />
      </svg>

      {/* Label kabupaten/kota */}
      {
        peta.kab.map((k, j) => {
          const pos = posLabel(k);
          // Mode gelembung: label turun mengikuti jari-jari lingkaran lapis aktif.
          // Sleman di utara Kota: labelnya naik ke atas lingkaran supaya tidak menimpa Kota.
          const keAtas = k.kode === "3404";
          const yGel =
            mode === "gelembung" && k.kode !== KOTA
              ? lapis.map((L, i) => `--y${i}:${pctY(k.ly + (keAtas ? -1 : 1) * (rMaks * skalaGel(L.nilai[k.kode]?.nilai) + 6))}`).join(";")
              : "";
          return (
            <div
              class:list={["peta__label", k.kode === KOTA && "peta__label--kota", mode === "gelembung" && "peta__label--gel", keAtas && "peta__label--atas"]}
              style={`left:${pctX(pos.x)};top:${pctY(pos.y)};${gayaLapis(k.kode)};${yGel};--tunda-k:${700 + j * 120}ms`}
              data-anim="pudar"
              aria-hidden="true"
            >
              {tampilNama && <b>{k.kode === KOTA && kecil ? "Kota" : k.nama}</b>}
              {mode !== "penanda" &&
                mode !== "kategori" &&
                lapis.map((L, i) => (
                  <span class="peta__v" data-l={i}>
                    {L.nilai[k.kode]?.tampil}
                  </span>
                ))}
              {(catatanKab[k.kode] ?? []).map((c) => <small>{c}</small>)}
            </div>
          );
        })
      }

      {
        !kecil &&
          labelLain.map((p) => (
            <span class:list={["peta__teks", `peta__teks--${p.jenis}`]} style={`left:${pctX(p.x)};top:${pctY(p.y)}`} aria-hidden="true">
              {p.nama}
            </span>
          ))
      }
      {
        mode === "penanda" && (
          <>
            <span class="peta__ikon" style={`left:${pctX(sumbu[0]!.x)};top:${pctY(sumbu[0]!.y)}`} aria-hidden="true">
              <img src="./brand/ikon-merapi.svg" alt="" width="40" height="40" loading="lazy" data-anim="titik" />
            </span>
            <span
              class="peta__teks peta__teks--sumbu peta__teks--kanan"
              style={`left:${pctX(sumbu[0]!.x)};top:${pctY(sumbu[0]!.y)}`}
              data-t={sumbu[0]!.nama}
              data-v="Ujung utara sumbu imajiner"
            >
              {sumbu[0]!.nama}
            </span>
            <span
              class="peta__teks peta__teks--sumbu peta__teks--kiri"
              style={`left:${pctX(sumbu[4]!.x)};top:${pctY(sumbu[4]!.y)}`}
              data-t={sumbu[4]!.nama}
              data-v="Ujung selatan sumbu imajiner"
            >
              {sumbu[4]!.nama}
            </span>
            <span
              class="peta__teks peta__teks--sumbu peta__teks--inti"
              style={`left:${pctX(sumbu[2]!.x)};top:${pctY(sumbu[2]!.y)}`}
              data-t="Tugu, Keraton, Panggung Krapyak"
              data-v="Sumbu Filosofi"
              data-s="Warisan Budaya Dunia UNESCO"
            >
              Sumbu Filosofi
            </span>
          </>
        )
      }
    </div>

    {
      mode === "penanda" && (
        <div class="viz peta__sisipan" {...kontainer("Perbesaran Kota Yogyakarta: Tugu, Keraton, dan Panggung Krapyak pada Sumbu Filosofi")}>
          <p class="peta__sisipan-judul">Perbesaran Kota Yogyakarta</p>
          <div class="peta__sisipan-kanvas" style={`aspect-ratio:${kw} / ${kh}`}>
            <svg class="peta__svg" viewBox={peta.kotaBox.join(" ")} aria-hidden="true" focusable="false">
              <rect class="peta__laut" x={kx} y={ky} width={kw} height={kh} />
              {kapKota.map((c) => (
                <use
                  href={`#pc-${c.kode}`}
                  class:list={["peta__kapsisip", c.kodeKab === KOTA && "is-kota"]}
                  data-g={`ks${c.kode}`}
                  {...tip({ judul: `${jenisKap(c.kodeKab)} · ${namaKab(c.kodeKab)}`, nilai: c.nama })}
                />
              ))}
              <use href={`#pk-${KOTA}`} class="peta__kotagaris" />
              <path class="peta__sumbu-inti" d={sumbuInti} vector-effect="non-scaling-stroke" />
              <path class="peta__sumbu-imaji" d={`${ruas(0, 1)}${ruas(3, 4)}`} vector-effect="non-scaling-stroke" />
              {sumbu.slice(1, 4).map((p) => (
                <circle cx={p.x} cy={p.y} r="1.4" class="peta__sumbu-titik" vector-effect="non-scaling-stroke" />
              ))}
            </svg>
            {sumbu.slice(1, 4).map((p) => (
              <span class="peta__teks peta__teks--sisip" style={`left:${pctKX(p.x)};top:${pctKY(p.y)}`} aria-hidden="true">
                {p.ikon && <img src={`./brand/${p.ikon}.svg`} alt="" width="30" height="30" loading="lazy" />}
                <span>{p.nama}</span>
              </span>
            ))}
          </div>
        </div>
      )
    }

    {
      panel && lapis.length > 0 && (
        <div class="peta__panel" aria-hidden="true">
          {panelLapis.map((rows, i) => (
            <ol class="peta__peringkat" data-l={i}>
              {rows.map((r, j) => (
                <li data-g={`k${r.kode}`} style={`--tunda-k:${j * 80}ms`}>
                  <span class="peta__pnama">
                    <i style={`background:${mode === "koroplet" ? isianLapis[i]?.isi[r.kode] : WARNA_KAB[r.kode]}`} />
                    {namaKab(r.kode)}
                  </span>
                  <span class="peta__pnilai">{r.tampil}</span>
                  <span class="peta__pbatang">
                    <i style={`width:${css(r.lebar)}`} data-anim="x" />
                  </span>
                </li>
              ))}
            </ol>
          ))}
        </div>
      )
    }
  </div>

  {
    mode === "koroplet" && lapis.length > 0 && (
      <div class="peta__legenda" aria-hidden="true">
        {lapis.map((L, i) => {
          const lo = kodeKab.find((k) => L.nilai[k]?.nilai === isianLapis[i]!.lo)!;
          const hi = kodeKab.find((k) => L.nilai[k]?.nilai === isianLapis[i]!.hi)!;
          return (
            <div class="peta__ramp" data-l={i}>
              <span class="peta__ramp-judul">{L.legenda ?? L.judul}</span>
              <span class="peta__ramp-ujung">{L.nilai[lo]?.tampil}</span>
              <i style={`background:${gradien(isianLapis[i]!.stops.map((_, s, a) => padaRamp(a, 0.14 + (0.86 * s) / (a.length - 1))))}`} />
              <span class="peta__ramp-ujung">{L.nilai[hi]?.tampil}</span>
            </div>
          );
        })}
      </div>
    )
  }
  {mode === "gelembung" && ketGelembung && <p class="peta__ket">{ketGelembung}</p>}
</div>

<style>
  .peta {
    position: relative;
  }
  .peta__pilih {
    display: none;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  :global(.js) .peta__pilih {
    display: flex;
  }
  .peta__tubuh {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  .peta--panel .peta__tubuh {
    grid-template-columns: minmax(0, 1.75fr) minmax(220px, 1fr);
  }
  .peta--penanda .peta__tubuh {
    grid-template-columns: minmax(0, 1.75fr) minmax(220px, 1fr);
  }
  .peta__kanvas {
    position: relative;
    width: 100%;
  }
  .peta__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .peta__laut {
    fill: var(--white);
  }
  .peta__sekitar use {
    fill: #f1eeea;
    stroke: var(--white);
    stroke-width: 1px;
  }
  .peta__wil,
  .peta__kapanewon {
    fill: var(--f0);
    stroke: none;
    transition: fill 700ms var(--ease);
  }
  .peta[data-lapis="1"] .peta__wil {
    fill: var(--f1);
  }
  .peta[data-lapis="2"] .peta__wil {
    fill: var(--f2);
  }
  .peta[data-lapis="3"] .peta__wil {
    fill: var(--f3);
  }
  .peta[data-lapis="4"] .peta__wil {
    fill: var(--f4);
  }
  .peta__kapanewon {
    stroke: var(--white);
    stroke-width: 0.8px;
  }
  .peta__kapgaris use {
    fill: none;
    stroke: rgba(255, 255, 255, 0.55);
    stroke-width: 0.6px;
    pointer-events: none;
  }
  .peta--penanda .peta__kapgaris use {
    stroke: #e3ddd6;
  }
  .peta__kabgaris use {
    fill: none;
    stroke: var(--white);
    stroke-width: 1.6px;
    pointer-events: none;
  }
  .peta--kategori .peta__kabgaris use {
    stroke-width: 2.2px;
  }
  .peta--penanda .peta__kabgaris use,
  .peta--gelembung .peta__kabgaris use {
    stroke: #cfc7bf;
    stroke-width: 1px;
  }
  .peta__kabgaris use.is-sorot {
    stroke: var(--ink);
    stroke-width: 2px;
  }
  .peta__penunjuk {
    stroke: var(--ink);
    stroke-width: 1px;
  }

  /* Gelembung: lingkaran berskala; skala per lapis lewat --s0…--s4. */
  .peta__gel-luar,
  .peta__gel-dalam {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(var(--s-aktif, var(--s0)));
    transition: transform 900ms var(--ease);
  }
  .peta__gel-luar {
    fill: var(--w, var(--red));
    fill-opacity: 0.2;
