---
/**
 * MultiKecil — small multiples: satu panel per seri. `skala="sendiri"` untuk
 * besaran bersatuan berbeda (komponen IPM); `skala="bersama"` untuk besaran
 * yang sama (investasi per kabupaten), dengan seri lain sebagai garis konteks.
 */
import { kontainer, tip, css } from "../../lib/viz";
import { q } from "../../lib/chart";

interface Panel {
  judul: string;
  ringkas: string;
  perubahan?: string;
  nilai: number[];
  tampil: string[];
  sorot?: boolean;
}
interface Props {
  label: string;
  x: string[];
  panel: Panel[];
  skala?: "sendiri" | "bersama";
  kolom?: number;
  tinggi?: number;
  /** Label nilai sumbu (atas & bawah) untuk skala bersama. */
  fmtSumbu?: (v: number) => string;
  /** Mulai sumbu dari nol (skala bersama). */
  dariNol?: boolean;
}

const { label, x, panel, skala = "sendiri", kolom = 4, tinggi = 120, fmtSumbu, dariNol = false } = Astro.props;
const semua = panel.flatMap((p) => p.nilai);
const gMin = dariNol ? 0 : Math.min(...semua);
const gMax = Math.max(...semua);
const px = (i: number) => (x.length === 1 ? 50 : 4 + (92 * i) / (x.length - 1));

function domain(p: Panel): [number, number] {
  if (skala === "bersama") return [gMin, gMax];
  const lo = Math.min(...p.nilai);
  const hi = Math.max(...p.nilai);
  const pad = (hi - lo || Math.abs(hi) || 1) * 0.35;
  return [lo - pad, hi + pad];
}
const garis = (vals: number[], [lo, hi]: [number, number]) =>
  vals.map((v, i) => `${i ? "L" : "M"}${q(px(i) * 10)} ${q((100 - (100 * (v - lo)) / (hi - lo)) * 10)}`).join(" ");
const luas = (vals: number[], dom: [number, number]) => `${garis(vals, dom)} L${q(px(vals.length - 1) * 10)} 1000 L${q(px(0) * 10)} 1000 Z`;
---

<div class="viz mk" style={`--kolom:${kolom};--h:${tinggi}px`} {...kontainer(label)}>
  {
    panel.map((p, pi) => {
      const dom = domain(p);
      const y = (v: number) => 100 - (100 * (v - dom[0])) / (dom[1] - dom[0]);
      return (
        <div class:list={["mk__panel", p.sorot && "is-sorot"]}>
          <div class="mk__kepala">
            <span class="mk__judul">{p.judul}</span>
            <span class="mk__ringkas">{p.ringkas}</span>
            {p.perubahan && <span class="mk__ubah">{p.perubahan}</span>}
          </div>
          <div class="mk__plot">
            {skala === "bersama" && fmtSumbu && (
              <>
                <span class="mk__sumbu mk__sumbu--atas" aria-hidden="true">{fmtSumbu(dom[1])}</span>
                <span class="mk__sumbu mk__sumbu--bawah" aria-hidden="true">{fmtSumbu(dom[0])}</span>
              </>
            )}
            <svg class="mk__svg" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true" data-anim="sapu" style={`--tunda-k:${pi * 120}ms`}>
              {skala === "bersama" &&
                panel
                  .filter((_, j) => j !== pi)
                  .map((o) => (
                    <path d={garis(o.nilai, dom)} fill="none" stroke="var(--c-redup)" stroke-width="1.25" vector-effect="non-scaling-stroke" />
                  ))}
              <path class="mk__luas" d={luas(p.nilai, dom)} />
              <path d={garis(p.nilai, dom)} fill="none" class="mk__garis" stroke-width="2.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
            </svg>
            {p.nilai.map((v, i) => (
              <span
                class:list={["mk__titik", i === p.nilai.length - 1 && "mk__titik--akhir"]}
                data-anim="titik"
                style={`left:${css(px(i))};top:${css(y(v))};--tunda-k:${pi * 120 + 300 + i * 120}ms`}
                {...tip({ judul: `${p.judul} · ${x[i]}`, nilai: p.tampil[i] ?? "" })}
              />
            ))}
          </div>
          <div class="mk__x" aria-hidden="true">
            <span>{x[0]}</span>
            <span>{x[x.length - 1]}</span>
          </div>
        </div>
      );
    })
  }
</div>

<style>
  .mk {
    display: grid;
    grid-template-columns: repeat(var(--kolom), minmax(0, 1fr));
    gap: var(--space-12) var(--space-8);
  }
  .mk__panel {
    min-width: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--hairline);
    position: relative;
  }
  .mk__panel::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    width: 32px;
    height: 2px;
    background: var(--ink);
  }
  .mk__panel.is-sorot::before {
    background: var(--red);
  }
  .mk__kepala {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 6.4rem;
  }
  .mk__judul {
    font-size: var(--fs-small);
    line-height: 1.3;
  }
  .mk__ringkas {
    margin-top: 4px;
    font-size: 1.75rem;
    font-weight: 300;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .is-sorot .mk__ringkas {
    color: var(--red);
  }
  .mk__ubah {
    font-size: var(--fs-micro);
    color: var(--text-muted);
  }
  .mk__plot {
    position: relative;
    height: var(--h);
    margin-top: var(--space-8);
    border-bottom: 1px solid var(--c-sumbu);
  }
  .mk__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .mk__luas {
    fill: var(--c-dasar);
    opacity: 0.1;
  }
  .mk__garis {
    stroke: var(--c-tinta);
  }
  .is-sorot .mk__luas {
    fill: var(--red);
  }
  .is-sorot .mk__garis {
    stroke: var(--red);
  }
  .mk__panel .mk__garis {
    stroke: var(--red);
  }
  .mk__panel .mk__luas {
    fill: var(--red);
    opacity: 0.08;
  }
  .mk__titik {
    position: absolute;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: inset 0 0 0 2px var(--red);
    cursor: default;
  }
  .mk__titik--akhir {
    background: var(--red);
  }
  .mk__titik::after {
    content: "";
    position: absolute;
    inset: -10px;
  }
  .mk__sumbu {
    position: absolute;
    left: 0;
    font-size: var(--fs-micro);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .mk__sumbu--atas {
    top: -1.7em;
  }
  .mk__sumbu--bawah {
    bottom: -1px;
    left: auto;
    right: calc(100% + 6px);
  }
  .mk__x {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    font-size: var(--fs-micro);
    color: var(--text-muted);
  }
  @media (max-width: 960px) {
    .mk {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .mk {
      gap: var(--space-8) var(--space-4);
    }
    .mk__kepala {
      min-height: 5.6rem;
    }
    .mk__ringkas {
      font-size: 1.375rem;
    }
    .mk__sumbu--bawah {
      right: auto;
      left: 0;
      bottom: 4px;
    }
  }
</style>
