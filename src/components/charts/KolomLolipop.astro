---
/**
 * KolomLolipop — kategori berurutan sebagai tangkai tipis dan titik. Dipakai di
 * adegan 1.4 (ukuran keluarga).
 *
 * Tangkai 2 px dan titik menggantikan batang penuh: bentuknya tetap mudah
 * dibandingkan, tetapi tintanya jauh lebih ringan. Satu kolom disorot merah;
 * nilai hanya ditulis pada kolom yang disorot dan yang terbesar, sisanya lewat
 * tooltip dan tabel angka alternatif.
 */
import type { Row } from "../../lib/data";
import { kisi, q } from "../../lib/chart";
import { n, p } from "../../lib/format";
import { kontainer, tip } from "../../lib/viz";

interface Props {
  rows: Row[];
  caption: string;
  label: string;
  sorot?: string;
  satuan: string;
  /** Akhiran persentase di tooltip, misalnya "dari 4.403 keluarga". */
  penyebutLabel: string;
  labelSumbu: string;
  /** Akhiran judul tooltip, misalnya " anggota". */
  akhiran?: string;
}

const { rows, caption, label, sorot, satuan, penyebutLabel, labelSumbu, akhiran = "" } = Astro.props;

const maks = Math.max(...rows.map((r) => r.n ?? 0));
const garis = kisi(maks);
const atas = garis[garis.length - 1] ?? 1;
const terbesar = rows.reduce((m, r) => ((r.n ?? 0) > (m.n ?? 0) ? r : m), rows[0]!);

const LEBAR = { W: 760, H: 300, L: 56, R: 12, T: 34, B: 54, titik: 6.5, kelas: "lol--lebar" };
const SEMPIT = { W: 340, H: 280, L: 44, R: 6, T: 32, B: 52, titik: 5.5, kelas: "lol--sempit" };
type Geo = typeof LEBAR;

const kolomW = (g: Geo) => (g.W - g.L - g.R) / rows.length;
const cx = (g: Geo, i: number) => q(g.L + kolomW(g) * (i + 0.5));
const y = (g: Geo, v: number) => q(g.H - g.B - (v / atas) * (g.H - g.T - g.B));
---

<figure class="figur">
  <figcaption>{caption}</figcaption>

  <div class="viz" {...kontainer(label)}>
    {
      [LEBAR, SEMPIT].map((g) => (
        <svg class:list={["lol", g.kelas]} viewBox={`0 0 ${g.W} ${g.H}`} aria-hidden="true">
          <g class="grid">
            {garis.map((v) => (
              <>
                <line x1={g.L} y1={y(g, v)} x2={g.W - g.R} y2={y(g, v)} />
                <text class="tick" x={g.L - 8} y={q(y(g, v) + 4)} text-anchor="end">{n(v)}</text>
              </>
            ))}
          </g>
          <text class="satuan" x="0" y={g.T - 16} text-anchor="start">{satuan}</text>

          {rows.map((r, i) => {
            const disorot = r.label === sorot;
            const warna = disorot ? "var(--mark-highlight)" : "var(--mark-base)";
            const yy = r.n === null ? g.H - g.B : y(g, r.n);
            return (
              <g
                class="kol"
                {...tip({
                  judul: `${r.label}${akhiran}`,
                  nilai: r.n === null ? "–" : `${n(r.n)} ${satuan}`,
                  warna: r.n === null ? undefined : warna,
                  baris: [
                    r.pct !== null && `${p(r.pct)} ${penyebutLabel}`,
                    r.n === null && `1–4 ${satuan}, tidak ditulis apa adanya`,
                  ],
                })}
              >
                <rect x={q(g.L + kolomW(g) * i)} y={g.T - 8} width={q(kolomW(g))} height={g.H - g.T - g.B + 34} fill="transparent" />
                {r.n === null ? (
                  <circle class="samar" cx={cx(g, i)} cy={g.H - g.B - 6} r="3" data-anim="titik" />
                ) : (
                  <>
                    <line class="tangkai" x1={cx(g, i)} y1={g.H - g.B} x2={cx(g, i)} y2={yy} stroke={warna} data-anim="y" />
                    <circle cx={cx(g, i)} cy={yy} r={g.titik} fill={warna} class="ujung" data-seri={disorot ? "highlight" : "base"} data-anim="titik" style="--tunda:380ms" />
                    {(disorot || r === terbesar) && (
                      <text class="nilai" x={cx(g, i)} y={q(yy - g.titik - 8)} text-anchor="middle" data-anim="pudar" style="--tunda:560ms">{n(r.n)}</text>
                    )}
                  </>
                )}
                <text class="nama" x={cx(g, i)} y={g.H - g.B + 19} text-anchor="middle">{r.label}</text>
              </g>
            );
          })}

          <line class="sumbu" x1={g.L} y1={g.H - g.B} x2={g.W - g.R} y2={g.H - g.B} />
          <text class="judul-sumbu" x={q((g.L + g.W - g.R) / 2)} y={g.H - 10} text-anchor="middle">{labelSumbu}</text>
        </svg>
      ))
    }
  </div>

  <slot />
</figure>

<style>
  .lol {
    width: 100%;
    height: auto;
  }
  .lol--sempit {
    display: none;
  }
  @media (max-width: 640px) {
    .lol--lebar {
      display: none;
    }
    .lol--sempit {
      display: block;
    }
  }
  @media print {
    .lol--lebar {
      display: block !important;
    }
    .lol--sempit {
      display: none !important;
    }
  }
  .grid line {
    stroke: var(--chart-grid);
    stroke-width: 1;
  }
  .sumbu {
    stroke: var(--chart-axis);
    stroke-width: 1;
  }
  .tick,
  .satuan {
    fill: var(--text-subtle);
    font-size: 11px;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .satuan {
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .tangkai {
    stroke-width: 2;
    stroke-linecap: round;
  }
  .ujung {
    stroke: var(--surface-card);
    stroke-width: 2;
  }
  .samar {
    fill: none;
    stroke: var(--text-subtle);
    stroke-width: 1.5;
  }
  .nilai {
    fill: var(--text-strong);
    font-size: 14px;
    font-weight: var(--fw-bold);
    font-family: var(--font-body);
  }
  .nama {
    fill: var(--text-body);
    font-size: 12.5px;
    font-family: var(--font-mono);
  }
  .judul-sumbu {
    fill: var(--text-muted);
    font-size: 11.5px;
    font-family: var(--font-body);
  }
</style>
